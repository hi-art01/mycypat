# 7. PERSISTENCE SWEEP (IFEO, WMI, Tasks, Run Keys, Startup Folders, Services, Hosts)
# ---------------------------------------------------------------------
Section "7. Persistence Sweep (IFEO, WMI, Scheduled Tasks, Run Keys, Startup Folders, Services, Hosts)"

if (Confirm-Prompt "Sweep IFEO debugger hijacks, WMI subscriptions, Scheduled Tasks, Run keys, Startup folders, Services, and Hosts file?") {
    # IFEO Debugger Hijacks
    foreach ($base in 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows NT\CurrentVersion\Image File Execution Options') {
        Get-ChildItem $base -ErrorAction SilentlyContinue | ForEach-Object {
            $d = (Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue).Debugger
            if ($d -and $d -match 'cmd\.exe|powershell|nc\.exe') {
                Remove-ItemProperty $_.PSPath -Name Debugger -ErrorAction SilentlyContinue
                Info "Cleaned IFEO debugger hijack on $($_.PSChildName)"
            }
        }
    }

    # WMI Event Subscriptions
    foreach ($cls in '__EventFilter','CommandLineEventConsumer','ActiveScriptEventConsumer','__FilterToConsumerBinding') {
        Get-CimInstance -Namespace root\subscription -ClassName $cls -ErrorAction SilentlyContinue | ForEach-Object {
            if ($_.Name -notmatch '^SCM Event Log') {
                Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue
                Info "Removed WMI subscription $($_.Name)"
            }
        }
    }

    # Non-Microsoft Scheduled Tasks (Preserving CyberPatriot CCS Engine tasks)
    Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -notmatch '\\Microsoft\\' -and $_.TaskName -notmatch 'CCS|CyberPatriot|Engine' -and $_.TaskPath -notmatch 'CCS|CyberPatriot' } | ForEach-Object {
        if ($script:FAST_MODE -or (Confirm-Timed "Unregister non-Microsoft Scheduled Task '$($_.TaskName)'?")) {
            Unregister-ScheduledTask -TaskName $_.TaskName -TaskPath $_.TaskPath -Confirm:$false -ErrorAction SilentlyContinue
            Info "Unregistered task $($_.TaskName)"
        }
    }

    # Startup Folders Cleaning
    $startupPaths = @(
        "C:\ProgramData\Microsoft\Windows\Start Menu\Programs\StartUp",
        "$env:SystemDrive\Users\*\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup"
    )
    Get-ChildItem $startupPaths -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -ne 'desktop.ini' } | ForEach-Object {
        Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue
        Info "Deleted startup item: $($_.FullName)"
    }

    # Run / RunOnce Keys Sweep
    foreach ($rk in 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce') {
        $props = Get-ItemProperty $rk -ErrorAction SilentlyContinue
        if ($props) {
            foreach ($p in $props.PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' }) {
                if ($p.Value -match '\\Users\\|\\Temp\\|AppData|\.vbs|\.bat|\.ps1|cmd\.exe|powershell|nc\.exe') {
                    Remove-ItemProperty -Path $rk -Name $p.Name -ErrorAction SilentlyContinue
                    Info "Removed startup run entry $($p.Name)"
                }
            }
        }
    }

    # Auto-start Services with Suspicious Paths
    Get-CimInstance Win32_Service | Where-Object { $_.StartMode -eq 'Auto' -and $_.PathName -match '\\Users\\|\\Temp\\|AppData' } | ForEach-Object {
        if ($_.Name -notin $KeepServices) {
            Set-Service -Name $_.Name -StartupType Disabled -ErrorAction SilentlyContinue
            Stop-Service -Name $_.Name -Force -ErrorAction SilentlyContinue
            Info "Disabled auto-start service with suspicious image path: $($_.Name) ($($_.PathName))"
        }
    }

    # Hosts File Cleanup
    $hostsPath = "$env:SystemRoot\System32\drivers\etc\hosts"
    $hostsContent = Get-Content $hostsPath -ErrorAction SilentlyContinue
    $cleanHosts = $hostsContent | Where-Object { $_ -match '^\s*#' -or $_ -match '^\s*(127\.0\.0\.1|::1)\s+localhost\s*$' -or [string]::IsNullOrWhiteSpace($_) }
    $cleanHosts | Set-Content $hostsPath -Force -ErrorAction SilentlyContinue
    Info "Cleaned hosts file to localhost defaults"

    # Disable NetBIOS over TCP/IP & DNS Registration
    Get-ChildItem 'HKLM:\SYSTEM\CurrentControlSet\Services\NetBT\Parameters\Interfaces' -ErrorAction SilentlyContinue | ForEach-Object {
        Set-ItemProperty -Path $_.PSPath -Name 'NetbiosOptions' -Value 2 -ErrorAction SilentlyContinue
    }
    Set-DnsClient -InterfaceAlias '*' -RegisterThisConnectionsAddress $false -ErrorAction SilentlyContinue
    Info "Disabled NetBIOS over TCP/IP and DNS adapter registration"
}

