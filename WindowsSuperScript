function Remove-ProhibitedSoftware {
    $prohibited = @('CCleaner', 'WebCompanion', 'Lavasoft', 'OpenTFTPServer', 'BitTorrent', 'uTorrent', 'Wireshark', 'GooseDesktop', 'Cain', 'Abel')
    $uninstKeys = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )
    foreach ($app in $prohibited) {
        Get-ItemProperty $uninstKeys -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -match $app } | ForEach-Object {
            if ($script:FAST_MODE -or (Confirm-Prompt "Uninstall prohibited software '$($_.DisplayName)'?")) {
                $unstr = $_.UninstallString
                if ($unstr) {
                    Info "Uninstalling prohibited software: $($_.DisplayName)"
                    if ($unstr -match 'msiexec') {
                        $guid = [regex]::Match($unstr, '{[A-F0-9-]+}').Value
                        if ($guid) { Start-Process msiexec.exe -ArgumentList "/x $guid /qn" -Wait -WindowStyle Hidden }
                    } else {
                        Start-Process cmd.exe -ArgumentList "/c $unstr /S /quiet /norestart" -Wait -WindowStyle Hidden
                    }
                }
            }
        }
        if (Get-Command Get-Package -ErrorAction SilentlyContinue) {
            Get-Package -Name "*$app*" -ErrorAction SilentlyContinue | Uninstall-Package -Force -ErrorAction SilentlyContinue
        }
    }
    # Delete leftover directories
    $targets = @(
        "$env:ProgramFiles\CCleaner", "$env:ProgramFiles(x86)\CCleaner",
        "$env:ProgramFiles\Lavasoft", "$env:ProgramFiles(x86)\Lavasoft",
        "$env:ProgramFiles\OpenTFTPServer", "$env:ProgramFiles(x86)\OpenTFTPServer",
        "$env:ProgramFiles\Wireshark", "$env:ProgramFiles(x86)\Wireshark",
        "$env:APPDATA\BitTorrent", "$env:APPDATA\uTorrent"
    )
    foreach ($t in $targets) {
        if (Test-Path $t) { Remove-Item -Path $t -Recurse -Force -ErrorAction SilentlyContinue; Info "Deleted leftover directory: $t" }
    }
}

