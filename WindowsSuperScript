    $prohibitedList = @('GooseDesktop','CCleaner','WebCompanion','OpenTFTPServer','Nmap','Zenmap','Wireshark','uTorrent','BitTorrent') + $ExtraProhibited
    $uninstKeys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    Get-ItemProperty $uninstKeys -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName } | ForEach-Object {
