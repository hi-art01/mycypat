#Requires -RunAsAdministrator
<#
.SYNOPSIS
  WindowsSuperScript - CyberPatriot Windows 10 / Windows 11 Hardening Script (Interactive)

.DESCRIPTION
  Interactively prompts for README specifics (Authorized Users, Authorized Admins,
  Required Services, Allowed Ports, Default Password) and executes aggressive Y/N hardening
  modules for Windows 10/11 Workstations.
#>

$ErrorActionPreference = 'Continue'
$LogFile = "C:\Windows\Temp\CP-Windows-Hardening-Log.txt"

function Section([string]$t) { Write-Host "`n=== $t ===" -ForegroundColor Cyan }
function Info([string]$t)    { Write-Host "[+] $t" -ForegroundColor Green; "$((Get-Date).ToString('T')) [INFO] $t" | Out-File $LogFile -Append }
function Warn([string]$t)    { Write-Host "[!] $t" -ForegroundColor Yellow; "$((Get-Date).ToString('T')) [WARN] $t" | Out-File $LogFile -Append }

function Confirm-Prompt([string]$msg, [bool]$defaultYes=$true) {
    $suffix = if ($defaultYes) { "[Y/n]" } else { "[y/N]" }
    $resp = Read-Host "$msg $suffix"
    if ([string]::IsNullOrWhiteSpace($resp)) { return $defaultYes }
    return ($resp -match '^(y|yes)$')
}

function Set-RegProperty {
    param([string]$Path, [string]$Name, $Value, [string]$Type='DWord')
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -Path $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Info "$Path\$Name = $Value"
    } catch { Warn "Failed setting $Path\$Name : $($_.Exception.Message)" }
}

Write-Host "====================================================" -ForegroundColor Green
Write-Host "   CyberPatriot Windows SuperScript (Interactive)   " -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green

# ---------------------------------------------------------------------
# INITIAL README SPECIFICS PROMPTS
# ---------------------------------------------------------------------
Section "0. README Details & Specifics Input"

$AuthUsersInput = Read-Host "Enter ALL Authorized Users (comma-separated, e.g. 'alice,bob,carol')"
$AuthorizedUsers = @($AuthUsersInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$AuthAdminsInput = Read-Host "Enter Authorized Administrators ONLY (comma-separated, e.g. 'alice,admin1')"
$AuthorizedAdmins = @($AuthAdminsInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$KeepServicesInput = Read-Host "Enter Required Services to KEEP (comma-separated, e.g. 'Spooler,WinRM,sshd')"
$KeepServices = @($KeepServicesInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$NewPasswordInput = Read-Host "Enter Default Password for Authorized Users [Default: Cyb3r-Pat!2026-xQz]"
$NewPassword = if ([string]::IsNullOrWhiteSpace($NewPasswordInput)) { 'Cyb3r-Pat!2026-xQz' } else { $NewPasswordInput }

$RDPRequired = Confirm-Prompt "Is Remote Desktop (RDP) explicitly required by the README?" $false
$IISRequired = Confirm-Prompt "Is Web Server (IIS) explicitly required by the README?" $false
$FTPRequired = Confirm-Prompt "Is FTP Service explicitly required by the README?" $false

# ---------------------------------------------------------------------
# 1. LOCAL USERS & GROUPS HARDENING
# ---------------------------------------------------------------------
Section "1. Local Users & Groups Hardening"

$builtin = @('Administrator','Guest','DefaultAccount','WDAGUtilityAccount')
$current = $env:USERNAME
$sec = ConvertTo-SecureString $NewPassword -AsPlainText -Force

if (Confirm-Prompt "Audit and remove unauthorized local users?") {
    foreach ($u in Get-LocalUser) {
        if ($u.Name -in $builtin -or $u.Name -eq $current) { continue }
        if ($u.Name -notin $AuthorizedUsers -and $u.Name -notin $AuthorizedAdmins) {
            if (Confirm-Prompt "Remove UNAUTHORIZED user '$($u.Name)'?") {
                Remove-LocalUser -Name $u.Name
                Info "Removed user $($u.Name)"
            }
        }
    }
}

if (Confirm-Prompt "Enforce Administrators group membership?") {
    foreach ($m in Get-LocalGroupMember -Group 'Administrators' -ErrorAction SilentlyContinue) {
        if ($m.ObjectClass -ne 'User') { continue }
        $n = $m.Name.Split('\')[-1]
        if ($n -in $builtin -or $n -eq $current) { continue }
        if ($n -notin $AuthorizedAdmins) {
            if (Confirm-Prompt "Remove '$n' from Administrators?") {
                Remove-LocalGroupMember -Group 'Administrators' -Member $m.Name
                Info "Removed $n from Administrators group"
            }
        }
    }
    foreach ($a in $AuthorizedAdmins) {
        if (Get-LocalUser -Name $a -ErrorAction SilentlyContinue) {
            $isAdm = Get-LocalGroupMember -Group 'Administrators' -ErrorAction SilentlyContinue | Where-Object { $_.Name.Split('\')[-1] -eq $a }
            if (-not $isAdm) {
                Add-LocalGroupMember -Group 'Administrators' -Member $a
                Info "Added $a to Administrators group"
            }
        }
    }
}

if (Confirm-Prompt "Reset password for all authorized local accounts to '$NewPassword'?") {
    foreach ($u in Get-LocalUser | Where-Object { $_.Enabled }) {
        if ($u.Name -eq $current -or $u.Name -in $builtin) { continue }
        if ($u.Name -in $AuthorizedUsers -or $u.Name -in $AuthorizedAdmins) {
            Set-LocalUser -Name $u.Name -Password $sec -PasswordNeverExpires $false
            net user $u.Name /passwordreq:yes | Out-Null
            Info "Updated password and expiration for $($u.Name)"
        }
    }
}

foreach ($b in @('Guest','Administrator','DefaultAccount')) {
    if ((Get-LocalUser -Name $b -ErrorAction SilentlyContinue) -and $b -ne $current) {
        Disable-LocalUser -Name $b -ErrorAction SilentlyContinue
    }
}

# ---------------------------------------------------------------------
# 2. LOCAL SECURITY & ACCOUNT POLICIES
# ---------------------------------------------------------------------
Section "2. Password, Lockout, and Local Security Policies"

if (Confirm-Prompt "Apply password complexity, lockout threshold (10), and user rights policy?") {
    net accounts /minpwlen:14 /minpwage:1 /maxpwage:90 /uniquepw:24 /lockoutthreshold:10 /lockoutduration:30 /lockoutwindow:30 | Out-Null

    $infPath = Join-Path $env:TEMP 'cp-secpol.inf'
    $sdb = Join-Path $env:TEMP 'cp-secpol.sdb'
    $infContent = @"
[Unicode]
Unicode=yes
[Version]
signature="`$CHICAGO`"
Revision=1
[System Access]
MinimumPasswordAge = 1
MaximumPasswordAge = 90
MinimumPasswordLength = 14
PasswordComplexity = 1
PasswordHistorySize = 24
LockoutBadCount = 10
ResetLockoutCount = 30
LockoutDuration = 30
RequireLogonToChangePassword = 0
ClearTextPassword = 0
LSAAnonymousNameLookup = 0
EnableGuestAccount = 0
"@
    $infContent | Out-File -FilePath $infPath -Encoding unicode -Force
    secedit /configure /db $sdb /cfg $infPath /areas SECURITYPOLICY /quiet | Out-Null
    Info "Secedit local security policy applied"
}

# ---------------------------------------------------------------------
# 3. AUDIT POLICY & REGISTRY SECURITY OPTIONS
# ---------------------------------------------------------------------
Section "3. Audit Policy & Security Options"

if (Confirm-Prompt "Enable full audit logging (Auditpol success + failure)?") {
    auditpol /set /category:* /success:enable /failure:enable | Out-Null
    Info "Enabled full auditpol logging"
}

if (Confirm-Prompt "Apply security registry options (UAC max, SmartScreen, LSA, SMBGhost, CAD)?") {
    $lsa = 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    $lsv = 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'

    Set-RegProperty $lsa 'LimitBlankPasswordUse' 1
    Set-RegProperty $lsa 'restrictanonymous' 1
    Set-RegProperty $lsa 'restrictanonymoussam' 1
    Set-RegProperty $lsa 'everyoneincludesanonymous' 0
    Set-RegProperty $lsa 'NoLMHash' 1

    # UAC max
    Set-RegProperty $sys 'EnableLUA' 1
    Set-RegProperty $sys 'ConsentPromptBehaviorAdmin' 2
    Set-RegProperty $sys 'ConsentPromptBehaviorUser' 0
    Set-RegProperty $sys 'PromptOnSecureDesktop' 1

    # Disable AutoRun
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer' 'NoDriveTypeAutoRun' 255
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'EnableSmartScreen' 1

    # SMB Hardening
    Set-RegProperty $lsv 'AutoDisconnect' 15
    Set-RegProperty $lsv 'RequireSecuritySignature' 1
    Set-RegProperty $lsv 'EnableSecuritySignature' 1
    Set-RegProperty $lsv 'DisableCompression' 1
}

# ---------------------------------------------------------------------
# 4. REMOTE DESKTOP (RDP) HARDENING
# ---------------------------------------------------------------------
Section "4. Remote Desktop (RDP) Hardening"

$ts  = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
$rdp = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp'

if ($RDPRequired) {
    if (Confirm-Prompt "Configure required Remote Desktop (Enable RDP, NLA, SSL, and Firewall rules)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 0
        Set-RegProperty $rdp 'UserAuthentication' 1
        Set-RegProperty $rdp 'SecurityLayer' 2
        Enable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop enabled with NLA, SSL security, and firewall rules"
    }
} else {
    if (Confirm-Prompt "Disable Remote Desktop (RDP)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 1
        Disable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop disabled"
    }
}

# ---------------------------------------------------------------------
# 5. WINDOWS DEFENDER & FIREWALL
# ---------------------------------------------------------------------
Section "5. Windows Defender & Firewall Settings"

if (Confirm-Prompt "Enable Windows Defender Real-Time Protection and firewall?") {
    Set-MpPreference -DisableRealtimeMonitoring $false -DisableBehaviorMonitoring $false -DisableIOAVProtection $false -PUAProtection Enabled -ErrorAction SilentlyContinue
    Set-Service WinDefend -StartupType Automatic -ErrorAction SilentlyContinue
    Start-Service WinDefend -ErrorAction SilentlyContinue

    Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True -DefaultInboundAction Block -DefaultOutboundAction Allow
    Set-Service mpssvc -StartupType Automatic -ErrorAction SilentlyContinue
    Start-Service mpssvc -ErrorAction SilentlyContinue
    Info "Windows Defender and Firewall enabled"
}

# ---------------------------------------------------------------------
# 6. SERVICES & FEATURES
# ---------------------------------------------------------------------
Section "6. Services & Optional Features"

if (Confirm-Prompt "Disable unauthorized services (Telnet, FTP, IIS, SNMP, UPnP)?") {
    $svcDisable = @('FTPSVC','MSFTPSVC','W3SVC','WMSvc','TlntSvr','SNMP','SNMPTRAP','RIPListener','upnphost','SSDPSRV','RemoteRegistry','NfsClnt')
    if ($IISRequired) { $svcDisable = $svcDisable | Where-Object { $_ -notin 'W3SVC','WMSvc' } }
    if ($FTPRequired) { $svcDisable = $svcDisable | Where-Object { $_ -notin 'FTPSVC','MSFTPSVC' } }

    foreach ($s in $svcDisable) {
        if ($s -in $KeepServices) { continue }
        if (Get-Service -Name $s -ErrorAction SilentlyContinue) {
            Stop-Service -Name $s -Force -ErrorAction SilentlyContinue
            Set-Service -Name $s -StartupType Disabled -ErrorAction SilentlyContinue
            Info "Disabled service $s"
        }
    }
}

if (Confirm-Prompt "Disable SMBv1 protocol?") {
    Set-SmbServerConfiguration -EnableSMB1Protocol $false -Force -Confirm:$false -ErrorAction SilentlyContinue
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10' 'Start' 4
    Info "SMBv1 disabled"
}

# ---------------------------------------------------------------------
# 7. PROHIBITED SOFTWARE, PROCESSES & MEDIA FILES
# ---------------------------------------------------------------------
Section "7. Prohibited Software, Backdoors & Media Files"

if (Confirm-Prompt "Sweep and kill netcat/backdoor processes?") {
    $badProcs = @('GooseDesktop','nc','ncat','netcat')
    foreach ($p in Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Name -in $badProcs }) {
        Stop-Process -Id $p.Id -Force
        Info "Killed backdoor process $($p.Name)"
    }
}

if (Confirm-Prompt "Scan and delete prohibited MP3 and media files under C:\Users?") {
    Get-ChildItem -Path "$env:SystemDrive\Users" -Recurse -Force -Include '*.mp3','*.mp4','*.avi','*.mkv' -ErrorAction SilentlyContinue | ForEach-Object {
        Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue
        Info "Deleted media file: $($_.FullName)"
    }
}

# ---------------------------------------------------------------------
# 8. AUTOMATIC UPDATES
# ---------------------------------------------------------------------
Section "8. Windows Update Policy"

if (Confirm-Prompt "Configure automatic Windows Updates?") {
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' 'NoAutoUpdate' 0
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' 'AUOptions' 4
    Info "Automatic Windows Updates enabled"
}

Write-Host "`n====================================================" -ForegroundColor Green
Write-Host "   Windows SuperScript Hardening Completed!         " -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
