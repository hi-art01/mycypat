Section "9. Windows Update, Browser Policies & Package Managers"

if (Confirm-Prompt "Configure automatic Windows Updates, Browser Policies, and run Package Upgrades?") {
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' 'NoAutoUpdate' 0
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU' 'AUOptions' 4

    # Edge / Chrome Registry Policies
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Edge' 'SmartScreenEnabled' 1
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Edge' 'DefaultPopupsSetting' 2
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Google\Chrome' 'SafeBrowsingProtectionLevel' 1
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Google\Chrome' 'DefaultPopupsSetting' 2

    # Firefox user.js Hardening
    $ffPrefs = @"
user_pref("privacy.donottrackheader.enabled", true);
user_pref("browser.safebrowsing.malware.enabled", true);
user_pref("browser.safebrowsing.phishing.enabled", true);
user_pref("dom.security.https_only_mode", true);
user_pref("browser.contentblocking.category", "strict");
"@
    Get-ChildItem "env:SystemDrive\Users\*\AppData\Roaming\Mozilla\Firefox\Profiles\*" -Directory -ErrorAction SilentlyContinue | ForEach-Object {
        Set-Content -Path (Join-Path $_.FullName 'user.js') -Value $ffPrefs -Force -ErrorAction SilentlyContinue
    }

    # Attempt winget / choco upgrades
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        winget upgrade --all --silent --accept-source-agreements --accept-package-agreements --include-unknown -ErrorAction SilentlyContinue
    } elseif (Get-Command choco -ErrorAction SilentlyContinue) {
        choco upgrade all -y -ErrorAction SilentlyContinue
    }

    # Trigger Windows Update
    UsoClient StartScan -ErrorAction SilentlyContinue
    Info "Automatic Windows Updates and Browser Policies configured"
}

