        Get-ChildItem $root -Directory -Recurse -Force -Depth 4 -ErrorAction SilentlyContinue |
            Where-Object { ($_.Name -replace '[^A-Za-z0-9]','') -match $clean -and -not (Test-Protected $_.FullName) } | ForEach-Object {
