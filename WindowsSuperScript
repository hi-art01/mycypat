if (Confirm-Prompt "Apply password complexity, lockout threshold (10), and SID-based user rights assignment?") {
    net accounts /minpwlen:14 /minpwage:1 /maxpwage:90 /uniquepw:24 /lockoutthreshold:10 /lockoutduration:30 /lockoutwindow:30 | Out-Null

    $rdpSID = if ($RDPRequired) { ",*S-1-5-32-555" } else { "" }
    $infPath = Join-Path $env:TEMP 'cp-secpol.inf'
    $sdb = Join-Path $env:TEMP 'cp-secpol.sdb'
    $infContent = @"
