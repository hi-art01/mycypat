#Requires -RunAsAdministrator
<#
.SYNOPSIS
  CyberPatriot Windows 10/11 + Windows Server hardening script (v2).

.DESCRIPTION
  Order of operations (matches the usual "forensics before remediation" advice):
    0. Read README (auto-found), pull authorized users/admins/critical services
    1. Snapshot EVIDENCE to Desktop\CP-Evidence.txt  (answer forensics questions now)
    2. Users/groups (local or Active Directory), passwords, policies, audit
    3. Security options, Defender, firewall, RDP, services, features, SMB
    4. Persistence/backdoor sweep, prohibited software/files
    5. Server roles (AD, DNS, DHCP, IIS/FTP), browsers, updates

.USAGE
  Set-ExecutionPolicy -Scope Process Bypass -Force
  .\CP-Harden.ps1 -AuditOnly                  # look, change nothing
  .\CP-Harden.ps1                             # interactive (asks y/N before destructive steps)
  .\CP-Harden.ps1 -Auto                       # answers YES to every prompt
  .\CP-Harden.ps1 -Auto -Aggressive           # also the risky extras (see $Aggressive notes)
  .\CP-Harden.ps1 -ReadmePath C:\path\README.html   # if the README is saved locally

  SNAPSHOT THE VM FIRST. -Auto -Aggressive deletes accounts/files and can break required services
  if the README parse or your CONFIG is wrong. Never touches CCS Client (the scoring engine).
#>
param(
    [switch]$AuditOnly,
    [switch]$Auto,
    [switch]$Aggressive,
    [string]$ReadmePath
)

# =====================================================================
#  CONFIG  (README parsing fills the empty ones; edit what it gets wrong)
# =====================================================================
$AuthorizedAdmins  = @()     # e.g. @('ashford','jsmith')
$AuthorizedUsers   = @()     # standard users, e.g. @('llitt','sbandaru')
$SkipPasswordUsers = @()     # README says do NOT change these passwords
$NewPassword       = 'CyberPatriot#2026!'   # 18 chars, meets complexity + 14 minimum

$RDPRequired  = $false       # README lists Remote Desktop as critical?
$IISRequired  = $false       # IIS / web server critical?
$FTPRequired  = $false       # FTP critical?
$DNSRecursionRequired = $true  # set $false if README says DNS server is authoritative-only
SMBSharesRequired=@()   #README-approvedsharesbesidesADMIN, C,IPC
$KeepServices = @()          # services README says must stay (e.g. 'Spooler','WinRM','sshd')

# Create-if-missing items from README directives
$UsersToCreate  = @()                    # e.g. @('newhire')
$GroupsToCreate = @()                    # e.g. @('firesidegirls')
$GroupMembers   = @{}                    # e.g. @{ 'firesidegirls' = @('candace') }

# Prohibited software (regex fragments vs installed program names).
# From reports: GooseDesktop, CCleaner, netcat. From checklist: OpenTFTPServer, WebCompanion.
$ProhibitedSoftware  = @('GooseDesktop','CCleaner','OpenTFTPServer','Web ?Companion','Nmap','Zenmap','Npcap','Angry IP','Wireshark','uTorrent','BitTorrent','LimeWire','Cain','John the Ripper','Hydra','Ophcrack')
$ProhibitedProcesses = @('GooseDesktop','nc','ncat','netcat')
$DeleteExtensions    = @('*.mp3')        # auto-deleted (reports: "Removed prohibited MP3 files")
$ReportExtensions    = @('*.mp4','*.avi','*.mov','*.mkv','*.flac','*.wav','*.ogg','*.wma','*.m4a','*.aac','*.zip','*.rar','*.7z')
$DisableNetBindings  = $true
$AggressiveNTLM      = $false            # Deny-all NTLM (checklist lists it; breaks things)

# =====================================================================
#  HELPERS
# =====================================================================
$ErrorActionPreference = 'Continue'
$Desktop = [Environment]::GetFolderPath('Desktop')
$LogFile = Join-Path $Desktop 'CP-Harden-Log.txt'
$EvFile  = Join-Path $Desktop 'CP-Evidence.txt'
try { Start-Transcript -Path $LogFile -Force | Out-Null } catch {}

$script:Manual = New-Object System.Collections.ArrayList
function Section($t) { Write-Host "`n=== $t ===" -ForegroundColor Cyan }
function Info($t)    { Write-Host "[+] $t" -ForegroundColor Green }
function Warn($t)    { Write-Host "[!] $t" -ForegroundColor Yellow }
function Todo($t)    { [void]$script:Manual.Add($t) }
function Confirm-Action($msg) {
    if ($AuditOnly) { return $false }
    if ($Auto) { Write-Host "[auto-yes] $msg" -ForegroundColor DarkYellow; return $true }
    r=Read-Host"msg [y/N]"
    return (r-match'(y|yes)')
}
# Never touch the scoring engine or the CyberPatriot folder
function Test-Protected($s) { return ([string]$s -match '(?i)CCS|CyberPatriot') }
function Test-ProtectedSvc($n) {
    if ($n -in $KeepServices) { return $true }
    return ([string]n-match'(?i)(CCS|CyberPatriot)|(WinDefend|mpssvc|EventLog|wuauserv|BITS|Winmgmt|RpcSs|RpcEptMapper|DcomLaunch|LanmanWorkstation|LanmanServer|Dhcp|Dnscache|CryptSvc|TrustedInstaller|UsoSvc|Schedule|Netlogon|NTDS|DNS|DFSR|kdc|W32Time|ProfSvc|gpsvc|SamSs|lsass|nsi|BFE|Wecsvc)')
}
function Set-Reg {
    param([string]Path,[string]Name,Value,[string]Type='DWord')
    if ($AuditOnly) { Write-Host "[audit] would set $Path\$Name = $Value"; return }
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -Path $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Info "$Path\$Name = $Value"
    } catch { Warn "Failed $Path\$Name : (_.Exception.Message)" }
}
function Set-RegMultiEmpty {
    param([string]RegPath,[string]Name)
    if ($AuditOnly) { return }
    reg add $RegPath /v $Name /t REG_MULTI_SZ /d "" /f | Out-Null
    Info "$RegPath\$Name = (blank)"
}
function Run(desc,[scriptblock]sb) {
    if ($AuditOnly) { Write-Host "[audit] would: $desc"; return }
    try { & $sb; Info $desc } catch { Warn "$desc FAILED: (_.Exception.Message)" }
}
function Disable-Svc($s) {
    if (Test-ProtectedSvc $s) { return }
    if (Get-Service -Name $s -ErrorAction SilentlyContinue) {
        Run "Service $s stopped and disabled" { Stop-Service $s -Force -ErrorAction SilentlyContinue; Set-Service $s -StartupType Disabled -ErrorAction Stop }
    }
}

$current  = $env:USERNAME
$cs       = Get-CimInstance Win32_ComputerSystem
IsDC   =(cs.DomainRole -ge 4)
$IsServer = ((Get-CimInstance Win32_OperatingSystem).ProductType -ne 1)
Write-Host "Host: $env:COMPUTERNAME  User: current Server=IsServer  DomainController=IsDC Auto=Auto  Aggressive=Aggressive AuditOnly=AuditOnly" -ForegroundColor Magenta
Write-Host "Reminder: SNAPSHOT THE VM. Do forensics BEFORE remediation. Keep notes of what gains/loses points." -ForegroundColor Magenta

# =====================================================================
#  0. README (find, download, parse)
# =====================================================================
Section 'README'
function Get-ReadmeRaw {
    $c = @()
    if ($ReadmePath) { $c += $ReadmePath }
    $c += 'C:\CyberPatriot\README.url','C:\CyberPatriot\README.html','C:\CyberPatriot\README.htm','C:\CyberPatriot\README.txt'
    c+=(Get-ChildItem"env:SystemDrive\Users\*\Desktop\README*","$env:PUBLIC\Desktop\README*" -ErrorAction SilentlyContinue | ForEach-Object FullName)
    foreach ($p in $c) {
        if (-not (Test-Path $p)) { continue }
        if ($p -match '\.lnk$') { continue }
        try {
            if ($p -match '\.url$') {
                $m = Select-String -Path p-Pattern'URL=(.+)' | Select-Object -First 1
                if ($m) {
                    $u = $m.Matches[0].Groups[1].Value.Trim()
                    Info "README shortcut -> $u"
                    $r = (Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 25).Content
                    if ($r) { return $r }
                }
            } else {
                $r = Get-Content $p -Raw
                if ($r) { Info "README file: $p"; return $r }
            }
        } catch { Warn "Could not read $p : (_.Exception.Message)" }
    }
    return $null
}
$raw = Get-ReadmeRaw
if (-not $raw) {
    Warn 'README not found/downloaded. Save it as HTML and pass -ReadmePath, or fill CONFIG by hand.'
    Todo 'README was not parsed. Read it by hand and fill CONFIG (authorized users/admins, critical services), then re-run.'
} else {
    $t = $raw -replace '(?is)<(script|style).*?</\1>','' -replace '(?i)<br\s*/?>',"`n" -replace '(?i)</(p|div|li|tr|h[1-6]|pre|ul|ol|table)>',"`n" -replace '<[^>]+>',''
    t=([System.Net.WebUtility]::HtmlDecode(t)) -replace "`r",''
    $lines = $t -split "`n" | ForEach-Object { $_.Trim() }
    $mode = $null; $pAdmins = @(); $pUsers = @()
    foreach ($l in $lines) {
        if ($l -match '^Authorized Administrators?') { $mode = 'admin'; continue }
        if ($l -match '^Authorized Users?')          { $mode = 'user';  continue }
        if (-not $mode) { continue }
        if ($l -eq '') { if ($mode -eq 'user' -and $pUsers.Count -gt 0) { $mode = $null }; continue }
        if ($l -match '^password\s*:') { continue }
        if ($l -match '^([A-Za-z0-9._\-\$]{1,40})(\s*\(you\))?$') {
            if ($mode -eq 'admin') { $pAdmins += $Matches[1] } else { $pUsers += $Matches[1] }
        } elseif ($mode -eq 'admin' -and $pAdmins.Count -gt 0) { $mode = $null }
    }
    Write-Host "README parsed -> Admins: (pAdmins -join ', ')" -ForegroundColor White
    Write-Host "                 Users : (pUsers -join ', ')" -ForegroundColor White
    if ($AuthorizedAdmins.Count -eq 0 -and AuthorizedUsers.Count-eq0-and(pAdmins.Count + $pUsers.Count) -gt 0) {
        if ($AuditOnly -or (Confirm-Action 'Use these README lists as the AUTHORIZED lists (everyone else gets removed)?')) {
            $AuthorizedAdmins = $pAdmins; $AuthorizedUsers = $pUsers
        }
    }
    $crit = ''
    if ($t -match '(?is)Critical Services?:?\s*(.+?)(\n\s*\n|\z)') { $crit = $Matches[1] }
    if ($crit) {
        Write-Host "Critical services text: $crit" -ForegroundColor White
        if ($crit -match '(?i)remote desktop|\brdp\b')                      { $RDPRequired = $true }
        if ($crit -match '(?i)\bIIS\b|web server|world wide web|w3svc|http') { $IISRequired = $true }
        if ($crit -match '(?i)ftp')                                         { $FTPRequired = $true }
    }
    Write-Host "Flags -> RDP=RDPRequiredIIS=IISRequired FTP=$FTPRequired" -ForegroundColor White
    Write-Host "`n--- README lines that look like directives (READ THESE, script cannot act on all) ---" -ForegroundColor Yellow
    $lines | Where-Object { $_ -match '(?i)\b(create|add|remove|do not|don''t|must|should|remain|critical|forensic|only|required|prohibit|unauthori[sz]ed)\b' } |
        Select-Object -First 45 | ForEach-Object { Write-Host "  > $_" }
    Todo 'Re-read README directives printed above (create users/groups, group memberships, required software, do-not-touch items) and do any the script cannot.'
}

# =====================================================================
#  1. EVIDENCE SNAPSHOT (before ANY change) -> Desktop\CP-Evidence.txt
# =====================================================================
Section 'Evidence snapshot (forensics help)'
function Add-Ev(title,data) {
    "`n=== $title ===" | Out-File $EvFile -Append -Encoding utf8
    if ($null -ne $data) { ($data | Out-String -Width 250) | Out-File $EvFile -Append -Encoding utf8 }
}
"CP evidence collected $(Get-Date) on $env:COMPUTERNAME by $current" | Out-File $EvFile -Force -Encoding utf8
try {
    Add-Ev 'OS' (Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,BuildNumber,InstallDate | Format-List)
    if (-not $IsDC) {
        Add-Ev 'Local users (with SIDs)' (Get-LocalUser | Select-Object Name,Enabled,SID,LastLogon,PasswordLastSet,PasswordRequired,PasswordExpires,Description | Format-Table -AutoSize)
        Add-Ev 'Local groups + members' (Get-LocalGroup | ForEach-Object { g=_.Name; Get-LocalGroupMember $g -ErrorAction SilentlyContinue | ForEach-Object { [pscustomobject]@{Group=$g;Member=$_.Name;Type=$_.ObjectClass} } } | Format-Table -AutoSize)
    } elseif (Get-Module -ListAvailable ActiveDirectory) {
        Import-Module ActiveDirectory
        Add-Ev 'AD users' (Get-ADUser -Filter * -Properties Enabled,PasswordNeverExpires,PasswordNotRequired,LastLogonDate,DoesNotRequirePreAuth,Description | Select-Object SamAccountName,Enabled,PasswordNeverExpires,PasswordNotRequired,DoesNotRequirePreAuth,LastLogonDate,SID,Description | Format-Table -AutoSize)
        Add-Ev 'AD privileged groups' ('Domain Admins','Enterprise Admins','Schema Admins','Administrators','Account Operators','Backup Operators','Server Operators','Print Operators','DnsAdmins' | ForEach-Object { g=_; Get-ADGroupMember $g -ErrorAction SilentlyContinue | ForEach-Object { [pscustomobject]@{Group=$g;Member=$_.SamAccountName} } } | Format-Table -AutoSize)
    }
    Add-Ev 'Shares' (Get-SmbShare | Select-Object Name,Path,Description | Format-Table -AutoSize)
    Add-Ev 'Listening ports + process' (Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Sort-Object LocalPort | ForEach-Object { [pscustomobject]@{Port=$_.LocalPort;Addr=$_.LocalAddress;PID=$_.OwningProcess;Proc=(Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).Name;Path=(Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).Path} } | Format-Table -AutoSize)
    Add-Ev 'Running processes (non-Windows paths)' (Get-Process | Where-Object { $_.Path -and $_.Path -notmatch '\\Windows\\' } | Select-Object Name,Id,Path | Format-Table -AutoSize)
    Add-Ev 'Non-Microsoft scheduled tasks' (Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -notmatch '\\Microsoft\\' } | Select-Object TaskPath,TaskName,State | Format-Table -AutoSize)
    Add-Ev 'Auto-start services outside Windows dirs' (Get-CimInstance Win32_Service | Where-Object { $_.StartMode -eq 'Auto' -and $_.PathName -notmatch 'Windows|svchost' } | Select-Object Name,State,PathName | Format-List)
    runOut=foreach(k in 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce','HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run') { "-- $k"; Get-ItemProperty $k -ErrorAction SilentlyContinue }
    Add-Ev 'Run keys' $runOut
    Add-Ev 'Startup folders' (Get-ChildItem "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\Startup","$env:SystemDrive\Users\*\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup" -Force -ErrorAction SilentlyContinue | Select-Object FullName,LastWriteTime | Format-Table -AutoSize)
    Add-Ev 'Hosts file (non-comment)' (Get-Content "$env:SystemRoot\System32\drivers\etc\hosts" | Where-Object { $_ -and $_ -notmatch '^\s*#' })
    Add-Ev 'DNS servers' (Get-DnsClientServerAddress -ErrorAction SilentlyContinue | Where-Object { $_.ServerAddresses } | Select-Object InterfaceAlias,AddressFamily,ServerAddresses | Format-Table -AutoSize)
    Add-Ev 'Portproxy' (netsh interface portproxy show all)
    $uninst = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*' -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName }
    Add-Ev 'Installed software' ($uninst | Select-Object DisplayName,DisplayVersion,Publisher,InstallLocation | Sort-Object DisplayName | Format-Table -AutoSize)
    $mediaExt = @('*.mp3','*.mp4','*.avi','*.mov','*.mkv','*.flac','*.wav','*.ogg','*.wma','*.m4a','*.aac')
    Add-Ev 'Media files under Users' ($mediaExt | ForEach-Object { Get-ChildItem "$env:SystemDrive\Users" -Recurse -Force -Filter $_ -ErrorAction SilentlyContinue } | Select-Object FullName,Length,LastWriteTime | Format-Table -AutoSize)
    Add-Ev 'Hidden files under Users (non-AppData)' (Get-ChildItem "$env:SystemDrive\Users" -Recurse -Force -Hidden -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch 'AppData|NTUSER|ntuser|desktop\.ini|\\Default' } | Select-Object FullName,Length,LastWriteTime | Format-Table -AutoSize)
    Add-Ev 'Files modified in last 60 days under Users (non-AppData)' (Get-ChildItem "$env:SystemDrive\Users" -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -gt (Get-Date).AddDays(-60) -and $_.FullName -notmatch 'AppData|NTUSER|ntuser|\\Default|desktop\.ini' } | Select-Object FullName,Length,LastWriteTime | Format-Table -AutoSize)
    txt=Get-ChildItem"env:SystemDrive\Users\*\Desktop\*","$env:SystemDrive\Users\*\Documents\*","$env:SystemDrive\Users\*\Downloads\*" -Include *.txt,*.log,*.csv,*.ini,*.conf,*.cfg,*.md -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Length -lt 51200 }
    foreach ($f in $txt) { Add-Ev "TEXT FILE (f.FullName)" (Get-Content $f.FullName -TotalCount 40 -ErrorAction SilentlyContinue) }
    Add-Ev 'Recent logon events (4624/4625/4720 last 200)' (Get-WinEvent -FilterHashtable @{LogName='Security';Id=4624,4625,4720,4722,4728,4732} -MaxEvents 200 -ErrorAction SilentlyContinue | Select-Object TimeCreated,Id,Message | Format-List)
    Info "Evidence written to $EvFile"
} catch { Warn "Evidence collection hit an error: (_.Exception.Message)" }
Todo 'FORENSICS QUESTIONS (+10 pts each): answer them from CP-Evidence.txt / by hand. Remediation below can delete the evidence.'
if (-not $Auto -and -not $AuditOnly) {
    Read-Host "`nANSWER THE FORENSICS QUESTIONS NOW (see $EvFile). Press Enter to begin remediation" | Out-Null
}

# =====================================================================
#  2. USERS AND GROUPS
# =====================================================================
Section 'Users and groups'
$builtin = @('Administrator','Guest','DefaultAccount','WDAGUtilityAccount','krbtgt')
authorized=@(AuthorizedUsers + $AuthorizedAdmins) | Sort-Object -Unique
$sec = ConvertTo-SecureString $NewPassword -AsPlainText -Force

if ($authorized.Count -eq 0) {
    Warn 'No authorized users/admins known -> user REMOVAL and admin cleanup are skipped (protects you from deleting everyone).'
    Todo 'Fill in authorized users/admins (README) and re-run so unauthorized accounts and admins get cleaned up.'
}

if (-not $IsDC) {
    # ---------- local accounts ----------
    Get-LocalUser | Format-Table Name,Enabled,LastLogon,PasswordRequired,PasswordExpires -AutoSize
    if ($authorized.Count -gt 0) {
        foreach ($u in Get-LocalUser) {
            if ($u.Name -in $builtin -or $u.Name -eq $current) { continue }
            if ($u.Name -notin $authorized) {
                if (Confirm-Action "Remove UNAUTHORIZED user '(u.Name)'?") { Run "Removed user (u.Name)" { Remove-LocalUser -Name $u.Name } }
            }
        }
        foreach ($m in Get-LocalGroupMember -Group 'Administrators' -ErrorAction SilentlyContinue) {
            if ($m.ObjectClass -ne 'User') { continue }
            $n = $m.Name.Split('\')[-1]
            if ($n -in $builtin) { continue }
            if ($n -eq $current -and $n -notin $AuthorizedAdmins) { Warn "You ($current) are in Administrators but not authorized - leaving your own account alone."; continue }
            if ($n -notin $AuthorizedAdmins) {
                if (Confirm-Action "Remove '$n' from Administrators?") { Run "Removed $n from Administrators" { Remove-LocalGroupMember -Group 'Administrators' -Member $m.Name } }
            }
        }
        foreach ($a in $AuthorizedAdmins) {
            if (Get-LocalUser -Name $a -ErrorAction SilentlyContinue) {
                $isAdm = Get-LocalGroupMember -Group 'Administrators' -ErrorAction SilentlyContinue | Where-Object { $_.Name.Split('\')[-1] -eq $a }
                if (-not $isAdm) { Run "Added $a to Administrators" { Add-LocalGroupMember -Group 'Administrators' -Member $a } }
            } else { Warn "Authorized admin '$a' does not exist." }
        }
    }
    # create users/groups the README asked for
    foreach ($nu in $UsersToCreate) {
        if (-not (Get-LocalUser -Name $nu -ErrorAction SilentlyContinue)) {
            Run "Created user $nu" { New-LocalUser -Name $nu -Password sec-PasswordNeverExpires:false -ErrorAction Stop | Out-Null; Add-LocalGroupMember -Group 'Users' -Member $nu }
        }
    }
    foreach ($g in $GroupsToCreate) {
        if (-not (Get-LocalGroup -Name $g -ErrorAction SilentlyContinue)) { Run "Created group $g" { New-LocalGroup -Name $g | Out-Null } }
    }
    foreach ($g in $GroupMembers.Keys) {
        foreach ($mem in GroupMembers[g]) { Run "Added $mem to $g" { Add-LocalGroupMember -Group $g -Member $mem -ErrorAction Stop } }
    }
    # lock down built-ins
    foreach ($b in 'Guest','Administrator','DefaultAccount') {
        if ((Get-LocalUser -Name $b -ErrorAction SilentlyContinue) -and $b -ne $current) { Run "Disabled built-in $b" { Disable-LocalUser -Name $b } }
    }
    foreach ($g in 'Remote Desktop Users','Backup Operators','Power Users','Remote Management Users','Network Configuration Operators') {
        $mem = Get-LocalGroupMember -Group $g -ErrorAction SilentlyContinue
        if ($mem) { Warn "Group '$g' members: (mem.Name -join ', ') <- verify against README" }
    }
} else {
    # ---------- Active Directory (domain controller) ----------
    if (Get-Module -ListAvailable ActiveDirectory) {
        Import-Module ActiveDirectory
        $dom = Get-ADDomain
        Run 'Default domain password + lockout policy' {
            Set-ADDefaultDomainPasswordPolicy -Identity $dom.DNSRoot -ComplexityEnabled $true -ReversibleEncryptionEnabled $false -MinPasswordLength 14 -PasswordHistoryCount 24 -MaxPasswordAge 90.00:00:00 -MinPasswordAge 1.00:00:00 -LockoutThreshold 10 -LockoutDuration 00:30:00 -LockoutObservationWindow 00:30:00
        }
        foreach ($u in Get-ADUser -Filter * -Properties PasswordNotRequired,PasswordNeverExpires,DoesNotRequirePreAuth,AllowReversiblePasswordEncryption,UseDESKeyOnly,TrustedForDelegation,Enabled) {
            $sam = $u.SamAccountName
            if ($sam -eq 'krbtgt' -or sam.EndsWith('')) { continue }
            if ($authorized.Count -gt 0 -and $sam -notin $builtin -and $sam -ne $current -and $sam -notin $authorized) {
                if (Confirm-Action "Remove UNAUTHORIZED domain user '$sam'?") { Run "Removed AD user $sam" { Remove-ADUser -Identity u-Confirm:false }; continue }
            }
            Run "AD account flags hardened: $sam" {
                Set-ADUser -Identity $u -PasswordNotRequired $false -PasswordNeverExpires $false -AllowReversiblePasswordEncryption $false
                Set-ADAccountControl -Identity $u -DoesNotRequirePreAuth $false -UseDESKeyOnly $false -TrustedForDelegation $false
            }
            if ($u.Enabled -and $sam -ne $current -and $sam -notin $SkipPasswordUsers -and $sam -ne 'Guest') {
                if ($Auto -or (Confirm-Action "Reset domain password for $sam?")) { Run "Password reset: $sam" { Set-ADAccountPassword -Identity $u -Reset -NewPassword $sec } }
            }
        }
        Run 'Guest disabled' { Disable-ADAccount -Identity Guest }
        if ($authorized.Count -gt 0) {
            foreach ($g in 'Domain Admins','Enterprise Admins','Schema Admins','Administrators','DnsAdmins','Group Policy Creator Owners','Account Operators','Backup Operators','Server Operators','Print Operators') {
                foreach ($m in Get-ADGroupMember -Identity $g -ErrorAction SilentlyContinue) {
                    $ms = $m.SamAccountName
                    if ($ms -in $builtin -or $ms -eq $current -or $m.objectClass -ne 'user') { continue }
                    keep=(g -in 'Domain Admins','Enterprise Admins','Schema Admins','Administrators','DnsAdmins') -and ($ms -in $AuthorizedAdmins)
                    if (-not $keep) { if (Confirm-Action "Remove '$ms' from AD group '$g'?") { Run "Removed $ms from $g" { Remove-ADGroupMember -Identity $g -Members m-Confirm:false } } }
                }
            }
            foreach ($a in $AuthorizedAdmins) {
                if (Get-ADUser -Filter "SamAccountName -eq '$a'" -ErrorAction SilentlyContinue) {
                    $inDA = Get-ADGroupMember 'Domain Admins' -ErrorAction SilentlyContinue | Where-Object SamAccountName -eq $a
                    if (-not $inDA) { Run "Added $a to Domain Admins" { Add-ADGroupMember -Identity 'Domain Admins' -Members $a } }
                }
            }
        }
        foreach ($g in $GroupsToCreate) { if (-not (Get-ADGroup -Filter "Name -eq '$g'" -ErrorAction SilentlyContinue)) { Run "Created AD group $g" { New-ADGroup -Name $g -GroupScope Global } } }
        foreach ($g in $GroupMembers.Keys) { foreach ($mem in GroupMembers[g]) { Run "Added $mem to $g" { Add-ADGroupMember -Identity $g -Members $mem } } }
        if ($Aggressive -and (Confirm-Action 'Reset krbtgt password twice (golden-ticket cleanup)?')) {
            Run 'krbtgt reset x2' {
                1..2 | ForEach-Object {
                    $rp = ConvertTo-SecureString ([guid]::NewGuid().ToString() + 'aA1!' + [guid]::NewGuid().ToString()) -AsPlainText -Force
                    Set-ADAccountPassword -Identity krbtgt -Reset -NewPassword $rp
                }
            }
        }
        Todo 'AD: confirm Default Domain Policy / GPOs do not override your settings (gpupdate /force); check for unknown GPOs, OUs and computer accounts.'
    } else { Warn 'This is a DC but the ActiveDirectory PowerShell module is missing - do AD users/groups by hand (dsa.msc).' }
}

# Passwords for local users (after policy is set below, so ordering is re-applied there)
function Set-AllLocalPasswords {
    if ($IsDC -or $AuditOnly) { return }
    if (-not (Confirm-Action "Set EVERY enabled local user's password to the configured one (except you + SkipPasswordUsers)?")) { return }
    foreach ($u in Get-LocalUser | Where-Object { $_.Enabled }) {
        if ($u.Name -eq $current -or $u.Name -in $SkipPasswordUsers) { continue }
        try {
            Set-LocalUser -Name $u.Name -Password $sec -PasswordNeverExpires $false -ErrorAction Stop
            net user $u.Name /passwordreq:yes | Out-Null
            Info "Password set for (u.Name)"
