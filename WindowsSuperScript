$installed = Get-ItemProperty $uninstKeys -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName }
foreach ($pat in $ProhibitedSoftware) {
    foreach ($app in $installed | Where-Object { $_.DisplayName -match $pat -and -not (Test-Protected $_.DisplayName) }) {
        Warn "Prohibited software installed: (app.DisplayName)"
        if (Confirm-Action "Uninstall '(app.DisplayName)'?") {
            cmd=if(app.QuietUninstallString) { $app.QuietUninstallString } else { $app.UninstallString }
            if ($cmd -match 'msiexec') { cmd=(cmd -replace '/I','/X') + ' /qn /norestart' }
            elseif (-not $app.QuietUninstallString) { cmd="cmd /S /silent" }
            Run "Uninstall launched: (app.DisplayName)" { Start-Process cmd.exe -ArgumentList "/c $cmd" -Wait -WindowStyle Hidden }
        }
    }
}
foreach (rootin"env:SystemDrive\Users","env:ProgramFiles","{env:ProgramFiles(x86)}","$env:ProgramData") {
