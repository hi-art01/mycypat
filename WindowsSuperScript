# ---------------------------------------------------------------------
# 3. AUDIT POLICY & SECURITY REGISTRY OPTIONS
# ---------------------------------------------------------------------
Section "3. Audit Policy & Security Registry Options"

if (Confirm-Prompt "Enable full audit logging across all subcategories?") {
    auditpol /set /category:* /success:enable /failure:enable | Out-Null
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa' 'SCENoApplyLegacyAuditPolicy' 1
    Info "Enabled full auditpol logging"
}

if (Confirm-Prompt "Apply security registry options (UAC max, SmartScreen, LSA, CAD, WDigest, SMBGhost)?") {
    $lsa = 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    $lsv = 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    $lws = 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters'
    $wl  = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'

    Set-RegProperty $lsa 'LimitBlankPasswordUse' 1
    Set-RegProperty $lsa 'restrictanonymous' 1
    Set-RegProperty $lsa 'restrictanonymoussam' 1
    Set-RegProperty $lsa 'everyoneincludesanonymous' 0
    Set-RegProperty $lsa 'NoLMHash' 1
    Set-RegProperty $lsa 'LmCompatibilityLevel' 5
    Set-RegProperty $lsa 'disabledomaincreds' 1
    Set-RegProperty $lsa 'RunAsPPL' 1

    # UAC max
    Set-RegProperty $sys 'EnableLUA' 1
    Set-RegProperty $sys 'ConsentPromptBehaviorAdmin' 2
    Set-RegProperty $sys 'ConsentPromptBehaviorUser' 0
    Set-RegProperty $sys 'PromptOnSecureDesktop' 1
    Set-RegProperty $sys 'DontDisplayLastUserName' 1
    Set-RegProperty $sys 'DisableCAD' 0
    Set-RegProperty $sys 'InactivityTimeoutSecs' 900

    # AutoRun & SmartScreen
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer' 'NoDriveTypeAutoRun' 255
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\System' 'EnableSmartScreen' 1

    # Printer Driver Installation
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers' 'AddPrinterDrivers' 1

    # Winlogon / Recovery Console
    Set-RegProperty $wl 'AutoAdminLogon' '0' 'String'
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Setup\RecoveryConsole' 'SecurityLevel' 0
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Setup\RecoveryConsole' 'SetCommand' 0

    # Screen Saver
    Set-RegProperty 'HKCU:\Control Panel\Desktop' 'ScreenSaveActive' '1' 'String'
    Set-RegProperty 'HKCU:\Control Panel\Desktop' 'ScreenSaveTimeOut' '600' 'String'
    Set-RegProperty 'HKCU:\Control Panel\Desktop' 'ScreenSaverIsSecure' '1' 'String'

    # SMB Hardening
    Set-RegProperty $lsv 'AutoDisconnect' 15
    Set-RegProperty $lsv 'RequireSecuritySignature' 1
    Set-RegProperty $lsv 'EnableSecuritySignature' 1
    Set-RegProperty $lsv 'DisableCompression' 1
    Set-RegProperty $lws 'RequireSecuritySignature' 1
    Set-RegProperty $lws 'EnableSecuritySignature' 1
    Set-RegProperty $lws 'EnablePlainTextPassword' 0

    # WDigest, Wi-Fi Sense & Remote Assistance
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest' 'UseLogonCredential' 0
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server' 'fAllowToGetHelp' 0
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\WcmSvc\wifinetworkmanager\config' 'AutoConnectAllowedOEM' 0

    # UPnP & NetBIOS / LLMNR
    Set-RegProperty 'HKLM:\SOFTWARE\Microsoft\DirectplayNATHelp\DPNHUPnP' 'UPnPMode' 2
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient' 'EnableMulticast' 0

    # PowerShell Logging
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging' 'EnableScriptBlockLogging' 1
    Set-RegProperty 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ModuleLogging' 'EnableModuleLogging' 1
}

# ---------------------------------------------------------------------
# 4. REMOTE DESKTOP (RDP) HARDENING
# ---------------------------------------------------------------------
Section "4. Remote Desktop (RDP) Hardening"

$ts  = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
$rdp = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp'

if ($RDPRequired) {
    if (Confirm-Prompt "Configure required Remote Desktop (Enable RDP, NLA, SSL, and Firewall rules)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 0
        Set-RegProperty $rdp 'UserAuthentication' 1
        Set-RegProperty $rdp 'SecurityLayer' 2
        Enable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop enabled with NLA, SSL security, and firewall rules"
    }
} else {
    if (Confirm-Prompt "Disable Remote Desktop (RDP)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 1
        Disable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop disabled"
    }
}

# ---------------------------------------------------------------------
# 5. WINDOWS DEFENDER & FIREWALL
# ---------------------------------------------------------------------
Section "5. Windows Defender & Firewall Settings"

if (Confirm-Prompt "Enable Windows Defender Real-Time Protection, Firewall, and clear exclusions?") {
    Set-MpPreference -DisableRealtimeMonitoring $false -DisableBehaviorMonitoring $false -DisableIOAVProtection $false -PUAProtection Enabled -ErrorAction SilentlyContinue
    Set-Service WinDefend -StartupType Automatic -ErrorAction SilentlyContinue
    Start-Service WinDefend -ErrorAction SilentlyContinue

    # Clear Defender exclusions
    $mp = Get-MpPreference -ErrorAction SilentlyContinue
    if ($mp) {
        foreach ($p in @($mp.ExclusionPath)) { if ($p) { Remove-MpPreference -ExclusionPath $p -ErrorAction SilentlyContinue } }
        foreach ($p in @($mp.ExclusionExtension)) { if ($p) { Remove-MpPreference -ExclusionExtension $p -ErrorAction SilentlyContinue } }
        foreach ($p in @($mp.ExclusionProcess)) { if ($p) { Remove-MpPreference -ExclusionProcess $p -ErrorAction SilentlyContinue } }
    }

    Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True -DefaultInboundAction Block -DefaultOutboundAction Allow
    Set-Service mpssvc -StartupType Automatic -ErrorAction SilentlyContinue
    Start-Service mpssvc -ErrorAction SilentlyContinue

    # Prune non-required inbound rules
    Get-NetFirewallRule -Direction Inbound -Enabled True -ErrorAction SilentlyContinue |
        Where-Object { $_.DisplayName -match 'Microsoft Edge|Search|MSN|Money|Sports|News|Weather|Photos|Xbox' } |
        Disable-NetFirewallRule -ErrorAction SilentlyContinue

    Info "Windows Defender exclusions cleared and Firewall enabled"
}

# ---------------------------------------------------------------------
# 6. PERSISTENCE SWEEP (IFEO, WMI, Tasks, Run Keys, Hosts File, NetBIOS)
# ---------------------------------------------------------------------
Section "6. Persistence Sweep (IFEO, WMI, Scheduled Tasks, Run Keys, Hosts)"

if (Confirm-Prompt "Sweep IFEO debugger hijacks, WMI subscriptions, Scheduled Tasks, Run keys, and Hosts file?") {
    # IFEO Debugger Hijacks
    foreach ($base in 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows NT\CurrentVersion\Image File Execution Options') {
        Get-ChildItem $base -ErrorAction SilentlyContinue | ForEach-Object {
            $d = (Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue).Debugger
            if ($d -and $d -match 'cmd\.exe|powershell|nc\.exe') {
                Remove-ItemProperty $_.PSPath -Name Debugger -ErrorAction SilentlyContinue
                Info "Cleaned IFEO debugger hijack on $($_.PSChildName)"
            }
        }
    }

    # WMI Event Subscriptions
    foreach ($cls in '__EventFilter','CommandLineEventConsumer','ActiveScriptEventConsumer','__FilterToConsumerBinding') {
        Get-CimInstance -Namespace root\subscription -ClassName $cls -ErrorAction SilentlyContinue | ForEach-Object {
            if ($_.Name -notmatch '^SCM Event Log') {
                Remove-CimInstance -InputObject $_ -ErrorAction SilentlyContinue
                Info "Removed WMI subscription $($_.Name)"
            }
        }
    }

    # Non-Microsoft Scheduled Tasks
    Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -notmatch '\\Microsoft\\' } | ForEach-Object {
        if ($script:FAST_MODE -or (Confirm-Timed "Unregister non-Microsoft Scheduled Task '$($_.TaskName)'?")) {
            Unregister-ScheduledTask -TaskName $_.TaskName -TaskPath $_.TaskPath -Confirm:$false -ErrorAction SilentlyContinue
            Info "Unregistered task $($_.TaskName)"
        }
    }

    # Run / RunOnce Keys
    foreach ($rk in 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run','HKCU:\Software\Microsoft\Windows\CurrentVersion\Run','HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce') {
        $props = Get-ItemProperty $rk -ErrorAction SilentlyContinue
        if ($props) {
            foreach ($p in $props.PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' }) {
                if ($p.Value -match '\\Users\\|\\Temp\\|AppData|\.vbs|\.bat|\.ps1|cmd\.exe|powershell|nc\.exe') {
                    Remove-ItemProperty -Path $rk -Name $p.Name -ErrorAction SilentlyContinue
                    Info "Removed startup run entry $($p.Name)"
                }
            }
        }
    }

    # Hosts File Cleanup
    $hostsPath = "$env:SystemRoot\System32\drivers\etc\hosts"
    $hostsContent = Get-Content $hostsPath -ErrorAction SilentlyContinue
    $cleanHosts = $hostsContent | Where-Object { $_ -match '^\s*#' -or $_ -match '^\s*(127\.0\.0\.1|::1)\s+localhost\s*$' -or [string]::IsNullOrWhiteSpace($_) }
    $cleanHosts | Set-Content $hostsPath -Force -ErrorAction SilentlyContinue
    Info "Cleaned hosts file to localhost defaults"

    # Disable NetBIOS over TCP/IP & DNS Registration
    Get-ChildItem 'HKLM:\SYSTEM\CurrentControlSet\Services\NetBT\Parameters\Interfaces' -ErrorAction SilentlyContinue | ForEach-Object {
        Set-ItemProperty -Path $_.PSPath -Name 'NetbiosOptions' -Value 2 -ErrorAction SilentlyContinue
    }
    Set-DnsClient -InterfaceAlias '*' -RegisterThisConnectionsAddress $false -ErrorAction SilentlyContinue
    Info "Disabled NetBIOS over TCP/IP and DNS adapter registration"
}

# ---------------------------------------------------------------------
# 7. SERVICES, FEATURES & SHARES
# ---------------------------------------------------------------------
Section "7. Services, Optional Features & Shares"

if (Confirm-Prompt "Disable unauthorized services and optional features?") {
    $svcDisable = @('FTPSVC','MSFTPSVC','W3SVC','WMSvc','TlntSvr','SNMP','SNMPTRAP','RIPListener','upnphost','SSDPSRV','RemoteRegistry','NfsClnt','SMTPSVC')
    if ($IISRequired) { $svcDisable = $svcDisable | Where-Object { $_ -notin 'W3SVC','WMSvc' } }
    if ($FTPRequired) { $svcDisable = $svcDisable | Where-Object { $_ -notin 'FTPSVC','MSFTPSVC' } }

    foreach ($s in $svcDisable) {
        if ($s -in $KeepServices) { continue }
        if (Get-Service -Name $s -ErrorAction SilentlyContinue) {
            Stop-Service -Name $s -Force -ErrorAction SilentlyContinue
            Set-Service -Name $s -StartupType Disabled -ErrorAction SilentlyContinue
            Info "Disabled service $s"
        }
    }

    Set-Service Wecsvc -StartupType Automatic -ErrorAction SilentlyContinue
    Start-Service Wecsvc -ErrorAction SilentlyContinue

    # Optional Features
    $optFeatures = @('TelnetClient','TelnetServer','SimpleTCP','SMB1Protocol','ServicesForNFS-ClientOnly')
    if (-not $FTPRequired) { $optFeatures += 'TFTP' }
    if (-not $IISRequired) { $optFeatures += 'IIS-WebServerRole' }
    foreach ($f in $optFeatures) {
        Disable-WindowsOptionalFeature -Online -FeatureName $f -NoRestart -ErrorAction SilentlyContinue | Out-Null
    }
}

if (Confirm-Prompt "Disable SMBv1 and prune non-standard SMB shares?") {
    Set-SmbServerConfiguration -EnableSMB1Protocol $false -Force -Confirm:$false -ErrorAction SilentlyContinue
    Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10' 'Start' 4

    $okShares = @('ADMIN$','C$','IPC$')
    foreach ($sh in Get-SmbShare -ErrorAction SilentlyContinue) {
        if ($sh.Name -notin $okShares) {
            if ($script:FAST_MODE -or (Confirm-Prompt "Remove SMB Share '$($sh.Name)'?")) {
                Remove-SmbShare -Name $sh.Name -Force -ErrorAction SilentlyContinue
                Info "Removed share $($sh.Name)"
            }
        }
    }
}

