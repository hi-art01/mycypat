    Get-ChildItem -Path "$env:SystemDrive\Users\*\Desktop\*","$env:SystemDrive\Users\*\Downloads\*","$env:SystemDrive\Users\*\Documents\*","$env:SystemDrive\Users\Public\*" -Recurse -Force -Include '*.mp3','*.mp4','*.avi','*.mkv','*.flac','*.wav','*.mov','*.wmv','*.zip','*.rar','*.7z','*.tar','*.gz','*.deb','*.exe','*.msi','*.torrent' -ErrorAction SilentlyContinue |
