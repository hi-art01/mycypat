Section "11. Automatic Health Check"

$pCount = 0; $fCount = 0; $sCount = 0
function Check-Health($name, $condition) {
    if ($condition) { Write-Host "  [ PASS ] $name" -ForegroundColor Green; Info "HEALTH PASS: $name"; $script:pCount++ }
    else { Write-Host "  [ FAIL ] $name" -ForegroundColor Red; Warn "HEALTH FAIL: $name"; $script:fCount++ }
}

Check-Health "Windows Firewall Service Running" ((Get-Service mpssvc -ErrorAction SilentlyContinue).Status -eq 'Running')
Check-Health "Windows Defender Service Running" ((Get-Service WinDefend -ErrorAction SilentlyContinue).Status -eq 'Running')

if ($RDPRequired) {
    Check-Health "RDP Listening Port 3389" ((Get-NetTCPConnection -LocalPort 3389 -State Listen -ErrorAction SilentlyContinue) -ne $null)
} else {
    Write-Host "  [ SKIP ] RDP Port Check Skipped" -ForegroundColor Yellow; $sCount++
}

foreach ($a in $AuthorizedAdmins) {
    $inAdmin = Get-LocalGroupMember -Group 'Administrators' -ErrorAction SilentlyContinue | Where-Object { $_.Name.Split('\')[-1] -eq $a }
    Check-Health "Admin account $a in Administrators group" ($inAdmin -ne $null)
}

Write-Host "Health Check Summary: $pCount PASS | $fCount FAIL | $sCount SKIP" -ForegroundColor Green

