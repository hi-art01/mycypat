    Start-Service WinDefend -ErrorAction SilentlyContinue

    # Clear Defender exclusions
    $mp = Get-MpPreference -ErrorAction SilentlyContinue
    if ($mp) {
        foreach ($p in @($mp.ExclusionPath)) { if ($p) { Remove-MpPreference -ExclusionPath $p -ErrorAction SilentlyContinue } }
        foreach ($p in @($mp.ExclusionExtension)) { if ($p) { Remove-MpPreference -ExclusionExtension $p -ErrorAction SilentlyContinue } }
        foreach ($p in @($mp.ExclusionProcess)) { if ($p) { Remove-MpPreference -ExclusionProcess $p -ErrorAction SilentlyContinue } }
