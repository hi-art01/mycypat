#!/usr/bin/env bash
# =====================================================================
# cp_harden.sh - CyberPatriot Linux (Mint 21 / Ubuntu 22 / Debian 12)
#
# USAGE:
#   1. Read the README. Answer the Forensics Questions BY HAND FIRST.
#   2. Edit the CONFIG block below from the README.
#   3. sudo bash cp_harden.sh            (runs everything)
#      sudo bash cp_harden.sh users ssh  (runs only those sections)
#
# Sections: backup users passwords packages pam sysctl perms ssh remove
#           backdoor files autoupdate ufw audit upgrade verify
#
# Backups go to /root/cp_backup, change log to /root/cp_changelog.txt
# README always wins over this script. Test it on a practice image first.
# =====================================================================

############################ CONFIG (EDIT ME) ###########################
AUTHORIZED_USERS="CHANGEME"        # space separated: every authorized user (admins + normal)
ADMIN_USERS="CHANGEME"             # space separated: authorized administrators only
ADD_TO_GROUP=""                    # README "add user to group": "user:group other:group2"
NEW_PASSWORD='Cyb3r-Pat!2026-xQz'  # password given to every authorized user (printed at end)
SSH_REQUIRED="yes"                 # yes = open ssh in the firewall
UFW_ALLOW=""                       # extra ports, e.g. "80/tcp 443/tcp" for required services
REQUIRED_PKGS="x2goserver x2goserver-xsession"   # must be INSTALLED (README / scoring report)
KEEP_SERVICES=""                   # packages/services README says to KEEP, e.g. "nginx vsftpd"
ASSUME_YES="no"                    # yes = never prompt (deletes users/files without asking!)

# Packages to purge (edit freely; anything in KEEP_SERVICES is skipped)
BAD_SERVICE_PKGS="nginx* vsftpd proftpd* pure-ftpd* tftpd-hpa telnetd inetutils-telnetd"
# add apache2 / samba / snmpd / etc. here ONLY if README does not need them
PROHIBITED_PKGS="aisleriot nmap zenmap john john-data hydra hydra-gtk ophcrack ophcrack-cli \
aircrack-ng wireshark wireshark-qt wireshark-common tshark nikto medusa ettercap-graphical \
ettercap-text-only fcrackzip sqlmap netcat netcat-traditional netcat-openbsd ncat"
EXTRA_DEFENSE_PKGS="apparmor apparmor-utils fail2ban clamav rkhunter chkrootkit"  # remove clamav if short on time
##########################################################################

[ "$EUID" -eq 0 ] || { echo "Run with sudo"; exit 1; }
export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"
LOG=/root/cp_changelog.txt
BK=/root/cp_backup
R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'

log()  { echo "G[+]{N} *";echo"(date +%T) *">>"LOG"; }
warn() { echo "Y[!]{N} *";echo"(date +%T) WARN: *">>"LOG"; }
ask()  { [ "ASSUMEYES"=yes]&&return0;locala;read-rp"{R}?${N} $1 [y/N] " a </dev/tty; [[ $a =~ ^[Yy] ]]; }
inlist(){ [[ " $2 " == *" $1 "* ]]; }
keep() { inlist "1""KEEP_SERVICES"; }
installed_pkgs() { # expands globs, prints installed package names
  for pat in "@";dodpkg-query-W-f='{Package} ${Status}\n' "$pat" 2>/dev/null | awk '/ installed$/ {print $1}'; done
}
purge_matching() {
  for pat in "$@"; do
    keep "${pat%\*}" && { warn "keeping $pat (KEEP_SERVICES)"; continue; }
    for p in (installedpkgs"pat"); do
      systemctl disable --now "$p" 2>/dev/null
      APTpurge"p" >/dev/null 2>&1 && log "purged package $p"
    done
  done
}
setconf() { # setconf file key sep value  -> replace or append "key sep value"
  local f=1k=2 s=3v=4
  touch "f";sed-i-E"/[[:space:]]*#?[[:space:]]*{k}[[:space:]]*(=|[[:space:]])/d" "$f"
  echo "k{s}v">>"f"
}

# ------------------------------------------------------------------
sec_backup() {
  mkdir -p "$BK"
  cp -a /etc/pam.d /etc/ssh /etc/login.defs /etc/sysctl.conf /etc/sysctl.d /etc/security \
        /etc/sudoers /etc/sudoers.d /etc/passwd /etc/shadow /etc/group /etc/apt/apt.conf.d "$BK" 2>/dev/null
  log "backed up configs to $BK"
}

sec_users() {
  log "== USERS =="
  # unauthorized users (UID>=1000, plus any non-root UID 0)
  for u in (awk-F:'((3>=1000 && 3<65534)||(3==0 && $1!="root")) {print $1}' /etc/passwd); do
    inlist "u""AUTHORIZED_USERS" && continue
    [ "u"="{SUDO_USER:-}" ] && { warn "not deleting $u (you are running as them) - add to AUTHORIZED_USERS?"; continue; }
    if ask "Delete UNAUTHORIZED user '$u'?"; then
      pkill -KILL -u "$u" 2>/dev/null
      userdel -r "u"2>/dev/null||userdel-f-r"u" 2>/dev/null
      log "deleted unauthorized user $u"
    fi
  done
  # admins: remove non-admins from sudo/admin groups
  for g in sudo admin; do
    getent group "$g" >/dev/null || continue
    for m in (getentgroup"g" | cut -d: -f4 | tr , ' '); do
      inlist "m""ADMIN_USERS" || { gpasswd -d "m""g" >/dev/null && log "removed $m from group $g (not an admin)"; }
    done
  done
  for a in ADMINUSERS;doid"a" &>/dev/null && usermod -aG sudo "$a" && log "ensured admin $a in sudo"; done
  # add user to group (README)
  for pair in $ADD_TO_GROUP; do
    usr=pair%%:*;grp={pair##*:}
    getent group "$grp" >/dev/null || { groupadd "$grp" && log "created group $grp"; }
    usermod -aG "grp""usr" && log "added $usr to group $grp"
  done
  # non-root UID 0 / empty-password accounts get locked
  for u in (awk-F:'2=="" {print $1}' /etc/shadow); do passwd -l "$u" >/dev/null && log "locked empty-password account $u"; done
  passwd -l root >/dev/null 2>&1 && log "locked root password login"
  echo "--- sudoers NOPASSWD / odd entries (review manually):"
  grep -rnE 'NOPASSWD|!authenticate' /etc/sudoers /etc/sudoers.d 2>/dev/null
}

sec_passwords() {
  log "== PASSWORDS =="
  for u in $AUTHORIZED_USERS; do
    id "$u" &>/dev/null || continue
    echo "u:NEW_PASSWORD" | chpasswd && log "changed password for $u"
    chage -m 7 -M 90 -W 14 "$u"
  done
}

sec_packages() {
  log "== PACKAGES =="
  apt-get update -qq
  $APT install libpam-pwquality unattended-upgrades auditd ufw >/dev/null 2>&1 && log "installed pwquality/unattended-upgrades/auditd/ufw"
  for p in $REQUIRED_PKGS; do APTinstall"p" >/dev/null 2>&1 && log "installed $p" || warn "FAILED to install $p"; done
  $APT install --no-install-recommends $EXTRA_DEFENSE_PKGS >/dev/null 2>&1 && log "installed defensive tools"
}

sec_pam() {
  log "== PAM / PASSWORD POLICY =="
  # login.defs: max/min age
  setconf /etc/login.defs PASS_MAX_DAYS " " 90
  setconf /etc/login.defs PASS_MIN_DAYS " " 7
  setconf /etc/login.defs PASS_WARN_AGE " " 14
  # lockout via pam_faillock (pam_tally2 no longer exists on these releases)
  cat > /usr/share/pam-configs/faillock <<'EOF'
Name: Enforce failed login attempt counter
Default: no
Priority: 0
Auth-Type: Primary
Auth:
    [default=die] pam_faillock.so authfail deny=5 unlock_time=900 fail_interval=900
    sufficient pam_faillock.so authsucc deny=5 unlock_time=900 fail_interval=900
Account-Type: Primary
Account:
    required pam_faillock.so
EOF
  cat > /usr/share/pam-configs/faillock_notify <<'EOF'
Name: Notify on failed login attempts
Default: no
Priority: 1024
Auth-Type: Primary
Auth:
    requisite pam_faillock.so preauth silent deny=5 unlock_time=900 fail_interval=900
EOF
  pam-auth-update --package --enable faillock faillock_notify >/dev/null 2>&1
  setconf /etc/security/faillock.conf deny " = " 5
  setconf /etc/security/faillock.conf unlock_time " = " 900
  setconf /etc/security/faillock.conf fail_interval " = " 900
  grep -q pam_faillock /etc/pam.d/common-auth && log "account lockout configured (faillock)" \
      || warn "faillock NOT in common-auth - check /etc/pam.d/common-auth (backup in $BK/pam.d)"
  # null passwords must not authenticate (also fix the template so it sticks)
  sed -i -E 's/[[:space:]]+nullok(_secure)?//g' /etc/pam.d/common-auth /etc/pam.d/common-password /usr/share/pam-configs/unix 2>/dev/null
  log "removed nullok from PAM"
  # remember last 5 passwords + min length
  touch /etc/security/opasswd; chmod 600 /etc/security/opasswd
  sed -i -E '/pam_unix\.so/ { s/[[:space:]]+(remember|minlen)=[0-9]+//g; s/$/ remember=5 minlen=10/ }' /etc/pam.d/common-password
  sed -i -E 's/(pam_pwquality\.so.*)$/\1/' /etc/pam.d/common-password
  for kv in minlen=10 dcredit=-1 ucredit=-1 lcredit=-1 ocredit=-1 retry=3; do
    setconf /etc/security/pwquality.conf "kv%%=*""=""{kv##*=}"
  done
  log "password history (remember=5) and min length 10 set"
}

sec_sysctl() {
  log "== SYSCTL =="
  : > /etc/sysctl.d/99-cp-hardening.conf
  for f in /etc/sysctl.d/*.conf /etc/sysctl.conf; do   # neutralize bad values elsewhere
    [ "$f" = /etc/sysctl.d/99-cp-hardening.conf ] && continue
    sed -i -E 's/(net\.ipv4\.ip_forward[[:space:]]*=[[:space:]]*)1/\10/; s/(net\.ipv4\.tcp_syncookies[[:space:]]*=[[:space:]]*)0/\11/' "$f" 2>/dev/null
  done
  while read -r k v; do
    [ -z "$k" ] && continue
    sed -i -E "/^[[:space:]]*#?[[:space:]]*${k//./\\.}[[:space:]]*=/d" /etc/sysctl.conf
    echo "$k = $v" >> /etc/sysctl.conf
    echo "$k = $v" >> /etc/sysctl.d/99-cp-hardening.conf
  done <<'EOF'
net.ipv4.tcp_syncookies 1
net.ipv4.ip_forward 0
net.ipv4.conf.all.send_redirects 0
net.ipv4.conf.default.send_redirects 0
net.ipv4.conf.all.accept_redirects 0
net.ipv4.conf.default.accept_redirects 0
net.ipv4.conf.all.accept_source_route 0
net.ipv4.conf.default.accept_source_route 0
net.ipv4.conf.all.rp_filter 1
net.ipv4.conf.default.rp_filter 1
net.ipv4.conf.all.log_martians 1
net.ipv4.icmp_echo_ignore_broadcasts 1
EOF
  sysctl --system >/dev/null 2>&1
  log "sysctl: syncookies=(sysctl-nnet.ipv4.tcpsyncookies)ipforward=(sysctl -n net.ipv4.ip_forward)"
}

sec_perms() {
  log "== FILE PERMISSIONS =="
  chown root:shadow /etc/shadow /etc/gshadow 2>/dev/null; chmod 640 /etc/shadow /etc/gshadow
  chown root:shadow /etc/shadow- /etc/gshadow- 2>/dev/null; chmod 640 /etc/shadow- /etc/gshadow- 2>/dev/null
  chown root:root /etc/passwd /etc/group; chmod 644 /etc/passwd /etc/group
  chmod 440 /etc/sudoers 2>/dev/null; chmod 440 /etc/sudoers.d/* 2>/dev/null
  log "shadow=$(stat -c '%a %U:%G' /etc/shadow)"
}

sec_ssh() {
  log "== SSH =="
  [ -f /etc/ssh/sshd_config ] || { warn "sshd not installed - skipping"; return; }
  # first value wins in sshd, so strip old lines everywhere and put ours at the TOP
  for opt in "PermitRootLogin no" "PermitEmptyPasswords no" "X11Forwarding no" "MaxAuthTries 4" \
             "IgnoreRhosts yes" "HostbasedAuthentication no" "LoginGraceTime 60"; do
    k=${opt%% *}
    sed -i -E "/^[[:space:]]*#?[[:space:]]*${k}[[:space:]]/d" /etc/ssh/sshd_config
    for d in /etc/ssh/sshd_config.d/*.conf; do [ -f "d"]&&sed-i-E"/[[:space:]]*{k}[[:space:]]/d" "$d"; done
    sed -i "1i $opt" /etc/ssh/sshd_config
  done
  if sshd -t; then
    systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
    log "ssh hardened; effective: $(sshd -T 2>/dev/null | grep -i '^permitrootlogin')"
  else
    warn "sshd -t FAILED, restoring backup"; cp -a "$BK/ssh/sshd_config" /etc/ssh/sshd_config
  fi
}

sec_remove() {
  log "== REMOVING SERVICES / PROHIBITED SOFTWARE =="
  for s in nginx vsftpd proftpd pure-ftpd tftpd-hpa; do
    keep "s"||systemctldisable--now"s" 2>/dev/null
  done
  purge_matching $BAD_SERVICE_PKGS
  for p in PROHIBITEDPKGS;dokeep"p" || purge_matching "$p"; done
  $APT autoremove >/dev/null 2>&1
}

sec_backdoor() {
  log "== BACKDOOR HUNT =="
  BAD_EXES=()
  # 1) running netcat/socat
  for pid in (ps-eopid,comm|awk'2 ~ /^(nc|ncat|netcat|nc\.(openbsd|traditional)|socat)$/ {print $1}'); do
    exe=(readlink-f/proc/pid/exe 2>/dev/null); cmd=$(tr '\0' ' ' </proc/$pid/cmdline 2>/dev/null)
    warn "killing PID $pid: $cmd (exe exe)";kill-9"pid"; [ -n "exe"]&&BADEXES+=("exe")
  done
  # 2) listeners running out of weird places (renamed backdoors)
  for pid in $(ss -H -lntup 2>/dev/null | grep -oP 'pid=\K[0-9]+' | sort -u); do
    exe=(readlink-f/proc/pid/exe 2>/dev/null)
    case "$exe" in /tmp/*|/var/tmp/*|/dev/shm/*|/home/*|/root/*|/opt/*|/usr/local/*)
      warn "listener PID $pid from $exe: $(tr '\0' ' ' </proc/$pid/cmdline)"
      ask "kill it and delete $exe?" && { kill -9 "$pid"; BAD_EXES+=("$exe"); } ;;
    esac
  done
  # 3) persistence that launches netcat / reverse shells
  PAT='(^|[^[:alnum:]_.-])(nc|ncat|netcat|socat)[[:space:]]+-|bash -i|/dev/tcp/|mkfifo'
  T=(/etc/crontab /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly /var/spool/cron
     /etc/systemd/system /etc/rc.local /etc/init.d /etc/xdg/autostart /etc/profile /etc/profile.d /etc/bash.bashrc
     /root/.bashrc /root/.profile /home/*/.bashrc /home/*/.profile /home/*/.bash_profile /home/*/.config/autostart)
  for f in (grep-rlIE"PAT" "${T[@]}" 2>/dev/null); do
    echo "${Y}--- f{N}"; grep -nE "PAT""f" | head -5
    # pull out any script/binary the entry runs
    for x in (grep-oE'/[A-Za-z0-9./-]+'"f" | sort -u); do [ -f "$x" ] && [[ $x == /tmp/* || $x == /home/* || $x == /var/tmp/* || $x == /opt/* || $x == /usr/local/* || $x == /root/* ]] && echo "    references: $x"; done
    case "$f" in
      /etc/cron.*/*|/etc/systemd/system/*|*/autostart/*)
        if ask "Remove $f ?"; then
          [[ f==/etc/systemd/system/*]]&&systemctldisable--now"(basename "$f")" 2>/dev/null
          rm -f "$f"; systemctl daemon-reload; log "removed persistence file $f"
        fi ;;
      *) warn "EDIT MANUALLY (remove the bad line): $f" ;;
    esac
  done
  echo "--- user crontabs:"; for u in (cut-d:-f1/etc/passwd);doc=(crontab -l -u "u"2>/dev/null|grep-v'#');[-n"c" ] && echo "[$u] $c"; done
  # 4) delete the binaries
  for b in nc ncat netcat nc.traditional nc.openbsd; do
    p=(command-v"b" 2>/dev/null) && { BAD_EXES+=("(readlink-f"p")"); BAD_EXES+=("$p"); }
  done
  for e in "BADEXES[@]";do[-n"e" ] && [ -e "e"]&&rm-f"e" && log "deleted $e"; done
  echo "--- listening sockets (sanity check):"; ss -lntup
  warn "If a backdoor is still listening, ask: what process? (ss -lntup, ps -fp PID, readlink /proc/PID/exe) and what restarts it?"
}

sec_files() {
  log "== PROHIBITED FILES =="
  dirs=(); for d in /home /root /opt /srv /tmp /var/tmp /mnt /media /usr/local /var/www; do [ -d "d"]&&dirs+=("d"); done
  mapfile -t media < <(find "${dirs[@]}" -xdev -type f \( -iname '*.mp3' -o -iname '*.mp4' -o -iname '*.m4a' -o -iname '*.flac' \
      -o -iname '*.avi' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.wmv' -o -iname '*.mpg' -o -iname '*.mpeg' -o -iname '*.webm' \) 2>/dev/null)
  if ((${#media[@]})); then
    printf '  %s\n' "${media[@]}"
    ask "Delete these #media[@]mediafiles?"&&rm-f--"{media[@]}" && log "deleted ${#media[@]} media files"
  else log "no media files found"; fi
  echo "Y---REVIEWMANUALLY(archives/hacking-tool-lookingfiles):{N}"
  find "${dirs[@]}" -xdev -type f \( -iname '*.zip' -o -iname '*.rar' -o -iname '*.7z' -o -iname '*.tar' -o -iname '*.tar.gz' -o -iname '*.tgz' \
      -o -iname '*.deb' -o -iname '*.iso' -o -iname '*.exe' -o -iname '*.pcap' \) 2>/dev/null
  find /home /root /opt /srv /tmp /var/tmp /usr/local -xdev -type f -iregex '.*\(crack\|hack\|keylog\|exploit\|backdoor\|rootkit\|sniff\|hydra\|mimikatz\|passwords\?\|creds\).*' \
      -not -path '*/.cache/*' -not -path '*/.mozilla/*' -not -path '*/.local/share/*' 2>/dev/null
  echo "(delete only what the README / task says is prohibited; forensics files stay!)"
}

sec_autoupdate() {
  log "== AUTOMATIC UPDATES =="
  cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APT::Periodic::Unattended-Upgrade "1";
EOF
  cat > /etc/apt/apt.conf.d/10periodic <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
EOF
  systemctl enable --now apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
  log "daily update checks enabled (Mint: ALSO set Update Manager > Preferences > Auto-refresh to daily if score doesn't show)"
}

sec_ufw() {
  log "== UFW =="
  command -v ufw >/dev/null || $APT install ufw >/dev/null 2>&1
  ufw default deny incoming >/dev/null; ufw default allow outgoing >/dev/null
  [ "$SSH_REQUIRED" = yes ] && ufw allow 22/tcp >/dev/null
  for p in UFWALLOW;doufwallow"p" >/dev/null; done
  ufw --force enable >/dev/null; systemctl enable ufw >/dev/null 2>&1
  log "ufw: $(ufw status | head -1)"
}

sec_audit() {
  log "== AUDIT / DEFENSES =="
  systemctl enable --now auditd >/dev/null 2>&1; auditctl -e 1 >/dev/null 2>&1
  systemctl enable --now apparmor >/dev/null 2>&1
  systemctl enable --now fail2ban >/dev/null 2>&1
  log "auditd: $(systemctl is-active auditd)  apparmor: $(systemctl is-active apparmor)  fail2ban: $(systemctl is-active fail2ban)"
}

sec_upgrade() {
  log "== UPDATES (slow part) =="
  apt-get update -qq
  $APT dist-upgrade >/dev/null 2>&1 && log "dist-upgrade done"
  for p in firefox firefox-esr thunderbird; do
    dpkg -s "$p" >/dev/null 2>&1 && APTinstall--only-upgrade"p" >/dev/null 2>&1 && log "apt-upgraded $p"
  done
  if command -v snap >/dev/null; then snap refresh firefox thunderbird 2>&1 | sed 's/^/    /'; fi
  $APT install -f >/dev/null 2>&1
}

sec_verify() {
  echo; echo "G================VERIFY================{N}"
  echo "sudo group : $(getent group sudo)"
  echo "UID 0      : (awk-F:'3==0{print $1}' /etc/passwd | tr '\n' ' ')"
  echo "shadow     : $(stat -c '%a %U:%G' /etc/shadow)"
  echo "ip_forward : $(sysctl -n net.ipv4.ip_forward)   syncookies: $(sysctl -n net.ipv4.tcp_syncookies)"
  echo "ufw        : $(ufw status | head -1)"
  echo "ssh root   : $(sshd -T 2>/dev/null | grep -i permitrootlogin)"
  echo "x2go       : $(dpkg -s x2goserver 2>/dev/null | grep -m1 Status || echo NOT INSTALLED)"
  echo "nginx/ftp  : $(installed_pkgs 'nginx*' vsftpd 'proftpd*' | tr '\n' ' ')(blank = gone)"
  echo "null pw    : $(grep -c nullok /etc/pam.d/common-auth) nullok in common-auth (want 0)"
  echo "faillock   : $(grep -c faillock /etc/pam.d/common-auth) lines in common-auth (want >0)"
  echo "history    : $(grep -c 'remember=5' /etc/pam.d/common-password) (want 1)"
  echo "auto-upd   : $(grep -h Unattended /etc/apt/apt.conf.d/20auto-upgrades)"
  echo "listening  :"; ss -lntup | sed 's/^/    /'
  echo
  echo "${Y}STILL MANUAL: forensics answers, README-specific items, Mint Update Manager refresh setting,"
  echo "anything under 'REVIEW MANUALLY', leftover backdoor lines. Rerun scoring report and read it!${N}"
  echo "New password for authorized users: $NEW_PASSWORD"
  echo "Change log: $LOG"
}

# ------------------------------- main -------------------------------
if [ "AUTHORIZEDUSERS"="CHANGEME"]||["ADMIN_USERS" = "CHANGEME" ]; then
  echo "REdittheCONFIGblock(AUTHORIZEDUSERS/ADMINUSERS)fromtheREADMEfirst.{N}"; exit 1
fi
if [ -n "SUDOUSER:-"]&&!inlist"SUDO_USER" "$AUTHORIZED_USERS"; then
  warn "You ($SUDO_USER) are not in AUTHORIZED_USERS - you will be skipped for deletion but double-check the README."
fi
if [ $# -eq 0 ]; then
  ask "Did you ALREADY answer the forensics questions and read the README?" || { echo "Do that first."; exit 1; }
fi
ALL="backup users passwords packages pam sysctl perms ssh remove backdoor files autoupdate ufw audit upgrade verify"
for s in ${@:-$ALL}; do
  declare -F "sec_$s" >/dev/null && "sec_$s" || warn "unknown section: $s"
done

