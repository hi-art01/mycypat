R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'

log()  { echo -e "${G}[+]${N} $1"; echo "$(date +%T) [INFO] $1" >> "$LOG"; echo "$(date +%T) [SCORE-LOG] $1" >> "$SUMMARY"; }
warn() { echo -e "${Y}[! WARN]${N} $1"; echo "$(date +%T) [WARN] $1" >> "$LOG"; }
err()  { echo -e "${R}[ERROR]${N} $1"; echo "$(date +%T) [ERROR] $1" >> "$LOG"; }

ask() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    return 0
  fi
  if [[ "$default" == "Y" || "$default" == "y" ]]; then
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [Y/n]: " reply </dev/tty
    reply="${reply:-Y}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [y/N]: " reply </dev/tty
    reply="${reply:-N}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

ask_timed() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    if [[ "$default" == "N" || "$default" == "n" ]]; then return 1; fi
    return 0
  fi
  if [ "$FAST_MODE" = "yes" ]; then
    read -t 10 -rp "$(echo -e "${Y}? (Auto-${default} in 10s)${N}") ${prompt} [${default}]: " reply </dev/tty
    local res=$?
    if [ $res -ne 0 ]; then
      echo " [Timeout -> Auto ${default}]"
      reply="${default}"
    fi
    reply="${reply:-$default}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [${default}]: " reply </dev/tty
    reply="${reply:-$default}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

inlist() { [[ " $2 " == *" $1 "* ]]; }

# Format-aware set_kv using two-pass AWK
set_kv() {
  local key="$1" val="$2" file="$3" sep="${4:-=}"
  touch "$file"
  local mode
  mode=$(stat -c '%a' "$file" 2>/dev/null || echo "644")

  awk -v k="$key" -v v="$val" -v s="$sep" '
  function key_match(line, key_str,    clean_line, idx, rest) {
    clean_line = line
    sub(/^[ \t]*#?[ \t]*/, "", clean_line)
    idx = index(clean_line, key_str)
    if (idx != 1) return 0
    rest = substr(clean_line, length(key_str) + 1)
    if (rest == "" || rest ~ /^[ \t]*=/ || rest ~ /^[ \t]+/) return 1
    return 0
  }
  function is_commented(line) {
    return (line ~ /^[ \t]*#/)
  }
  BEGIN {
    target_line = 0
    uncommented_target = 0
    commented_target = 0
  }
  NR == FNR {
    if (key_match($0, k)) {
      if (!is_commented($0)) {
        if (uncommented_target == 0) uncommented_target = NR
      } else {
        if (commented_target == 0) commented_target = NR
      }
    }
    next
  }
  {
    if (uncommented_target > 0) target_line = uncommented_target
    else target_line = commented_target

    if (key_match($0, k)) {
      if (FNR == target_line) {
        if (s == " ") print k " " v
        else print k s v
        next
      } else {
        if (!is_commented($0)) {
          next
        } else {
          print $0
          next
        }
      }
    }
    print $0
  }
  END {
    if (target_line == 0) {
      if (s == " ") print k " " v
      else print k s v
    }
  }
  ' "$file" "$file" > "${file}.tmp" && cat "${file}.tmp" > "$file" && rm -f "${file}.tmp"
  chmod "$mode" "$file" 2>/dev/null || true
}

# Format-aware set_ini using literal section comparison
set_ini() {
  local section="$1" key="$2" val="$3" file="$4"
  touch "$file"
  local mode
  mode=$(stat -c '%a' "$file" 2>/dev/null || echo "644")

  awk -v sec="$section" -v k="$key" -v v="$val" '
  function trim(s) {
    sub(/^[ \t]+/, "", s)
    sub(/[ \t]+$/, "", s)
    return s
  }
  function normalize_key(str,    clean, idx, key_part) {
    clean = str
    sub(/^[ \t]*#?[ \t]*/, "", clean)
    idx = index(clean, "=")
    if (idx > 0) key_part = substr(clean, 1, idx - 1)
    else key_part = clean
    key_part = trim(key_part)
    gsub(/-/, "_", key_part)
    return tolower(key_part)
  }
  BEGIN {
    sec_hdr = "[" sec "]"
    norm_k = tolower(k)
    gsub(/-/, "_", norm_k)
    in_sec = 0
    sec_found = 0
    key_found = 0
    key_line = 0
    sec_hdr_line = 0
    line_no = 0
  }
  NR == FNR {
    line_no++
    t = trim($0)
    if (t ~ /^\[.*\]$/) {
      if (t == sec_hdr) {
        in_sec = 1
        sec_found = 1
        sec_hdr_line = line_no
      } else {
        in_sec = 0
      }
      next
    }
    if (in_sec && t != "" && t !~ /^#/) {
      if (normalize_key(t) == norm_k) {
        if (key_found == 0) {
          key_found = 1
          key_line = line_no
        }
      }
    }
    next
  }
  {
    current_line = FNR
    if (sec_found && key_found) {
      if (current_line == key_line) {
        print k " = " v
        next
      }
    } else if (sec_found && !key_found) {
      if (current_line == sec_hdr_line) {
        print $0
        print k " = " v
        next
      }
    }
    print $0
  }
  END {
    if (!sec_found) {
      if (NR > 0) print ""
      print sec_hdr
      print k " = " v
    }
  }
  ' "$file" "$file" > "${file}.tmp" && cat "${file}.tmp" > "$file" && rm -f "${file}.tmp"
  chmod "$mode" "$file" 2>/dev/null || true
}

