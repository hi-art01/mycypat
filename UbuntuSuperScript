#!/usr/bin/env bash
# =====================================================================
# UbuntuSuperScript - CyberPatriot Interactive Ubuntu Hardening Script
# Target OS: Ubuntu 20.04 / 22.04 / 24.04 LTS
# =====================================================================

[ "$EUID" -eq 0 ] || { echo "Error: Must be run with sudo/root permissions."; exit 1; }

export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"
LOG="/var/log/cp_ubuntu_hardening.log"
SUMMARY="/root/cp-notes/summary.txt"
mkdir -p /root/cp-notes

R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'

log()  { echo -e "${G}[+]${N} $1"; echo "$(date +%T) [INFO] $1" >> "$LOG"; echo "$(date +%T) [SCORE-LOG] $1" >> "$SUMMARY"; }
warn() { echo -e "${Y}[! WARN]${N} $1"; echo "$(date +%T) [WARN] $1" >> "$LOG"; }
err()  { echo -e "${R}[ERROR]${N} $1"; echo "$(date +%T) [ERROR] $1" >> "$LOG"; }

ask() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    return 0
  fi
  if [[ "$default" == "Y" || "$default" == "y" ]]; then
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [Y/n]: " reply </dev/tty
    reply="${reply:-Y}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [y/N]: " reply </dev/tty
    reply="${reply:-N}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

ask_timed() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    if [[ "$default" == "N" || "$default" == "n" ]]; then return 1; fi
    return 0
  fi
  if [ "$FAST_MODE" = "yes" ]; then
    read -t 10 -rp "$(echo -e "${Y}? (Auto-${default} in 10s)${N}") ${prompt} [${default}]: " reply </dev/tty
    local res=$?
    if [ $res -ne 0 ]; then
      echo " [Timeout -> Auto ${default}]"
      reply="${default}"
    fi
    reply="${reply:-$default}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [${default}]: " reply </dev/tty
    reply="${reply:-$default}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

inlist() { [[ " $2 " == *" $1 "* ]]; }

set_conf() {
  local key="$1" val="$2" file="$3" sep="${4:-=}"
  touch "$file"
  sed -i -E "/^[[:space:]]*#?[[:space:]]*${key//\//\\/}[[:space:]]*${sep}/d" "$file"
  echo "${key}${sep}${val}" >> "$file"
}

# ---------------------------------------------------------------------
# PARSE NON-INTERACTIVE COMMAND LINE FLAGS
# ---------------------------------------------------------------------
NON_INTERACTIVE="no"
CLI_USERS=""
CLI_ADMINS=""
CLI_KEEP=""
CLI_PORTS=""
CLI_PASSWORD=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes|--non-interactive) NON_INTERACTIVE="yes"; ALL_MODULES="yes"; FAST_MODE="yes"; shift ;;
    --users) CLI_USERS="$2"; shift 2 ;;
    --admins) CLI_ADMINS="$2"; shift 2 ;;
    --keep) CLI_KEEP="$2"; shift 2 ;;
    --ports) CLI_PORTS="$2"; shift 2 ;;
    --password) CLI_PASSWORD="$2"; shift 2 ;;
    *) shift ;;
  esac
done

echo -e "${G}====================================================${N}"
echo -e "${G}   CyberPatriot Ubuntu SuperScript (Interactive)    ${N}"
echo -e "${G}====================================================${N}"

# ---------------------------------------------------------------------
# FORENSICS GATE
# ---------------------------------------------------------------------
if [ "$NON_INTERACTIVE" != "yes" ]; then
  echo -e "\n${R}*** FORENSICS GATE ***${N}"
  echo "Before running remediation scripts, confirm you have completed all Forensics Questions!"
  while true; do
    read -rp "Have you answered and saved ALL Forensics Questions on Desktop? Type YES to continue: " fgated </dev/tty
    if [ "$fgated" = "YES" ] || [ "$fgated" = "yes" ]; then
      break
    fi
    echo "Please answer Forensics Questions first, then type YES."
  done
fi

# ---------------------------------------------------------------------
# READ-ONLY FORENSICS & SCENARIO ASSISTANT HELPER
# ---------------------------------------------------------------------
echo -e "\n${Y}=== Forensics & Evidence Helper (Read-Only Scan) ===${N}"
find /home /root /Desktop -name "Forensics*" -o -name "forensics*" 2>/dev/null | while read -r f; do
  echo -e "${G}[+] Found Forensics File:${N} $f"
  head -n 20 "$f" 2>/dev/null | sed 's/^/    /'
done
echo "Active Listening Network Services:"
ss -tulpn 2>/dev/null | grep LISTEN | sed 's/^/    /'

# ---------------------------------------------------------------------
# STEP 0: README SPECIFICS & CONFIGURATION PROMPTS
# ---------------------------------------------------------------------
echo -e "\n${Y}=== Step 0: README Details & Specifics Input ===${N}"

get_input() {
  local prompt="$1"
  local var_name="$2"
  local default_val="$3"
  local val=""
  if [ -n "${!var_name}" ]; then return; fi
  if [ "$NON_INTERACTIVE" = "yes" ]; then
    printf -v "$var_name" '%s' "$default_val"
    return
  fi
  while true; do
    read -rp "$prompt [Default: $default_val]: " val </dev/tty
    val="${val:-$default_val}"
    if [ -n "$val" ]; then
      printf -v "$var_name" '%s' "$val"
      break
    fi
  done
}

AUTHORIZED_USERS="$CLI_USERS"
ADMIN_USERS="$CLI_ADMINS"
KEEP_SERVICES="$CLI_KEEP"
UFW_ALLOW="$CLI_PORTS"
NEW_PASSWORD="$CLI_PASSWORD"

get_input "Enter ALL Authorized Users (space-separated, e.g. 'alice bob chard')" AUTHORIZED_USERS "${SUDO_USER:-ubuntu}"
get_input "Enter Authorized Administrators ONLY (space-separated, e.g. 'alice')" ADMIN_USERS "${SUDO_USER:-ubuntu}"
get_input "Enter Required Services/Packages to KEEP (space-separated, e.g. 'apache2 ssh')" KEEP_SERVICES "ssh"
get_input "Enter Additional Firewall Ports to ALLOW (space-separated, e.g. '80/tcp 443/tcp 22/tcp')" UFW_ALLOW "22/tcp"
get_input "Enter Default Password for Authorized Accounts (will not be logged)" NEW_PASSWORD "Cyb3r-Pat!2026-xQz"

if [ "$NON_INTERACTIVE" != "yes" ]; then
  ask "Is SSH explicitly required on this system?" "Y" && SSH_REQUIRED="yes" || SSH_REQUIRED="no"
  ask "Is Apache web server required?" "N" && REQ_APACHE="yes" || REQ_APACHE="no"
  ask "Is Nginx web server required?" "N" && REQ_NGINX="yes" || REQ_NGINX="no"
  ask "Is VSFTPD/FTP server required?" "N" && REQ_FTP="yes" || REQ_FTP="no"
  ask "Is Samba file sharing required?" "N" && REQ_SAMBA="yes" || REQ_SAMBA="no"
  ask "Is MySQL/MariaDB database required?" "N" && REQ_MYSQL="yes" || REQ_MYSQL="no"
  ask "Is PHP required?" "N" && REQ_PHP="yes" || REQ_PHP="no"

  read -rp "Enter any Users or Groups to CREATE if missing (e.g., 'user1:group1 user2'): " CREATE_ITEMS </dev/tty
  read -rp "Enter PROHIBITED Software/Packages from README (space-separated, e.g., 'nmap wireshark'): " EXTRA_PROHIBITED </dev/tty

  read -rp "Enter Password Policy Overrides (MinLength MaxDays MinDays WarnDays or press Enter for defaults 10 90 7 14): " PW_OVERRIDES </dev/tty
  if [ -n "$PW_OVERRIDES" ]; then
    read -r MIN_LEN MAX_DAYS MIN_DAYS WARN_DAYS <<< "$PW_OVERRIDES"
  fi
  MIN_LEN="${MIN_LEN:-10}"
  MAX_DAYS="${MAX_DAYS:-90}"
  MIN_DAYS="${MIN_DAYS:-7}"
  WARN_DAYS="${WARN_DAYS:-14}"

  read -rp "Run in FAST MODE (Bulk silent remediation without item prompts)? [Y/n]: " fm_in </dev/tty
  [[ "${fm_in:-Y}" =~ ^[Yy] ]] && FAST_MODE="yes" || FAST_MODE="no"

  read -rp "Run ALL modules automatically without section prompts? [y/N]: " all_in </dev/tty
  [[ "${all_in:-N}" =~ ^[Yy] ]] && ALL_MODULES="yes" || ALL_MODULES="no"
else
  SSH_REQUIRED="yes"
  FAST_MODE="yes"
  ALL_MODULES="yes"
  MIN_LEN=10; MAX_DAYS=90; MIN_DAYS=7; WARN_DAYS=14
  REQ_APACHE="no"; REQ_NGINX="no"; REQ_FTP="no"; REQ_SAMBA="no"; REQ_MYSQL="no"; REQ_PHP="no"
fi

# Honor required roles in KEEP_SERVICES
[ "$REQ_APACHE" = "yes" ] && KEEP_SERVICES="$KEEP_SERVICES apache2"
[ "$REQ_NGINX" = "yes" ] && KEEP_SERVICES="$KEEP_SERVICES nginx"
[ "$REQ_FTP" = "yes" ] && KEEP_SERVICES="$KEEP_SERVICES vsftpd proftpd"
[ "$REQ_SAMBA" = "yes" ] && KEEP_SERVICES="$KEEP_SERVICES samba smbd"
[ "$REQ_MYSQL" = "yes" ] && KEEP_SERVICES="$KEEP_SERVICES mysql mariadb"

# Process CREATE_ITEMS and add to AUTHORIZED_USERS / ADMIN_USERS before user deletion
for item in $CREATE_ITEMS; do
  if [[ "$item" == *":"* ]]; then
    u="${item%%:*}"; g="${item##*:}"
    getent group "$g" >/dev/null || { groupadd "$g" && log "Created group $g"; }
    id "$u" &>/dev/null || { useradd -m -s /bin/bash "$u" && log "Created user $u"; }
    usermod -aG "$g" "$u" && log "Added $u to group $g"
    AUTHORIZED_USERS="$AUTHORIZED_USERS $u"
    if [ "$g" = "sudo" ] || [ "$g" = "admin" ]; then
      ADMIN_USERS="$ADMIN_USERS $u"
    fi
  else
    id "$item" &>/dev/null || { useradd -m -s /bin/bash "$item" && log "Created user $item"; }
    AUTHORIZED_USERS="$AUTHORIZED_USERS $item"
  fi
done

# Display Summary Screen
echo -e "\n${G}====================================================${N}"
echo -e "${G}               STEP 0 SUMMARY REVIEW                ${N}"
echo -e "${G}====================================================${N}"
echo "Authorized Users     : $AUTHORIZED_USERS"
echo "Authorized Admins    : $ADMIN_USERS"
echo "Keep Services        : $KEEP_SERVICES"
echo "Allowed Firewall Ports: $UFW_ALLOW"
echo "SSH Required         : $SSH_REQUIRED"
echo "Password Policy      : MinLen=$MIN_LEN MaxDays=$MAX_DAYS MinDays=$MIN_DAYS WarnDays=$WARN_DAYS"
echo "Run Mode             : FAST_MODE=$FAST_MODE | ALL_MODULES=$ALL_MODULES"
echo -e "${G}====================================================${N}"

if [ "$NON_INTERACTIVE" != "yes" ]; then
  read -rp "Proceed with hardening using these parameters? [Y/n]: " proc_in </dev/tty
  if [[ ! "${proc_in:-Y}" =~ ^[Yy] ]]; then
    echo "Aborted by user."
    exit 0
  fi
fi

# Package and service lists
PROHIBITED_PKGS="aisleriot nmap zenmap john john-data hydra hydra-gtk ophcrack ophcrack-cli \
aircrack-ng wireshark wireshark-qt wireshark-common tshark nikto medusa ettercap-graphical \
ettercap-text-only fcrackzip sqlmap netcat netcat-traditional netcat-openbsd ncat $EXTRA_PROHIBITED"

BAD_SERVICE_PKGS="apache2* lighttpd nginx* php* mysql-server* mysql-client* mariadb-server* mariadb-client* postgresql* mongodb* vsftpd proftpd* pure-ftpd* tftpd-hpa ftpd samba samba-common* smbd nfs-kernel-server nfs-common rpcbind postfix exim4* sendmail* dovecot* bind9* isc-dhcp-server slapd squid xinetd openbsd-inetd telnetd inetutils-telnetd rsh-server rsh-client talk talkd snmpd cups* avahi-daemon bluez"

# ---------------------------------------------------------------------
# 1. USER & GROUP ACCOUNTS HARDENING
# ---------------------------------------------------------------------
sec_users() {
  echo -e "\n${Y}=== Module 1: User Accounts & Groups ===${N}"
  if ask "Audit and remediate user accounts and group memberships?"; then
    # Audit non-root UID 0 accounts
    awk -F: '$3==0 && $1!="root" {print $1}' /etc/passwd | while read -r u0; do
      warn "Found non-root UID 0 account: $u0!"
      if ask_timed "Lock and remove non-root UID 0 account $u0?"; then
        pkill -KILL -u "$u0" 2>/dev/null
        userdel -f -r "$u0" 2>/dev/null && log "Removed UID 0 account $u0"
      fi
    done

    # Remove unauthorized interactive users
    for u in $(awk -F: '(($3>=1000 && $3<65534)||($3==0 && $1!="root")) {print $1}' /etc/passwd); do
      if inlist "$u" "$AUTHORIZED_USERS" || inlist "$u" "$ADMIN_USERS"; then
        continue
      fi
      if [ "$u" == "${SUDO_USER:-}" ] || [ "$u" == "root" ]; then
        warn "Skipping deletion of running account '$u'."
        continue
      fi

      if [ "$FAST_MODE" = "yes" ]; then
        do_del="Y"
      else
        ask "Delete UNAUTHORIZED user '$u' and home directory?" "Y" && do_del="Y" || do_del="N"
      fi

      if [ "$do_del" = "Y" ]; then
        pkill -KILL -u "$u" 2>/dev/null
        userdel -r "$u" 2>/dev/null || userdel -f -r "$u" 2>/dev/null
        log "Removed unauthorized user $u"
      fi
    done

    # Enforce privileged group memberships across ALL target groups
    for g in sudo admin adm docker lxd disk shadow lpadmin; do
      getent group "$g" >/dev/null || continue
      for m in $(getent group "$g" | cut -d: -f4 | tr , ' '); do
        if ! inlist "$m" "$ADMIN_USERS"; then
          if [ "$m" == "${SUDO_USER:-}" ]; then
            warn "User '$m' is running this script. Retaining admin rights."
            continue
          fi
          gpasswd -d "$m" "$g" >/dev/null && log "Removed unauthorized $m from group $g"
        fi
      done
    done

    for a in $ADMIN_USERS; do
      id "$a" &>/dev/null && usermod -aG sudo "$a" && log "Ensured authorized admin $a is in sudo group"
    done

    # Lock root password and empty password accounts
    for u in $(awk -F: '$2=="" {print $1}' /etc/shadow 2>/dev/null); do
      passwd -l "$u" >/dev/null && log "Locked empty-password account $u"
    done
    passwd -l root >/dev/null 2>&1 && log "Locked direct root password login"
  fi
}

# ---------------------------------------------------------------------
# 2. PASSWORD SECURITY & AGING (ALL USERS)
# ---------------------------------------------------------------------
sec_passwords() {
  echo -e "\n${Y}=== Module 2: Password Security & Aging ===${N}"
  if ask "Reset passwords for authorized users and enforce password aging across ALL accounts?"; then
    for u in $AUTHORIZED_USERS $ADMIN_USERS; do
      if id "$u" &>/dev/null; then
        echo "$u:$NEW_PASSWORD" | chpasswd && log "Changed password for authorized user $u"
      fi
    done

    # Apply password aging to ALL local accounts with passwords
    for u in $(awk -F: '($3>=1000 && $3<65534) || $3==0 {print $1}' /etc/passwd); do
      chage -m "$MIN_DAYS" -M "$MAX_DAYS" -W "$WARN_DAYS" "$u" 2>/dev/null && log "Enforced password aging for $u (min:$MIN_DAYS max:$MAX_DAYS warn:$WARN_DAYS)"
    done

    echo -e "${Y}[!] A password reset was applied to your account. Use your new password for subsequent logins.${N}"
  fi
}

# ---------------------------------------------------------------------
# 3. PAM & LOGIN POLICY HARDENING
# ---------------------------------------------------------------------
sec_pam() {
  echo -e "\n${Y}=== Module 3: PAM Password Policy & Faillock Lockout ===${N}"
  if ask "Configure PAM password complexity, history=5, minlen=$MIN_LEN, and account lockout?"; then
    $APT install libpam-pwquality pam-wheel >/dev/null 2>&1

    # Check pam_faillock / pam_tally2 support
    has_faillock="no"
    if [ -f /lib/security/pam_faillock.so ] || [ -f /lib/x86_64-linux-gnu/security/pam_faillock.so ]; then
      has_faillock="yes"
    fi

    if [ "$has_faillock" = "yes" ]; then
      cat > /usr/share/pam-configs/faillock <<'EOF'
Name: Enforce failed login attempt counter
Default: no
Priority: 0
Auth-Type: Primary
Auth:
    [default=die] pam_faillock.so authfail deny=5 unlock_time=900 fail_interval=900
    sufficient pam_faillock.so authsucc deny=5 unlock_time=900 fail_interval=900
Account-Type: Primary
Account:
    required pam_faillock.so
EOF
      cat > /usr/share/pam-configs/faillock_notify <<'EOF'
Name: Notify on failed login attempts
Default: no
Priority: 1024
Auth-Type: Primary
Auth:
    requisite pam_faillock.so preauth silent deny=5 unlock_time=900 fail_interval=900
EOF
      pam-auth-update --package --enable faillock faillock_notify >/dev/null 2>&1 && log "Configured pam_faillock lockout"
    else
      warn "pam_faillock.so not present on this distribution release. Skipping faillock enablement."
    fi

    # Restrict su to wheel/sudo group
    if [ -f /etc/pam.d/su ]; then
      set_conf "auth" "required pam_wheel.so use_uid" /etc/pam.d/su " "
      log "Restricted su execution via pam_wheel"
    fi

    # Update login.defs
    set_conf "PASS_MAX_DAYS" "$MAX_DAYS" /etc/login.defs " "
    set_conf "PASS_MIN_DAYS" "$MIN_DAYS" /etc/login.defs " "
    set_conf "PASS_WARN_AGE" "$WARN_DAYS" /etc/login.defs " "
    set_conf "ENCRYPT_METHOD" "SHA512" /etc/login.defs " "
    set_conf "UMASK" "027" /etc/login.defs " "

    # Remove nullok
    cp /etc/pam.d/common-auth /etc/pam.d/common-auth.cpbak
    cp /etc/pam.d/common-password /etc/pam.d/common-password.cpbak
    sed -i -E 's/[[:space:]]+nullok(_secure)?//g' /etc/pam.d/common-auth /etc/pam.d/common-password /usr/share/pam-configs/unix 2>/dev/null

    # Password history and complexity
    touch /etc/security/opasswd; chmod 600 /etc/security/opasswd
    sed -i -E "/pam_unix\.so/ { s/[[:space:]]+(remember|minlen)=[0-9]+//g; s/$/ remember=5 minlen=$MIN_LEN/ }" /etc/pam.d/common-password

    # Configure pwquality
    for kv in "minlen=$MIN_LEN" "dcredit=-1" "ucredit=-1" "lcredit=-1" "ocredit=-1" "retry=3"; do
      k="${kv%%=*}"; v="${kv##*=}"
      set_conf "$k" "$v" /etc/security/pwquality.conf " = "
    done
    log "Enforced password complexity and password history (remember=5)"
  fi
}

# ---------------------------------------------------------------------
# 4. SUDOERS & PRIVILEGE ELEVATION HARDENING
# ---------------------------------------------------------------------
sec_sudoers() {
  echo -e "\n${Y}=== Module 4: Sudoers & Privilege Delegation Hardening ===${N}"
  if ask "Audit sudoers configuration for NOPASSWD and enforce sudo logging?"; then
    # Backup sudoers
    cp /etc/sudoers /etc/sudoers.cpbak

    # Create drop-in hardening rule
    cat > /etc/sudoers.d/99-cp-hardening <<'EOF'
Defaults use_pty
Defaults logfile="/var/log/sudo.log"
EOF
    chmod 440 /etc/sudoers.d/99-cp-hardening

    # Validate with visudo
    if visudo -c >/dev/null 2>&1; then
      log "Hardened sudoers options (use_pty, logfile) verified"
    else
      warn "visudo syntax check failed. Rolling back sudoers drop-in."
      rm -f /etc/sudoers.d/99-cp-hardening
    fi

    # Remove NOPASSWD entries if user confirms
    if grep -rE "NOPASSWD" /etc/sudoers /etc/sudoers.d/ 2>/dev/null; then
      if ask_timed "NOPASSWD entries found in sudoers! Strip NOPASSWD automatically?"; then
        sed -i 's/NOPASSWD://g' /etc/sudoers /etc/sudoers.d/* 2>/dev/null
        visudo -c >/dev/null 2>&1 || cp /etc/sudoers.cpbak /etc/sudoers
        log "Stripped NOPASSWD entries from sudoers"
      fi
    fi
  fi
}

# ---------------------------------------------------------------------
# 5. SYSCTL KERNEL NETWORK HARDENING (IPv4 + IPv6)
# ---------------------------------------------------------------------
sec_sysctl() {
  echo -e "\n${Y}=== Module 5: Sysctl Network Kernel Hardening ===${N}"
  if ask "Apply network security sysctl kernel parameters (IPv4 & IPv6)?"; then
    cat > /etc/sysctl.d/99-cp-hardening.conf <<'EOF'
net.ipv4.tcp_syncookies = 1
net.ipv4.ip_forward = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.tcp_max_syn_backlog = 2048
kernel.randomize_va_space = 2
fs.suid_dumpable = 0

# IPv6 Equivalents
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
EOF
    sysctl --system >/dev/null 2>&1
    log "Applied IPv4/IPv6 sysctl network security settings"
  fi
}

# ---------------------------------------------------------------------
# 6. SYSTEM FILE PERMISSIONS & HOME DIRECTORIES
# ---------------------------------------------------------------------
sec_perms() {
  echo -e "\n${Y}=== Module 6: File Permissions & Home Directory Hardening ===${N}"
  if ask "Secure critical file permissions (/etc/shadow, /etc/passwd, /etc/crontab, /home)?"; then
    chown root:shadow /etc/shadow /etc/gshadow 2>/dev/null; chmod 640 /etc/shadow /etc/gshadow
    chown root:root /etc/passwd /etc/group; chmod 644 /etc/passwd /etc/group
    chmod 440 /etc/sudoers 2>/dev/null; chmod 440 /etc/sudoers.d/* 2>/dev/null
    chmod 600 /etc/crontab /etc/ssh/sshd_config /boot/grub/grub.cfg 2>/dev/null
    chmod 700 /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly 2>/dev/null

    # Non-recursive 750 on user home directories
    for h in /home/*; do
      if [ -d "$h" ]; then
        chmod 750 "$h"
      fi
    done

    # Remove world-writable bit on files (excluding /proc, /sys, /dev)
    find / -xdev -type f -perm -0002 -not -path "/proc/*" -not -path "/sys/*" -not -path "/dev/*" -exec chmod o-w {} + 2>/dev/null
    find / -xdev -type d \( -perm -0002 -a ! -perm -1000 \) -exec chmod +t {} + 2>/dev/null

    # Audit SUID / SGID / Capabilities
    echo "--- SUID Files Report ---" >> "$LOG"
    find / -xdev -type f -perm -4000 2>/dev/null >> "$LOG"
    if command -v getcap >/dev/null 2>&1; then
      echo "--- Capabilities Report ---" >> "$LOG"
      getcap -r / 2>/dev/null >> "$LOG"
    fi

    log "Hardened critical permissions and set sticky bit on world-writable directories"
  fi
}

# ---------------------------------------------------------------------
# 7. SSH SERVER HARDENING & AUTHORIZED KEYS AUDIT
# ---------------------------------------------------------------------
sec_ssh() {
  echo -e "\n${Y}=== Module 7: SSH Server Hardening & Authorized Keys Audit ===${N}"
  if [ -f /etc/ssh/sshd_config ]; then
    if ask "Harden SSH configuration and audit user authorized_keys?"; then
      # Audit authorized_keys
      find /home /root -path "*/.ssh/authorized_keys" -type f 2>/dev/null | while read -r ak; do
        if [ "$SSH_REQUIRED" = "no" ]; then
          rm -f "$ak" && log "Deleted authorized_keys because SSH is not required: $ak"
        else
          warn "Found SSH Key File: $ak"
          ssh-keygen -lf "$ak" 2>/dev/null | sed 's/^/    /'
          if ask_timed "Remove SSH authorized_keys file $ak?" "N"; then
            rm -f "$ak" && log "Removed SSH authorized_keys file: $ak"
          else
            log "Kept authorized_keys file for authorized access: $ak"
          fi
        fi
      done

      # Backup sshd_config
      cp /etc/ssh/sshd_config /etc/ssh/sshd_config.cpbak

      # Re-write SSH options at top using temporary file to prevent line number shifts
      tmp_sshd=$(mktemp)
      {
        echo "PermitRootLogin no"
        echo "PermitEmptyPasswords no"
        echo "X11Forwarding no"
        echo "MaxAuthTries 4"
        echo "IgnoreRhosts yes"
        echo "LoginGraceTime 60"
        echo "ClientAliveInterval 300"
        echo "ClientAliveCountMax 0"
        [ -n "$AUTHORIZED_USERS" ] && [ "$SSH_REQUIRED" = "yes" ] && echo "AllowUsers $AUTHORIZED_USERS $ADMIN_USERS"
        grep -v -E "^[[:space:]]*#?[[:space:]]*(PermitRootLogin|PermitEmptyPasswords|X11Forwarding|MaxAuthTries|IgnoreRhosts|LoginGraceTime|ClientAliveInterval|ClientAliveCountMax|AllowUsers)[[:space:]]" /etc/ssh/sshd_config
      } > "$tmp_sshd"
      cp "$tmp_sshd" /etc/ssh/sshd_config
      rm -f "$tmp_sshd"

      # Validate syntax
      if sshd -t 2>/dev/null; then
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
        log "SSH hardened successfully"
      else
        warn "sshd -t syntax check failed! Rolling back to sshd_config backup."
        cp /etc/ssh/sshd_config.cpbak /etc/ssh/sshd_config
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
      fi
    fi
  fi
}

# ---------------------------------------------------------------------
# 8. PROHIBITED SOFTWARE & SERVICE PURGING
# ---------------------------------------------------------------------
sec_remove() {
  echo -e "\n${Y}=== Module 8: Prohibited Software & Service Removal ===${N}"
  if ask "Purge unauthorized server services and hacking tools?"; then
    apt-get update -qq
    for pkg in $BAD_SERVICE_PKGS $PROHIBITED_PKGS; do
      base_pkg="${pkg%%\*}"
      if inlist "$base_pkg" "$KEEP_SERVICES" || inlist "$pkg" "$KEEP_SERVICES"; then
        log "Skipping package $pkg (listed in KEEP_SERVICES)"
        continue
      fi
      dpkg-query -W -f='${Package}\n' "$pkg" 2>/dev/null | while read -r match_pkg; do
        if [ -n "$match_pkg" ]; then
          if inlist "$match_pkg" "$KEEP_SERVICES"; then
            log "Skipping installed package $match_pkg (listed in KEEP_SERVICES)"
            continue
          fi
          systemctl disable --now "$match_pkg" 2>/dev/null
          $APT purge "$match_pkg" >/dev/null 2>&1 && log "Purged prohibited package: $match_pkg"
        fi
      done
    done
    $APT autoremove >/dev/null 2>&1
  fi
}

# ---------------------------------------------------------------------
# 9. BACKDOOR & PERSISTENCE SWEEP (dpkg -S Netcat Purge + Startup + Cron)
# ---------------------------------------------------------------------
sec_backdoor() {
  echo -e "\n${Y}=== Module 9: Backdoor & Persistence Sweep ===${N}"
  if ask "Sweep running netcat/backdoors, cron/at jobs, startup scripts, and executables in /tmp?"; then
    # Purge netcat package via dpkg -S lookup
    nc_path=$(command -v nc 2>/dev/null || command -v netcat 2>/dev/null)
    if [ -n "$nc_path" ]; then
      real_nc=$(readlink -f "$nc_path")
      pkg_owner=$(dpkg -S "$real_nc" 2>/dev/null | cut -d: -f1)
      if [ -n "$pkg_owner" ]; then
        $APT purge "$pkg_owner" >/dev/null 2>&1 && log "Purged package owning netcat binary: $pkg_owner"
      fi
      rm -f "$real_nc" "$nc_path" 2>/dev/null
    fi

    # Kill netcat/socat processes
    for pid in $(ps -eo pid,comm | awk '$2 ~ /^(nc|ncat|netcat|socat)$/ {print $1}'); do
      kill -9 "$pid" 2>/dev/null && log "Killed backdoor PID $pid"
    done

    # Trace perl/python/ruby network listeners
    lsof -i -n -P 2>/dev/null | grep LISTEN | grep -E "perl|python|ruby" | while read -r line; do
      pid=$(echo "$line" | awk '{print $2}')
      pcmd=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null)
      warn "Found network-connected script interpreter PID $pid: $pcmd"
      if ask_timed "Kill network script listener PID $pid?"; then
        kill -9 "$pid" 2>/dev/null && log "Killed script backdoor PID $pid"
      fi
    done

    # Executables in /tmp, /var/tmp, /dev/shm
    find /tmp /var/tmp /dev/shm -type f -executable 2>/dev/null | while read -r bad_exe; do
      warn "Found executable in temp dir: $bad_exe"
      if ask_timed "Delete suspicious temp executable $bad_exe?"; then
        rm -f "$bad_exe" && log "Deleted temp executable: $bad_exe"
      fi
    done

    # Check /etc/rc.local and /etc/ld.so.preload
    if [ -f /etc/rc.local ]; then
      grep -q "exit 0" /etc/rc.local || echo "exit 0" > /etc/rc.local
    fi
    rm -f /etc/ld.so.preload 2>/dev/null

    # Check user crontabs
    for u in $(cut -d: -f1 /etc/passwd); do
      if crontab -l -u "$u" 2>/dev/null | grep -v '^#' | grep -q .; then
        warn "User $u has active crontab entries!"
        if ask_timed "Clear active crontab for user $u?"; then
          crontab -r -u "$u" 2>/dev/null && log "Cleared crontab for user $u"
        fi
      fi
    done

    # Clean cron and at allow/deny
    rm -f /etc/cron.deny /etc/at.deny
    echo "root" > /etc/cron.allow
    echo "root" > /etc/at.allow
    log "Restricted cron and at to root only"
  fi
}

