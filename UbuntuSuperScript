# ---------------------------------------------------------------------
# 15. AUTOMATIC HEALTH CHECK
# ---------------------------------------------------------------------
sec_health() {
  echo -e "\n${G}====================================================${N}"
  echo -e "${G}               AUTOMATIC HEALTH CHECK               ${N}"
  echo -e "${G}====================================================${N}"

  p_count=0; f_count=0; s_count=0
  check_pass() { echo -e "  [$G PASS $N] $1"; ((p_count++)); }
  check_fail() { echo -e "  [$R FAIL $N] $1"; ((f_count++)); }
  check_skip() { echo -e "  [$Y SKIP $N] $1"; ((s_count++)); }

  if visudo -c >/dev/null 2>&1; then check_pass "Sudoers syntax valid"; else check_fail "Sudoers syntax invalid"; fi

  for a in $ADMIN_USERS; do
    if id "$a" &>/dev/null; then
      if sudo -l -U "$a" 2>/dev/null | grep -q "ALL"; then
        check_pass "Sudo admin rights verified for $a"
      else
        check_fail "Sudo admin rights missing for $a"
      fi
    fi
  done

  for u in $AUTHORIZED_USERS; do
    if getent passwd "$u" >/dev/null; then
      if runuser -u "$u" -- true 2>/dev/null; then
        check_pass "Authorized user $u exists and session functional"
      else
        check_fail "Session execution failed for user $u"
      fi
    else
      check_fail "Authorized user $u does not exist in passwd"
    fi
  done

  if grep -q "pam_unix.so" /etc/pam.d/common-auth && grep -q "pam_unix.so" /etc/pam.d/common-password; then
    check_pass "PAM common-auth and common-password files parse correctly"
  else
    check_fail "PAM configuration missing pam_unix.so entries"
  fi

  if [ "$SSH_REQUIRED" = "yes" ]; then
    if sshd -t 2>/dev/null; then check_pass "SSHD configuration syntax valid"; else check_fail "SSHD configuration syntax invalid"; fi
    if ss -tlpn | grep -q ":22 "; then check_pass "SSH port 22 listening"; else check_fail "SSH port 22 not listening"; fi
  else
    check_skip "SSH service check skipped per configuration"
  fi

  if ufw status | grep -q "active"; then check_pass "UFW firewall active"; else check_fail "UFW firewall inactive"; fi

  for s in $KEEP_SERVICES; do
    real_unit="$s"
    [ "$s" = "samba" ] && real_unit="smbd"
    [ "$s" = "mysql" ] && real_unit="mysql"
    if systemctl is-active "$real_unit" >/dev/null 2>&1; then
      check_pass "Required service active: $real_unit"
    else
      if dpkg -l | grep -q "$s"; then
        check_fail "Required service inactive: $real_unit"
      else
        check_skip "Service not installed: $s"
      fi
    fi
  done

  echo -e "Health Check Summary: $G$p_count PASS$N | $R$f_count FAIL$N | $Y$s_count SKIP$N"
}

