#!/usr/bin/env bash
# =====================================================================
# UbuntuSuperScript - Interactive CyberPatriot Ubuntu Hardening Script
# =====================================================================
# Hardens Ubuntu systems quickly while prompting for README details and Y/N options.
# =====================================================================

[ "$EUID" -eq 0 ] || { echo "Error: Must be run with sudo/root permissions."; exit 1; }

export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"
LOG="/var/log/cp_ubuntu_hardening.log"

R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'

log()  { echo -e "${G}[+]${N} $1"; echo "$(date +%T) [INFO] $1" >> "$LOG"; }
warn() { echo -e "${Y}[! conservatism/warning]${N} $1"; echo "$(date +%T) [WARN] $1" >> "$LOG"; }
err()  { echo -e "${R}[ERROR]${N} $1"; echo "$(date +%T) [ERROR] $1" >> "$LOG"; }

ask() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [[ "$default" == "Y" ]]; then
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [Y/n]: " reply </dev/tty
    reply="${reply:-Y}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [y/N]: " reply </dev/tty
    reply="${reply:-N}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

inlist() { [[ " $2 " == *" $1 "* ]]; }

echo -e "${G}====================================================${N}"
echo -e "${G}   CyberPatriot Ubuntu SuperScript (Interactive)    ${N}"
echo -e "${G}====================================================${N}"

# ---------------------------------------------------------------------
# INITIAL README SPECIFICS PROMPTS
# ---------------------------------------------------------------------
echo -e "\n${Y}=== Step 0: README Details & Specifics ===${N}"

read -rp "Enter ALL Authorized Users (space-separated, e.g., 'user1 user2 admin1'): " AUTHORIZED_USERS
read -rp "Enter Authorized Administrators ONLY (space-separated, e.g., 'admin1'): " ADMIN_USERS
read -rp "Enter Required Services/Packages to KEEP (space-separated, e.g., 'apache2 vsftpd ssh'): " KEEP_SERVICES
read -rp "Enter Additional Firewall Ports to ALLOW (space-separated, e.g., '80/tcp 443/tcp 21/tcp'): " UFW_ALLOW
read -rp "Enter Default Password for Authorized Accounts [Default: Cyb3r-Pat!2026-xQz]: " NEW_PASSWORD
NEW_PASSWORD="${NEW_PASSWORD:-Cyb3r-Pat!2026-xQz}"

ask "Is SSH required on this system?" "Y" && SSH_REQUIRED="yes" || SSH_REQUIRED="no"

PROHIBITED_PKGS="aisleriot nmap zenmap john john-data hydra hydra-gtk ophcrack ophcrack-cli \
aircrack-ng wireshark wireshark-qt wireshark-common tshark nikto medusa ettercap-graphical \
ettercap-text-only fcrackzip sqlmap netcat netcat-traditional netcat-openbsd ncat"

BAD_SERVICE_PKGS="nginx vsftpd proftpd pure-ftpd tftpd-hpa telnetd inetutils-telnetd samba snmpd cups avahi-daemon"

# ---------------------------------------------------------------------
# 1. USER & GROUP HARDENING
# ---------------------------------------------------------------------
sec_users() {
  echo -e "\n${Y}=== 1. User & Group Hardening ===${N}"

  if ask "Audit and remove unauthorized users?"; then
    for u in $(awk -F: '(($3>=1000 && $3<65534)||($3==0 && $1!="root")) {print $1}' /etc/passwd); do
      if inlist "$u" "$AUTHORIZED_USERS"; then
        continue
      fi
      if [ "$u" == "${SUDO_USER:-}" ]; then
        warn "Skipping deletion of currently logged in user '$u'."
        continue
      fi
      if ask "Delete UNAUTHORIZED user '$u' and home directory?"; then
        pkill -KILL -u "$u" 2>/dev/null
        userdel -r "$u" 2>/dev/null || userdel -f -r "$u" 2>/dev/null
        log "Deleted unauthorized user $u"
      fi
    done
  fi

  if ask "Enforce Administrator group memberships (remove non-admins from sudo/admin groups)?"; then
    for g in sudo admin; do
      getent group "$g" >/dev/null || continue
      for m in $(getent group "$g" | cut -d: -f4 | tr , ' '); do
        if ! inlist "$m" "$ADMIN_USERS"; then
          if [ "$m" == "${SUDO_USER:-}" ] && ! inlist "$m" "$ADMIN_USERS"; then
            warn "User '$m' is running this script. Skipping removal from group '$g'."
            continue
          fi
          gpasswd -d "$m" "$g" >/dev/null && log "Removed $m from group $g"
        fi
      done
    done
    for a in $ADMIN_USERS; do
      id "$a" &>/dev/null && usermod -aG sudo "$a" && log "Ensured admin $a is in sudo group"
    done
  fi

  if ask "Lock root password login and accounts with empty passwords?"; then
    for u in $(awk -F: '$2=="" {print $1}' /etc/shadow 2>/dev/null); do
      passwd -l "$u" >/dev/null && log "Locked empty-password account $u"
    done
    passwd -l root >/dev/null 2>&1 && log "Locked direct root password login"
  fi
}

# ---------------------------------------------------------------------
# 2. PASSWORD SECURITY
# ---------------------------------------------------------------------
sec_passwords() {
  echo -e "\n${Y}=== 2. Password Security ===${N}"
  if ask "Set secure password ('$NEW_PASSWORD') and password aging for all authorized users?"; then
    for u in $AUTHORIZED_USERS; do
      if id "$u" &>/dev/null; then
        echo "$u:$NEW_PASSWORD" | chpasswd && log "Changed password for $u"
        chage -m 7 -M 90 -W 14 "$u" && log "Set password aging for $u (min:7 max:90 warn:14)"
      fi
    done
  fi
}

# ---------------------------------------------------------------------
# 3. PAM & LOGIN POLICY HARDENING
# ---------------------------------------------------------------------
sec_pam() {
  echo -e "\n${Y}=== 3. PAM & Login Policy Hardening ===${N}"
  if ask "Configure PAM password policy (complexity, history=5, minlen=10, faillock lockout)?"; then
    $APT install libpam-pwquality >/dev/null 2>&1

    # Faillock setup first (so pam-auth-update does not overwrite common-password edits)
    cat > /usr/share/pam-configs/faillock <<'EOF'
Name: Enforce failed login attempt counter
Default: no
Priority: 0
Auth-Type: Primary
Auth:
    [default=die] pam_faillock.so authfail deny=5 unlock_time=900 fail_interval=900
    sufficient pam_faillock.so authsucc deny=5 unlock_time=900 fail_interval=900
Account-Type: Primary
Account:
    required pam_faillock.so
EOF
    cat > /usr/share/pam-configs/faillock_notify <<'EOF'
Name: Notify on failed login attempts
Default: no
Priority: 1024
Auth-Type: Primary
Auth:
    requisite pam_faillock.so preauth silent deny=5 unlock_time=900 fail_interval=900
EOF
    pam-auth-update --package --enable faillock faillock_notify >/dev/null 2>&1

    # login.defs
    sed -i -E 's/^[[:space:]]*#?[[:space:]]*PASS_MAX_DAYS[[:space:]]+[0-9]+/PASS_MAX_DAYS   90/' /etc/login.defs
    sed -i -E 's/^[[:space:]]*#?[[:space:]]*PASS_MIN_DAYS[[:space:]]+[0-9]+/PASS_MIN_DAYS   7/' /etc/login.defs
    sed -i -E 's/^[[:space:]]*#?[[:space:]]*PASS_WARN_AGE[[:space:]]+[0-9]+/PASS_WARN_AGE   14/' /etc/login.defs

    # Remove nullok
    sed -i -E 's/[[:space:]]+nullok(_secure)?//g' /etc/pam.d/common-auth /etc/pam.d/common-password /usr/share/pam-configs/unix 2>/dev/null

    # Password history and complexity
    touch /etc/security/opasswd; chmod 600 /etc/security/opasswd
    sed -i -E '/pam_unix\.so/ { s/[[:space:]]+(remember|minlen)=[0-9]+//g; s/$/ remember=5 minlen=10/ }' /etc/pam.d/common-password

    # pwquality conf
    for kv in "minlen=10" "dcredit=-1" "ucredit=-1" "lcredit=-1" "ocredit=-1" "retry=3"; do
      k="${kv%%=*}"; v="${kv##*=}"
      sed -i -E "/^[[:space:]]*#?[[:space:]]*${k}[[:space:]]*=/d" /etc/security/pwquality.conf
      echo "${k} = ${v}" >> /etc/security/pwquality.conf
    done

    log "PAM password complexity, password history, and faillock lockout configured"
  fi
}

# ---------------------------------------------------------------------
# 4. SYSCTL & KERNEL HARDENING
# ---------------------------------------------------------------------
sec_sysctl() {
  echo -e "\n${Y}=== 4. Sysctl & Network Kernel Hardening ===${N}"
  if ask "Apply network security kernel parameters (sysctl)?"; then
    cat > /etc/sysctl.d/99-cp-hardening.conf <<'EOF'
net.ipv4.tcp_syncookies = 1
net.ipv4.ip_forward = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
EOF
    sysctl --system >/dev/null 2>&1
    log "Applied sysctl hardening rules"
  fi
}

# ---------------------------------------------------------------------
# 5. FILE PERMISSIONS
# ---------------------------------------------------------------------
sec_perms() {
  echo -e "\n${Y}=== 5. File Permissions Hardening ===${N}"
  if ask "Secure critical system file permissions (/etc/shadow, /etc/passwd, /etc/sudoers)?"; then
    chown root:shadow /etc/shadow /etc/gshadow 2>/dev/null; chmod 640 /etc/shadow /etc/gshadow
    chown root:root /etc/passwd /etc/group; chmod 644 /etc/passwd /etc/group
    chmod 440 /etc/sudoers 2>/dev/null; chmod 440 /etc/sudoers.d/* 2>/dev/null
    log "Secured file permissions for /etc/shadow, /etc/passwd, and /etc/sudoers"
  fi
}

# ---------------------------------------------------------------------
# 6. SSH HARDENING
# ---------------------------------------------------------------------
sec_ssh() {
  echo -e "\n${Y}=== 6. SSH Hardening ===${N}"
  if [ -f /etc/ssh/sshd_config ]; then
    if ask "Harden SSH server configuration (disable root login, empty passwords, X11 forwarding)?"; then
      for opt in "PermitRootLogin no" "PermitEmptyPasswords no" "X11Forwarding no" "MaxAuthTries 4" "IgnoreRhosts yes"; do
        k="${opt%% *}"
        sed -i -E "/^[[:space:]]*#?[[:space:]]*${k}[[:space:]]/d" /etc/ssh/sshd_config
        sed -i "1i $opt" /etc/ssh/sshd_config
      done
      if sshd -t 2>/dev/null; then
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
        log "SSH hardened and service restarted"
      else
        warn "SSH configuration syntax check failed. Reverting changes."
      fi
    fi
  fi
}

# ---------------------------------------------------------------------
# 7. REMOVE PROHIBITED SOFTWARE & SERVICES
# ---------------------------------------------------------------------
sec_remove() {
  echo -e "\n${Y}=== 7. Prohibited Software & Services Removal ===${N}"
  if ask "Purge unauthorized services and prohibited hacking tools?"; then
    apt-get update -qq
    for pkg in $BAD_SERVICE_PKGS $PROHIBITED_PKGS; do
      if inlist "$pkg" "$KEEP_SERVICES"; then
        log "Skipping package $pkg (listed in KEEP_SERVICES)"
        continue
      fi
      if dpkg -l | grep -E "^ii\s+$pkg" >/dev/null 2>&1; then
        systemctl disable --now "$pkg" 2>/dev/null
        $APT purge "$pkg" >/dev/null 2>&1 && log "Purged prohibited package: $pkg"
      fi
    done
    $APT autoremove >/dev/null 2>&1
  fi
}

# ---------------------------------------------------------------------
# 8. BACKDOOR & PERSISTENCE SWEEP
# ---------------------------------------------------------------------
sec_backdoor() {
  echo -e "\n${Y}=== 8. Backdoor & Persistence Sweep ===${N}"
  if ask "Sweep and kill active netcat/backdoor processes & persistence?"; then
    # Kill running netcat/socat
    for pid in $(ps -eo pid,comm | awk '$2 ~ /^(nc|ncat|netcat|socat)$/ {print $1}'); do
      kill -9 "$pid" 2>/dev/null && log "Killed backdoor PID $pid"
    done
    # Remove netcat binaries
    for b in nc ncat netcat nc.traditional nc.openbsd; do
      p=$(command -v "$b" 2>/dev/null)
      if [ -n "$p" ]; then
        rm -f "$p" 2>/dev/null && log "Deleted backdoor binary: $p"
      fi
    done
    # Clean cron deny/allow
    rm -f /etc/cron.deny /etc/at.deny
    echo "root" > /etc/cron.allow
    echo "root" > /etc/at.allow
    log "Restricted cron and at to root only"
  fi
}

# ---------------------------------------------------------------------
# 9. PROHIBITED MEDIA FILE REMOVAL
# ---------------------------------------------------------------------
sec_files() {
  echo -e "\n${Y}=== 9. Prohibited Media & File Removal ===${N}"
  if ask "Scan and delete prohibited media files (.mp3, .mp4, .avi, .mkv, .mov, .flac)?"; then
    find /home /root /tmp /var/tmp -type f \( -iname '*.mp3' -o -iname '*.mp4' -o -iname '*.m4a' -o -iname '*.flac' \
      -o -iname '*.avi' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.wmv' -o -iname '*.mpg' -o -iname '*.webm' \) -exec rm -f {} + 2>/dev/null
    log "Deleted prohibited media files in home and temp directories"
  fi
}

# ---------------------------------------------------------------------
# 10. UFW FIREWALL HARDENING
# ---------------------------------------------------------------------
sec_ufw() {
  echo -e "\n${Y}=== 10. UFW Firewall Hardening ===${N}"
  if ask "Enable UFW firewall with default deny inbound / allow outbound?"; then
    $APT install ufw >/dev/null 2>&1
    ufw default deny incoming >/dev/null
    ufw default allow outgoing >/dev/null
    [ "$SSH_REQUIRED" == "yes" ] && ufw allow 22/tcp >/dev/null
    for port in $UFW_ALLOW; do
      ufw allow "$port" >/dev/null && log "UFW allowed port/service: $port"
    done
    ufw --force enable >/dev/null
    systemctl enable ufw >/dev/null 2>&1
    log "UFW Firewall enabled and configured"
  fi
}

# ---------------------------------------------------------------------
# 11. AUDITD & DEFENSE TOOLS
# ---------------------------------------------------------------------
sec_audit() {
  echo -e "\n${Y}=== 11. Audit & Defense Tools ===${N}"
  if ask "Enable and start auditd, apparmor, and fail2ban?"; then
    $APT install auditd apparmor fail2ban >/dev/null 2>&1
    systemctl enable --now auditd apparmor fail2ban >/dev/null 2>&1
    auditctl -e 1 >/dev/null 2>&1
    log "Enabled auditd, apparmor, and fail2ban"
  fi
}

# ---------------------------------------------------------------------
# 12. AUTOMATIC UPDATES & SYSTEM UPGRADE
# ---------------------------------------------------------------------
sec_upgrade() {
  echo -e "\n${Y}=== 12. Updates & System Upgrade ===${N}"
  if ask "Enable automatic security updates and perform system package upgrades?"; then
    $APT install unattended-upgrades >/dev/null 2>&1
    cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APT::Periodic::Unattended-Upgrade "1";
EOF
    systemctl enable --now apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
    apt-get update -qq
    $APT dist-upgrade >/dev/null 2>&1 && log "Completed system distribution upgrade"
    if command -v snap >/dev/null; then snap refresh firefox thunderbird 2>/dev/null; fi
  fi
}

# Execution
sec_users
sec_passwords
sec_pam
sec_sysctl
sec_perms
sec_ssh
sec_remove
sec_backdoor
sec_files
sec_ufw
sec_audit
sec_upgrade

echo -e "\n${G}====================================================${N}"
echo -e "${G}   Ubuntu SuperScript Hardening Completed!          ${N}"
echo -e "${G}====================================================${N}"
echo -e "Hardening log saved to: $LOG"
