# ---------------------------------------------------------------------
# 12. AUDITD, APPARMOR, DISPLAY MANAGER & CORE DUMPS HARDENING
# ---------------------------------------------------------------------
sec_defenses() {
  echo -e "\n${Y}=== Module 12: Auditd, AppArmor, Display Manager & System Defenses ===${N}"
  if ask "Enable auditd, AppArmor, disable Guest/Auto-login, and disable core dumps?"; then
    $APT install auditd apparmor apparmor-utils fail2ban rsyslog >/dev/null 2>&1
    systemctl enable --now auditd apparmor fail2ban rsyslog >/dev/null 2>&1

    # AppArmor Enforce
    aa-enforce /etc/apparmor.d/* >/dev/null 2>&1

    # Configure auditd rules
    cat > /etc/audit/rules.d/cp.rules <<'EOF'
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
EOF
    augenrules --load >/dev/null 2>&1
    auditctl -e 1 >/dev/null 2>&1

    # Disable Core Dumps
    echo "* hard core 0" >> /etc/security/limits.conf
    set_conf "Storage" "none" /etc/systemd/coredump.conf

    # /etc/host.conf nospoof on
    if ! grep -q "nospoof on" /etc/host.conf 2>/dev/null; then
      echo "nospoof on" >> /etc/host.conf
      log "Enforced nospoof on in /etc/host.conf"
    fi

    # Disable Guest/Autologin in LightDM or GDM
    mkdir -p /etc/lightdm/lightdm.conf.d
    cat > /etc/lightdm/lightdm.conf.d/99-cp-hardening.conf <<'EOF'
[Seat:*]
allow-guest=false
autologin-user=
autologin-guest=false
EOF

    if [ -f /etc/gdm3/custom.conf ]; then
      sed -i -E 's/^[[:space:]]*AutomaticLoginEnable=.*/AutomaticLoginEnable=false/' /etc/gdm3/custom.conf
    fi

    # Disable USB storage / Firewire
    echo "install usb-storage /bin/true" > /etc/modprobe.d/disable-usb-storage.conf
    echo "blacklist firewire-core" > /etc/modprobe.d/firewire.conf
    echo "blacklist thunderbolt" >> /etc/modprobe.d/firewire.conf

    # Mask Ctrl-Alt-Del
    systemctl mask ctrl-alt-del.target >/dev/null 2>&1
    log "Auditd, AppArmor, Display Manager hardened, core dumps disabled"
  fi
}

# ---------------------------------------------------------------------
# 13. REQUIRED SERVICE HARDENING (Apache, Nginx, VSFTPD, Samba, MySQL, PHP)
# ---------------------------------------------------------------------
sec_services() {
  echo -e "\n${Y}=== Module 13: Required Service Hardening ===${N}"
  if ask "Harden required services (Apache, Nginx, VSFTPD, Samba, MySQL, PHP)?"; then
    # Apache
    if [ -f /etc/apache2/apache2.conf ]; then
      mkdir -p /etc/apache2/conf-available
      cat > /etc/apache2/conf-available/cp-hardening.conf <<'EOF'
ServerTokens Prod
ServerSignature Off
TraceEnable Off
EOF
      a2enconf cp-hardening >/dev/null 2>&1
      if apache2ctl configtest >/dev/null 2>&1; then
        systemctl restart apache2 2>/dev/null && log "Hardened Apache web server"
      else
        a2disconf cp-hardening >/dev/null 2>&1
      fi
    fi
    # Nginx
    if [ -f /etc/nginx/nginx.conf ]; then
      set_conf "server_tokens" "off;" /etc/nginx/nginx.conf
      systemctl restart nginx 2>/dev/null && log "Hardened Nginx web server"
    fi
    # VSFTPD
    if [ -f /etc/vsftpd.conf ]; then
      set_conf "anonymous_enable" "NO" /etc/vsftpd.conf
      set_conf "chroot_local_user" "YES" /etc/vsftpd.conf
      systemctl restart vsftpd 2>/dev/null && log "Hardened VSFTPD server"
    fi
    # Samba
    if [ -f /etc/samba/smb.conf ]; then
      set_conf "map to guest" "Bad User" /etc/samba/smb.conf
      systemctl restart smbd 2>/dev/null && log "Hardened Samba file server"
    fi
    # MySQL / MariaDB
    for myconf in /etc/mysql/mysql.conf.d/mysqld.cnf /etc/mysql/my.cnf; do
      if [ -f "$myconf" ]; then
        set_conf "bind-address" "127.0.0.1" "$myconf"
        set_conf "local-infile" "0" "$myconf"
        systemctl restart mysql 2>/dev/null || systemctl restart mariadb 2>/dev/null
        log "Hardened MySQL / MariaDB server"
        break
      fi
    done
    # PHP
    for phpini in /etc/php/*/*/php.ini; do
      if [ -f "$phpini" ]; then
        set_conf "expose_php" "Off" "$phpini"
        set_conf "display_errors" "Off" "$phpini"
        set_conf "disable_functions" "exec,passthru,shell_exec,system,proc_open,popen" "$phpini"
        log "Hardened PHP configuration in $phpini"
      fi
    done
  fi
}

