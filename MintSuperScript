sec_defenses() {
  echo -e "\n${Y}=== Module 12: Auditd, AppArmor, Display Manager & Mint Defenses ===${N}"
  if ask "Enable auditd, AppArmor, disable Guest/Auto-login, and configure Mint Update Manager?"; then
    $APT install auditd apparmor apparmor-utils fail2ban rsyslog >/dev/null 2>&1
    systemctl enable --now auditd apparmor fail2ban rsyslog >/dev/null 2>&1
    auditctl -e 1 >/dev/null 2>&1

    # /etc/host.conf nospoof on
    if ! grep -q "nospoof on" /etc/host.conf 2>/dev/null; then
      echo "nospoof on" >> /etc/host.conf
      log "Enforced nospoof on in /etc/host.conf"
    fi

    # Disable Guest/Autologin in LightDM or GDM
    if [ -f /etc/lightdm/lightdm.conf ]; then
      sed -i -E 's/^[[:space:]]*#?[[:space:]]*allow-guest=.*/allow-guest=false/' /etc/lightdm/lightdm.conf
      sed -i -E 's/^[[:space:]]*#?[[:space:]]*autologin-user=.*/#autologin-user=/' /etc/lightdm/lightdm.conf
    fi

    # Linux Mint Update Manager DConf auto-refresh setting
    if command -v dconf >/dev/null 2>&1; then
      dconf write /com/linuxmint/updates/auto-refresh true 2>/dev/null && log "Enabled Mint Update Manager auto-refresh"
    fi

    # Disable USB storage / Firewire
    echo "install usb-storage /bin/true" > /etc/modprobe.d/disable-usb-storage.conf
    echo "blacklist firewire-core" > /etc/modprobe.d/firewire.conf
    echo "blacklist thunderbolt" >> /etc/modprobe.d/firewire.conf

    # Mask Ctrl-Alt-Del
    systemctl mask ctrl-alt-del.target >/dev/null 2>&1
    log "Auditd, AppArmor, Display Manager hardened, USB storage disabled"
  fi
}

