Section "10. Automatic Health Check"

function Check-Health($name, $condition) {
    if ($condition) { Write-Host "  [ PASS ] $name" -ForegroundColor Green; Info "HEALTH PASS: $name" }
    else { Write-Host "  [ FAIL ] $name" -ForegroundColor Red; Warn "HEALTH FAIL: $name" }
}

Check-Health "Windows Firewall Service Running" ((Get-Service mpssvc).Status -eq 'Running')
Check-Health "Windows Defender Service Running" ((Get-Service WinDefend).Status -eq 'Running')

if ($RDPRequired) {
    Check-Health "RDP Listening Port 3389" ((Get-NetTCPConnection -LocalPort 3389 -State Listen -ErrorAction SilentlyContinue) -ne $null)
}

