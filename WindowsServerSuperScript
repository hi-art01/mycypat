#Requires -RunAsAdministrator
<#
.SYNOPSIS
  WindowsServerSuperScript - CyberPatriot Windows Server Hardening Script (Interactive)

.DESCRIPTION
  Interactively prompts for README specifics (Authorized Users, Authorized Admins, Domain Controller roles,
  Required Services, Allowed Ports, Default Password) and executes aggressive Y/N hardening
  modules for Windows Server 2016/2019/2022 (Domain Controller & Member Server).
#>

param(
    [switch]$Force,
    [string]$Users,
    [string]$Admins,
    [string]$Keep,
    [string]$Ports,
    [string]$Password
)

$ErrorActionPreference = 'Continue'
$LogFile = "C:\Windows\Temp\CP-WindowsServer-Hardening-Log.txt"
$SummaryFile = "C:\CP-Notes\summary.txt"
$Desktop = [Environment]::GetFolderPath('Desktop')
$EvFile  = Join-Path $Desktop 'CP-Evidence.txt'

if (-not (Test-Path "C:\CP-Notes")) { New-Item -Path "C:\CP-Notes" -ItemType Directory -Force | Out-Null }

function Section([string]$t) { Write-Host "`n=== $t ===" -ForegroundColor Cyan }
function Info([string]$t)    { Write-Host "[+] $t" -ForegroundColor Green; "$((Get-Date).ToString('T')) [INFO] $t" | Out-File $LogFile -Append; "$((Get-Date).ToString('T')) [SCORE-LOG] $t" | Out-File $SummaryFile -Append }
function Warn([string]$t)    { Write-Host "[!] $t" -ForegroundColor Yellow; "$((Get-Date).ToString('T')) [WARN] $t" | Out-File $LogFile -Append }

function Confirm-Prompt([string]$msg, [bool]$defaultYes=$true) {
    if ($script:ALL_MODULES) { return $true }
    $suffix = if ($defaultYes) { "[Y/n]" } else { "[y/N]" }
    $resp = Read-Host "$msg $suffix"
    if ([string]::IsNullOrWhiteSpace($resp)) { return $defaultYes }
    return ($resp -match '^(y|yes)$')
}

function Confirm-Timed([string]$msg, [int]$timeoutSec=10) {
    if ($script:ALL_MODULES) { return $true }
    if ($script:FAST_MODE) {
        Write-Host "$msg [Y/n] (Auto-Y in ${timeoutSec}s): " -NoNewline -ForegroundColor Yellow
        $resp = $null
        $startTime = Get-Date
        while (((Get-Date) - $startTime).TotalSeconds -lt $timeoutSec) {
            if ([Console]::KeyAvailable) {
                $resp = Read-Host
                break
            }
            Start-Sleep -Milliseconds 100
        }
        if ([string]::IsNullOrWhiteSpace($resp)) {
            Write-Host " [Timeout -> Auto Y]" -ForegroundColor Yellow
            return $true
        }
        return ($resp -match '^(y|yes)$')
    } else {
        return Confirm-Prompt $msg $true
    }
}

function Set-RegProperty {
    param([string]$Path, [string]$Name, $Value, [string]$Type='DWord')
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -Path $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Info "$Path\$Name = $Value"
    } catch { Warn "Failed setting $Path\$Name : $($_.Exception.Message)" }
}

function Set-RegMultiEmpty {
    param([string]$RegPath, [string]$Name)
    try {
        reg add $RegPath /v $Name /t REG_MULTI_SZ /d "" /f | Out-Null
        Info "$RegPath\$Name = (blank)"
    } catch { Warn "Failed MultiEmpty $RegPath\$Name" }
}

Write-Host "==========================================================" -ForegroundColor Green
Write-Host "   CyberPatriot Windows Server SuperScript (Interactive)  " -ForegroundColor Green
Write-Host "==========================================================" -ForegroundColor Green

# ---------------------------------------------------------------------
# FORENSICS GATE
# ---------------------------------------------------------------------
if (-not $Force) {
    Write-Host "`n*** FORENSICS GATE ***" -ForegroundColor Red
    Write-Host "Before running remediation scripts, confirm you have completed all Forensics Questions!" -ForegroundColor Yellow
    while ($true) {
        $fgated = Read-Host "Have you answered and saved ALL Forensics Questions on Desktop? Type YES to continue"
        if ($fgated -eq "YES" -or $fgated -eq "yes") { break }
        Write-Host "Please answer Forensics Questions first, then type YES." -ForegroundColor Red
    }
}

# ---------------------------------------------------------------------
# MODULE 0: FORENSICS EVIDENCE SNAPSHOT
# ---------------------------------------------------------------------
Section "0. Forensics Evidence Snapshot Generation"

function Add-Ev($title, $data) {
    "`n=== $title ===" | Out-File $EvFile -Append -Encoding utf8
    if ($null -ne $data) { ($data | Out-String -Width 250) | Out-File $EvFile -Append -Encoding utf8 }
}

try {
    "CP Evidence Collected $(Get-Date) on $env:COMPUTERNAME by $env:USERNAME" | Out-File $EvFile -Force -Encoding utf8
    Add-Ev 'OS' (Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,BuildNumber,InstallDate | Format-List)
    Add-Ev 'Local users' (Get-LocalUser | Select-Object Name,Enabled,SID,LastLogon,PasswordLastSet,PasswordRequired,PasswordExpires,Description | Format-Table -AutoSize)
    Add-Ev 'Shares' (Get-SmbShare | Select-Object Name,Path,Description | Format-Table -AutoSize)
    Add-Ev 'Listening ports' (Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Sort-Object LocalPort | ForEach-Object { [pscustomobject]@{Port=$_.LocalPort;Addr=$_.LocalAddress;PID=$_.OwningProcess;Proc=(Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).Name} } | Format-Table -AutoSize)
    Add-Ev 'Scheduled tasks' (Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -notmatch '\\Microsoft\\' } | Select-Object TaskPath,TaskName,State | Format-Table -AutoSize)
    Add-Ev 'Installed software' (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*' -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName } | Select-Object DisplayName,DisplayVersion,Publisher | Format-Table -AutoSize)
    Info "Complete evidence snapshot generated at: $EvFile"
} catch { Warn "Evidence collection encountered an issue: $($_.Exception.Message)" }

# ---------------------------------------------------------------------
# STEP 0: README DETAILS & PROMPTS
# ---------------------------------------------------------------------
Section "Step 0: README Details & Specifics Input"

$AuthUsersInput = if ($Users) { $Users } else { Read-Host "Enter ALL Authorized Domain/Local Users (comma-separated, e.g. 'alice,bob,carol')" }
$AuthorizedUsers = @($AuthUsersInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$AuthAdminsInput = if ($Admins) { $Admins } else { Read-Host "Enter Authorized Domain/Local Admins ONLY (comma-separated, e.g. 'alice,admin1')" }
$AuthorizedAdmins = @($AuthAdminsInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$KeepServicesInput = if ($Keep) { $Keep } else { Read-Host "Enter Required Services to KEEP (comma-separated, e.g. 'DNS,DHCP,W3SVC,Spooler')" }
$KeepServices = @($KeepServicesInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$NewPasswordInput = if ($Password) { $Password } else { Read-Host "Enter Default Password for Authorized Accounts [Default: Cyb3r-Pat!2026-xQz]" }
$NewPassword = if ([string]::IsNullOrWhiteSpace($NewPasswordInput)) { 'Cyb3r-Pat!2026-xQz' } else { $NewPasswordInput }

$autoDC = (Get-CimInstance Win32_ComputerSystem).DomainRole -ge 4
if (-not $Force) {
    $IsDomainController = Confirm-Prompt "Is this server an Active Directory Domain Controller? (Auto-detected: $autoDC)" $autoDC
    $RDPRequired = Confirm-Prompt "Is Remote Desktop (RDP) explicitly required by the README?" $false
    $IISRequired = Confirm-Prompt "Is Web Server (IIS) explicitly required by the README?" $false
    $FTPRequired = Confirm-Prompt "Is FTP Service explicitly required by the README?" $false

    $UsersToCreateInput = Read-Host "Enter Users/Groups to CREATE if missing (e.g., 'newuser1,newuser2')"
    $UsersToCreate = @($UsersToCreateInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

    $ProhibitedSoftInput = Read-Host "Enter PROHIBITED Software/Packages from README (comma-separated, e.g. 'Wireshark,Nmap')"
    $ExtraProhibited = @($ProhibitedSoftInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

    $script:FAST_MODE = Confirm-Prompt "Run in FAST MODE (Bulk silent remediation without per-item prompts)?" $true
    $script:ALL_MODULES = Confirm-Prompt "Run ALL modules automatically without section prompts?" $false
} else {
    $IsDomainController = $autoDC
    $RDPRequired = $false; $IISRequired = $false; $FTPRequired = $false
    $script:FAST_MODE = $true; $script:ALL_MODULES = $true
}

# Display Summary
Write-Host "`n====================================================" -ForegroundColor Green
Write-Host "               STEP 0 SUMMARY REVIEW                " -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host "Domain Controller    : $IsDomainController"
Write-Host "Authorized Users     : $($AuthorizedUsers -join ', ')"
Write-Host "Authorized Admins    : $($AuthorizedAdmins -join ', ')"
Write-Host "Keep Services        : $($KeepServices -join ', ')"
Write-Host "RDP Required         : $RDPRequired | IIS Required: $IISRequired | FTP Required: $FTPRequired"
Write-Host "Run Mode             : FAST_MODE=$script:FAST_MODE | ALL_MODULES=$script:ALL_MODULES"
Write-Host "====================================================" -ForegroundColor Green

if (-not $Force) {
    if (-not (Confirm-Prompt "Proceed with hardening using these parameters?")) {
        Write-Host "Aborted by user." -ForegroundColor Red
        exit
    }
}

$builtin = @('Administrator','Guest','krbtgt','DefaultAccount','WDAGUtilityAccount')
$current = $env:USERNAME
$sec = ConvertTo-SecureString $NewPassword -AsPlainText -Force

# ---------------------------------------------------------------------
# 1. ACCOUNTS & PRIVILEGES (LOCAL OR AD)
# ---------------------------------------------------------------------
Section "1. User Accounts & Group Memberships"

if ($IsDomainController -and (Get-Module -ListAvailable ActiveDirectory)) {
    Import-Module ActiveDirectory
    $dom = Get-ADDomain

    if (Confirm-Prompt "Harden Active Directory Default Domain Password Policy?") {
        Set-ADDefaultDomainPasswordPolicy -Identity $dom.DNSRoot -ComplexityEnabled $true -ReversibleEncryptionEnabled $false -MinPasswordLength 14 -PasswordHistoryCount 24 -MaxPasswordAge (New-TimeSpan -Days 90) -MinPasswordAge (New-TimeSpan -Days 1) -LockoutThreshold 10 -LockoutDuration (New-TimeSpan -Minutes 30) -LockoutObservationWindow (New-TimeSpan -Minutes 30)
        Info "Applied AD Default Domain Password Policy"
    }

    if (Confirm-Prompt "Remove unauthorized AD domain accounts?") {
        foreach ($u in Get-ADUser -Filter *) {
            $sam = $u.SamAccountName
            if ($sam -in $builtin -or $sam -eq $current) { continue }
            if ($sam -notin $AuthorizedUsers -and $sam -notin $AuthorizedAdmins) {
                if ($script:FAST_MODE -or (Confirm-Prompt "Remove unauthorized AD User '$sam'?")) {
                    Remove-ADUser -Identity $u -Confirm:$false -ErrorAction SilentlyContinue
                    Info "Removed AD User $sam"
                }
            }
        }
    }

    if (Confirm-Prompt "Enforce AD Domain Admins group membership?") {
        foreach ($m in Get-ADGroupMember -Identity 'Domain Admins') {
            $sam = $m.SamAccountName
            if ($sam -in $builtin -or $sam -eq $current) { continue }
            if ($sam -notin $AuthorizedAdmins) {
                if ($script:FAST_MODE -or (Confirm-Prompt "Remove '$sam' from Domain Admins?")) {
                    Remove-ADGroupMember -Identity 'Domain Admins' -Members $sam -Confirm:$false -ErrorAction SilentlyContinue
                    Info "Removed $sam from Domain Admins"
                }
            }
        }
    }

    if (Confirm-Prompt "Reset password for all authorized AD domain accounts to '$NewPassword'?") {
        foreach ($u in Get-ADUser -Filter * | Where-Object { $_.Enabled }) {
            $sam = $u.SamAccountName
            if ($sam -eq $current -or $sam -in $builtin) { continue }
            if ($sam -in $AuthorizedUsers -or $sam -in $AuthorizedAdmins) {
                Set-ADAccountPassword -Identity $u -Reset -NewPassword $sec -ErrorAction SilentlyContinue
                Set-ADUser -Identity $u -PasswordNeverExpires $false -ErrorAction SilentlyContinue
                Info "Updated password and expiration for AD account $sam"
            }
        }
        Warn "Password reset applied to authorized AD domain accounts. Use '$NewPassword' for subsequent logins."
    }
} else {
    # Non-DC Server
    if (Confirm-Prompt "Audit and remove unauthorized local users?") {
        foreach ($u in Get-LocalUser) {
            if ($u.Name -in $builtin -or $u.Name -eq $current) { continue }
            if ($u.Name -notin $AuthorizedUsers -and $u.Name -notin $AuthorizedAdmins) {
                if ($script:FAST_MODE -or (Confirm-Prompt "Remove UNAUTHORIZED user '$($u.Name)'?")) {
                    Remove-LocalUser -Name $u.Name -ErrorAction SilentlyContinue
                    Info "Removed user $($u.Name)"
                }
            }
        }
    }

    if (Confirm-Prompt "Reset password for all authorized local accounts to '$NewPassword'?") {
        foreach ($u in Get-LocalUser | Where-Object { $_.Enabled }) {
            if ($u.Name -in $AuthorizedUsers -or $u.Name -in $AuthorizedAdmins) {
                Set-LocalUser -Name $u.Name -Password $sec -PasswordNeverExpires $false -ErrorAction SilentlyContinue
                net user $u.Name /passwordreq:yes | Out-Null
                Info "Updated password and expiration for $($u.Name)"
            }
        }
        Warn "Password reset applied to authorized local accounts. Use '$NewPassword' for subsequent logins."
    }
}

