Section "4. Remote Desktop (RDP) Hardening"

$ts  = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
$rdp = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp'

if ($RDPRequired) {
    if (Confirm-Prompt "Configure required Remote Desktop (Enable RDP, NLA, SSL, and Firewall rules)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 0
        Set-RegProperty $rdp 'UserAuthentication' 1
        Set-RegProperty $rdp 'SecurityLayer' 2
        Enable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop enabled with NLA, SSL security, and firewall rules"
    }
} else {
    if (Confirm-Prompt "Disable Remote Desktop (RDP)?") {
        Set-RegProperty $ts 'fDenyTSConnections' 1
        Disable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
        Info "Remote Desktop disabled"
    }
}

