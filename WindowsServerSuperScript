#Requires -RunAsAdministrator
<#
.SYNOPSIS
  WindowsServerSuperScript - CyberPatriot Windows Server Hardening Script (Interactive)

.DESCRIPTION
  Interactively prompts for README specifics (Authorized Users, Authorized Admins, Domain Controller roles,
  Required Services, Allowed Ports, Default Password) and executes aggressive Y/N hardening
  modules for Windows Server 2016/2019/2022 (Domain Controller & Member Server).
#>

$ErrorActionPreference = 'Continue'
$LogFile = "C:\Windows\Temp\CP-WindowsServer-Hardening-Log.txt"

function Section([string]$t) { Write-Host "`n=== $t ===" -ForegroundColor Cyan }
function Info([string]$t)    { Write-Host "[+] $t" -ForegroundColor Green; "$((Get-Date).ToString('T')) [INFO] $t" | Out-File $LogFile -Append }
function Warn([string]$t)    { Write-Host "[!] $t" -ForegroundColor Yellow; "$((Get-Date).ToString('T')) [WARN] $t" | Out-File $LogFile -Append }

function Confirm-Prompt([string]$msg, [bool]$defaultYes=$true) {
    $suffix = if ($defaultYes) { "[Y/n]" } else { "[y/N]" }
    $resp = Read-Host "$msg $suffix"
    if ([string]::IsNullOrWhiteSpace($resp)) { return $defaultYes }
    return ($resp -match '^(y|yes)$')
}

function Set-RegProperty {
    param([string]$Path, [string]$Name, $Value, [string]$Type='DWord')
    try {
        if (-not (Test-Path $Path)) { New-Item -Path $Path -Force | Out-Null }
        New-ItemProperty -Path $Path -Name $Name -Value $Value -PropertyType $Type -Force | Out-Null
        Info "$Path\$Name = $Value"
    } catch { Warn "Failed setting $Path\$Name : $($_.Exception.Message)" }
}

Write-Host "==========================================================" -ForegroundColor Green
Write-Host "   CyberPatriot Windows Server SuperScript (Interactive)  " -ForegroundColor Green
Write-Host "==========================================================" -ForegroundColor Green

# ---------------------------------------------------------------------
# INITIAL README SPECIFICS PROMPTS
# ---------------------------------------------------------------------
Section "0. README Details & Specifics Input"

$AuthUsersInput = Read-Host "Enter ALL Authorized Domain/Local Users (comma-separated, e.g. 'alice,bob,carol')"
$AuthorizedUsers = @($AuthUsersInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$AuthAdminsInput = Read-Host "Enter Authorized Domain/Local Admins ONLY (comma-separated, e.g. 'alice,admin1')"
$AuthorizedAdmins = @($AuthAdminsInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$KeepServicesInput = Read-Host "Enter Required Services to KEEP (comma-separated, e.g. 'DNS,DHCP,W3SVC,Spooler')"
$KeepServices = @($KeepServicesInput -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })

$NewPasswordInput = Read-Host "Enter Default Password for Authorized Accounts [Default: Cyb3r-Pat!2026-xQz]"
$NewPassword = if ([string]::IsNullOrWhiteSpace($NewPasswordInput)) { 'Cyb3r-Pat!2026-xQz' } else { $NewPasswordInput }

$IsDomainController = (Get-CimInstance Win32_ComputerSystem).DomainRole -ge 4
if ($IsDomainController) {
    Info "Detected Active Directory Domain Controller Role."
}

$RDPRequired = Confirm-Prompt "Is Remote Desktop (RDP) explicitly required by the README?" $false
$IISRequired = Confirm-Prompt "Is Web Server (IIS) explicitly required by the README?" $false
$FTPRequired = Confirm-Prompt "Is FTP Service explicitly required by the README?" $false

# ---------------------------------------------------------------------
# 1. ACCOUNTS & PRIVILEGES (LOCAL OR AD)
# ---------------------------------------------------------------------
Section "1. User Accounts & Group Memberships"

$builtin = @('Administrator','Guest','krbtgt','DefaultAccount','WDAGUtilityAccount')
$current = $env:USERNAME
$sec = ConvertTo-SecureString $NewPassword -AsPlainText -Force

if ($IsDomainController -and (Get-Module -ListAvailable ActiveDirectory)) {
    Import-Module ActiveDirectory
    $dom = Get-ADDomain

    if (Confirm-Prompt "Harden Active Directory Default Domain Password Policy?") {
        Set-ADDefaultDomainPasswordPolicy -Identity $dom.DNSRoot -ComplexityEnabled $true -ReversibleEncryptionEnabled $false -MinPasswordLength 14 -PasswordHistoryCount 24 -MaxPasswordAge (New-TimeSpan -Days 90) -MinPasswordAge (New-TimeSpan -Days 1) -LockoutThreshold 10 -LockoutDuration (New-TimeSpan -Minutes 30) -LockoutObservationWindow (New-TimeSpan -Minutes 30)
        Info "Applied AD Default Domain Password Policy"
    }

    if (Confirm-Prompt "Remove unauthorized AD domain accounts?") {
        foreach ($u in Get-ADUser -Filter *) {
            $sam = $u.SamAccountName
            if ($sam -in $builtin -or $sam -eq $current) { continue }
            if ($sam -notin $AuthorizedUsers) {
                if (Confirm-Prompt "Remove unauthorized AD User '$sam'?") {
                    Remove-ADUser -Identity $u -Confirm:$false
                    Info "Removed AD User $sam"
                }
            }
        }
    }

    if (Confirm-Prompt "Enforce AD Domain Admins group membership?") {
        foreach ($m in Get-ADGroupMember -Identity 'Domain Admins') {
            $sam = $m.SamAccountName
            if ($sam -in $builtin -or $sam -eq $current) { continue }
            if ($sam -notin $AuthorizedAdmins) {
                if (Confirm-Prompt "Remove '$sam' from Domain Admins?") {
                    Remove-ADGroupMember -Identity 'Domain Admins' -Members $sam -Confirm:$false
                    Info "Removed $sam from Domain Admins"
                }
            }
        }
    }
} else {
    # Non-DC Server
    if (Confirm-Prompt "Audit and remove unauthorized local users?") {
        foreach ($u in Get-LocalUser) {
            if ($u.Name -in $builtin -or $u.Name -eq $current) { continue }
            if ($u.Name -notin $AuthorizedUsers) {
                if (Confirm-Prompt "Remove UNAUTHORIZED user '$($u.Name)'?") {
                    Remove-LocalUser -Name $u.Name
                    Info "Removed user $($u.Name)"
                }
            }
        }
    }
}

# ---------------------------------------------------------------------
# 2. LOCAL SECURITY & AUDITING
# ---------------------------------------------------------------------
Section "2. Security Policy & Full Audit Logging"

if (Confirm-Prompt "Enable full auditpol security logging?") {
    auditpol /set /category:* /success:enable /failure:enable | Out-Null
    Info "Enabled full auditpol logging"
}

if (Confirm-Prompt "Apply Windows Server Security Options & LSA/SMB Hardening?") {
    $lsa = 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa'
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    $lsv = 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'

    Set-RegProperty $lsa 'LimitBlankPasswordUse' 1
    Set-RegProperty $lsa 'restrictanonymous' 1
    Set-RegProperty $lsa 'restrictanonymoussam' 1
    Set-RegProperty $lsa 'everyoneincludesanonymous' 0
    Set-RegProperty $lsa 'NoLMHash' 1

    Set-RegProperty $sys 'EnableLUA' 1
    Set-RegProperty $sys 'ConsentPromptBehaviorAdmin' 2
    Set-RegProperty $sys 'ConsentPromptBehaviorUser' 0

    # SMB Hardening
    Set-RegProperty $lsv 'AutoDisconnect' 15
    Set-RegProperty $lsv 'RequireSecuritySignature' 1
    Set-RegProperty $lsv 'EnableSecuritySignature' 1
    Set-RegProperty $lsv 'DisableCompression' 1

    if ($IsDomainController) {
        Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\NTDS\Parameters' 'LDAPServerIntegrity' 2
        Set-RegProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\NTDS\Parameters' 'LdapEnforceChannelBinding' 1
        Info "LDAP Signing and Channel Binding enforced on Domain Controller"
    }
}

# ---------------------------------------------------------------------
# 3. DEFENDER & FIREWALL
# ---------------------------------------------------------------------
Section "3. Windows Defender & Firewall"

if (Confirm-Prompt "Enable Defender Real-Time Monitoring and Firewall on all profiles?") {
    Set-MpPreference -DisableRealtimeMonitoring $false -DisableBehaviorMonitoring $false -PUAProtection Enabled -ErrorAction SilentlyContinue
    Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True -DefaultInboundAction Block -DefaultOutboundAction Allow
    Info "Defender and Firewall configured"
}

# ---------------------------------------------------------------------
# 4. SERVER ROLES HARDENING (DNS, DHCP, IIS)
# ---------------------------------------------------------------------
Section "4. Server Roles & Web Hardening"

if (Get-Command Get-DnsServerZone -ErrorAction SilentlyContinue) {
    if (Confirm-Prompt "Harden DNS Server (disable zone transfers to arbitrary servers)?") {
        foreach ($z in Get-DnsServerZone -ErrorAction SilentlyContinue | Where-Object { -not $_.IsAutoCreated -and $_.ZoneType -eq 'Primary' }) {
            Set-DnsServerPrimaryZone -Name $z.ZoneName -SecureSecondaries NoTransfer -ErrorAction SilentlyContinue
            Info "Disabled zone transfers on DNS Zone $($z.ZoneName)"
        }
    }
}

if ((Get-Module -ListAvailable WebAdministration) -and ($IISRequired -or $FTPRequired)) {
    if (Confirm-Prompt "Harden IIS Web Server (disable directory browsing, remove server headers)?") {
        Import-Module WebAdministration -ErrorAction SilentlyContinue
        $apphost = 'MACHINE/WEBROOT/APPHOST'
        Set-WebConfigurationProperty -Filter '/system.webServer/directoryBrowse' -PSPath $apphost -Name enabled -Value $false
        Info "Disabled IIS Directory Browsing"
    }
}

# Disable SMBv1
if (Confirm-Prompt "Disable SMBv1 Server protocol?") {
    Set-SmbServerConfiguration -EnableSMB1Protocol $false -Force -Confirm:$false -ErrorAction SilentlyContinue
    Info "SMBv1 disabled"
}

# ---------------------------------------------------------------------
# 5. SERVER SPECIFIC CLEANUP (Disable custom C$ shares)
# ---------------------------------------------------------------------
Section "5. Server Shares & Media Cleanup"

if (Confirm-Prompt "Remove non-standard SMB shares (except ADMIN$, C$, IPC$) and WebCompanion?") {
    $okShares = @('ADMIN$','C$','IPC$')
    foreach ($sh in Get-SmbShare -ErrorAction SilentlyContinue) {
        if ($sh.Name -notin $okShares) {
            if (Confirm-Prompt "Remove SMB Share '$($sh.Name)'?") {
                Remove-SmbShare -Name $sh.Name -Force
                Info "Removed share $($sh.Name)"
            }
        }
    }
}

Write-Host "`n==========================================================" -ForegroundColor Green
Write-Host "   Windows Server SuperScript Hardening Completed!        " -ForegroundColor Green
Write-Host "==========================================================" -ForegroundColor Green
