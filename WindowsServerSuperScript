Section "5. Windows Defender & Firewall Settings"

if (Confirm-Prompt "Enable Windows Defender Real-Time Protection and Firewall on all profiles?") {
    Set-MpPreference -DisableRealtimeMonitoring $false -DisableBehaviorMonitoring $false -PUAProtection Enabled -ErrorAction SilentlyContinue
