#!/usr/bin/env bash
# =====================================================================
# DebianSuperScript - CyberPatriot Interactive Debian Hardening Script
# Target OS: Debian 11 (Bullseye) / 12 (Bookworm)
# =====================================================================

# Root check deferred

export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"
LOG="/var/log/cp_debian_hardening.log"
SUMMARY="/tmp/summary.txt"

R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; N=$'\033[0m'

log()  { echo -e "${G}[+]${N} $1"; { echo "$(date +%T) [INFO] $1" >> "$LOG"; } 2>/dev/null || true; { echo "$(date +%T) [SCORE-LOG] $1" >> "$SUMMARY"; } 2>/dev/null || true; }
warn() { echo -e "${Y}[! WARN]${N} $1"; { echo "$(date +%T) [WARN] $1" >> "$LOG"; } 2>/dev/null || true; }
err()  { echo -e "${R}[ERROR]${N} $1"; { echo "$(date +%T) [ERROR] $1" >> "$LOG"; } 2>/dev/null || true; }

refresh_apt_metadata() {
  local output rc
  if output=$(DEBIAN_FRONTEND=noninteractive apt-get update 2>&1); then
    printf '%s\n' "$output" >> "$LOG"
    if printf '%s\n' "$output" | grep -Eqi 'Failed to fetch|Some index files failed|NO_PUBKEY|not signed|signatures were invalid|does not have a Release file'; then
      warn "APT metadata refresh reported repository errors; see $LOG"
      printf '%s\n' "$output" | grep -Ei 'Failed to fetch|Some index files failed|NO_PUBKEY|not signed|signatures were invalid|does not have a Release file' | tail -n 10 | sed 's/^/    /'
      return 1
    fi
    return 0
  else
    rc=$?
    printf '%s\n' "$output" >> "$LOG"
    warn "APT metadata refresh failed (exit $rc); see $LOG"
    printf '%s\n' "$output" | tail -n 10 | sed 's/^/    /'
    return "$rc"
  fi
}

ask() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    return 0
  fi
  if [[ "$default" == "Y" || "$default" == "y" ]]; then
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [Y/n]: " reply </dev/tty
    reply="${reply:-Y}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [y/N]: " reply </dev/tty
    reply="${reply:-N}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

ask_account_action() {
  local prompt="$1"
  local reply
  read -rp "$(echo -e "${Y}?${N}") ${prompt} [y/N]: " reply </dev/tty
  [[ "$reply" =~ ^[Yy] ]]
}

ask_timed() {
  local prompt="$1"
  local default="${2:-Y}"
  local reply
  if [ "$ALL_MODULES" = "yes" ]; then
    if [[ "$default" == "N" || "$default" == "n" ]]; then return 1; fi
    return 0
  fi
  if [ "$FAST_MODE" = "yes" ]; then
    read -t 10 -rp "$(echo -e "${Y}? (Auto-${default} in 10s)${N}") ${prompt} [${default}]: " reply </dev/tty
    local res=$?
    if [ $res -ne 0 ]; then
      echo " [Timeout -> Auto ${default}]"
      reply="${default}"
    fi
    reply="${reply:-$default}"
  else
    read -rp "$(echo -e "${Y}?${N}") ${prompt} [${default}]: " reply </dev/tty
    reply="${reply:-$default}"
  fi
  [[ "$reply" =~ ^[Yy] ]]
}

inlist() {
  local target="$1"
  local item
  local clean_list
  clean_list=$(echo "$2" | tr ',;\t\r\n' '     ')
  for item in $clean_list; do
    if [ "$item" = "$target" ]; then
      return 0
    fi
  done
  return 1
}

is_kept_family() {
  local p="$1"
  # Protect VM guest tools, kernel images, and hypervisor drivers
  if [[ "$p" =~ ^(open-vm-tools|virtualbox-guest|qemu-guest|hyperv-|linux-image|linux-headers|systemd) ]]; then
    return 0
  fi
  for kf in $KEPT_FAMILIES $KEEP_SERVICES $REQUIRED_SOFTWARE; do
    # shellcheck disable=SC2053
    if [[ "$p" == $kf ]]; then return 0; fi
  done
  return 1
}

# Format-aware set_kv using two-pass AWK
set_kv() {
  local key="$1" val="$2" file="$3" sep="${4:-=}"
  touch "$file"
  local mode
  mode=$(stat -c '%a' "$file" 2>/dev/null || echo "644")

  SET_KV_KEY="$key" SET_KV_VAL="$val" SET_KV_SEP="$sep" awk '
  function key_match(line, key_str,    clean_line, idx, rest) {
    clean_line = line
    sub(/^[ \t]*#?[ \t]*/, "", clean_line)
    idx = index(clean_line, key_str)
    if (idx != 1) return 0
    rest = substr(clean_line, length(key_str) + 1)
    if (rest == "" || rest ~ /^[ \t]*=/ || rest ~ /^[ \t]+/) return 1
    return 0
  }
  function is_commented(line) {
    return (line ~ /^[ \t]*#/)
  }
  BEGIN {
    k = ENVIRON["SET_KV_KEY"]
    v = ENVIRON["SET_KV_VAL"]
    s = ENVIRON["SET_KV_SEP"]
    target_line = 0
    uncommented_target = 0
    commented_target = 0
  }
  NR == FNR {
    if (key_match($0, k)) {
      if (!is_commented($0)) {
        if (uncommented_target == 0) uncommented_target = NR
      } else {
        if (commented_target == 0) commented_target = NR
      }
    }
    next
  }
  {
    if (uncommented_target > 0) target_line = uncommented_target
    else target_line = commented_target

    if (key_match($0, k)) {
      if (FNR == target_line) {
        if (s == " ") print k " " v
        else print k s v
        next
      } else {
        if (!is_commented($0)) {
          next
        } else {
          print $0
          next
        }
      }
    }
    print $0
  }
  END {
    if (target_line == 0) {
      if (s == " ") print k " " v
      else print k s v
    }
  }
  ' "$file" "$file" > "${file}.tmp" && cat "${file}.tmp" > "$file" && rm -f "${file}.tmp"
  chmod "$mode" "$file" 2>/dev/null || true
}

# Format-aware set_ini using literal section comparison
set_ini() {
  local section="$1" key="$2" val="$3" file="$4"
  touch "$file"
  local mode
  mode=$(stat -c '%a' "$file" 2>/dev/null || echo "644")

  SET_INI_SEC="$section" SET_INI_KEY="$key" SET_INI_VAL="$val" awk '
  function trim(s) {
    sub(/^[ \t]+/, "", s)
    sub(/[ \t]+$/, "", s)
    return s
  }
  function normalize_key(str,    clean, idx, key_part) {
    clean = str
    sub(/^[ \t]*#?[ \t]*/, "", clean)
    idx = index(clean, "=")
    if (idx > 0) key_part = substr(clean, 1, idx - 1)
    else key_part = clean
    key_part = trim(key_part)
    gsub(/-/, "_", key_part)
    return tolower(key_part)
  }
  BEGIN {
    sec = ENVIRON["SET_INI_SEC"]
    k = ENVIRON["SET_INI_KEY"]
    v = ENVIRON["SET_INI_VAL"]
    sec_hdr = "[" sec "]"
    norm_k = tolower(k)
    gsub(/-/, "_", norm_k)
    in_sec = 0
    sec_found = 0
    key_found = 0
    key_line = 0
    sec_hdr_line = 0
    line_no = 0
  }
  NR == FNR {
    line_no++
    t = trim($0)
    if (t ~ /^\[.*\]$/) {
      if (t == sec_hdr) {
        in_sec = 1
        sec_found = 1
        sec_hdr_line = line_no
      } else {
        in_sec = 0
      }
      next
    }
    if (in_sec && t != "" && t !~ /^#/) {
      if (normalize_key(t) == norm_k) {
        if (key_found == 0) {
          key_found = 1
          key_line = line_no
        }
      }
    }
    next
  }
  {
    current_line = FNR
    if (sec_found && key_found) {
      if (current_line == key_line) {
        print k " = " v
        next
      }
    } else if (sec_found && !key_found) {
      if (current_line == sec_hdr_line) {
        print $0
        print k " = " v
        next
      }
    }
    print $0
  }
  END {
    if (!sec_found) {
      if (NR > 0) print ""
      print sec_hdr
      print k " = " v
    }
  }
  ' "$file" "$file" > "${file}.tmp" && cat "${file}.tmp" > "$file" && rm -f "${file}.tmp"
  chmod "$mode" "$file" 2>/dev/null || true
}

# ---------------------------------------------------------------------
# SUSPICIOUS PERSISTENCE TOKENIZER & CHECKER
# ---------------------------------------------------------------------
check_suspicious_file() {
  local target="$1"
  [ -f "$target" ] || return 1
  awk '
  function trim(s) {
    sub(/^[ \t]+/, "", s)
    sub(/[ \t]+$/, "", s)
    return s
  }
  function is_suspicious_line(line,    clean, stripped, n, segs, i, s, tokens, first_tok, exe) {
    clean = trim(line)
    if (clean == "" || clean ~ /^#/) return 0

    if (clean ~ /(^|[^a-zA-Z0-9_])(nc|ncat|netcat|socat)($|[^a-zA-Z0-9_])/) return 1
    if (clean ~ /bash[ \t]+-i|sh[ \t]+-i|\/dev\/(tcp|udp)\//) return 1
    if (clean ~ /base64[ \t]+-(d|-decode)/) return 1
    if (clean ~ /(curl|wget)[^|\n]+\|[ \t]*(sh|bash)/) return 1
    if (clean ~ /(^|[^a-zA-Z0-9_])(python|python3|perl|ruby|php)[ \t]+-[ec]($|[^a-zA-Z0-9_])/) return 1

    if (clean ~ /^[ \t]*Exec(Start|StartPre|StartPost|Reload)[ \t]*=/) {
      sub(/^[ \t]*Exec(Start|StartPre|StartPost|Reload)[ \t]*=[ \t]*/, "", clean)
      sub(/^[-@+!]+/, "", clean)
      sub(/^[ \t]+/, "", clean)
      if (clean ~ /^[\042\047]/) {
        sub(/^[\042\047]/, "", clean)
        sub(/[\042\047].*$/, "", clean)
        exe = clean
      } else {
        split(clean, tokens, /[ \t]+/)
        exe = tokens[1]
      }
      if (exe ~ /^(\/tmp|\/dev\/shm|\/var\/tmp)\//) return 1
      return 0
    }

    stripped = clean
    if (stripped ~ /^@[a-zA-Z]+[ \t]+/) {
      sub(/^@[a-zA-Z]+[ \t]+/, "", stripped)
      split(stripped, tokens, /[ \t]+/)
      if (tokens[1] ~ /^[a-zA-Z0-9_.-]+$/ && tokens[1] !~ /^\// && tokens[2] != "") {
        sub(/^[a-zA-Z0-9_.-]+[ \t]+/, "", stripped)
      }
    } else if (stripped ~ /^([0-9*,/-]+[ \t]+){5}/) {
      sub(/^([0-9*,/-]+[ \t]+){5}/, "", stripped)
      split(stripped, tokens, /[ \t]+/)
      if (tokens[1] ~ /^[a-zA-Z0-9_.-]+$/ && tokens[1] !~ /^\// && tokens[2] != "") {
        sub(/^[a-zA-Z0-9_.-]+[ \t]+/, "", stripped)
      }
    }

    gsub(/&&|\|\||;|\|/, "\n", stripped)
    n = split(stripped, segs, "\n")
    for (i = 1; i <= n; i++) {
      s = trim(segs[i])
      while (s ~ /^[A-Za-z_][A-Za-z0-9_]*=[^ \t]*[ \t]+/) {
        sub(/^[A-Za-z_][A-Za-z0-9_]*=[^ \t]*[ \t]+/, "", s)
      }
      while (s ~ /^(sudo|env|nohup)[ \t]+/) {
        sub(/^(sudo|env|nohup)[ \t]+/, "", s)
      }
      if (s ~ /^[\042\047]/) {
        sub(/^[\042\047]/, "", s)
        sub(/[\042\047].*$/, "", s)
        first_tok = s
      } else {
        split(s, tokens, /[ \t]+/)
        first_tok = tokens[1]
      }
      if (first_tok ~ /^(\/tmp|\/dev\/shm|\/var\/tmp)\//) return 1
    }
    return 0
  }
  {
    if (is_suspicious_line($0)) {
      found = 1
      exit 0
    }
  }
  END {
    if (found == 1) exit 0
    exit 1
  }
  ' "$target"
}

