get_input "Enter Required Services/Packages to KEEP (space-separated, e.g. 'apache2 ssh')" KEEP_SERVICES "ssh"
get_input "Enter Additional Firewall Ports to ALLOW (space-separated, e.g. '80/tcp 443/tcp 22/tcp')" UFW_ALLOW "22/tcp"

AUTHORIZED_USERS=$(echo "$AUTHORIZED_USERS" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
ADMIN_USERS=$(echo "$ADMIN_USERS" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
KEEP_SERVICES=$(echo "$KEEP_SERVICES" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
UFW_ALLOW=$(echo "$UFW_ALLOW" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ "$NON_INTERACTIVE" != "yes" ] && [ "$SELF_TEST" != "yes" ]; then
  ACCOUNT_REVIEW_INTERACTIVE="yes"
  if ask "Add user accounts to this system?" "N"; then
    read -rp "Enter usernames to add (space/comma-separated, e.g. 'user1 user2'): " CREATE_ITEMS </dev/tty
  else
    CREATE_ITEMS=""
  fi
  read -rp "Enter authorized accounts whose passwords should be reset (space/comma-separated, blank to skip): " PASSWORD_RESET_USERS </dev/tty
  read -rp "Enter required user:group memberships to add (space/comma-separated, blank if none): " GROUP_MEMBERSHIPS </dev/tty
  ask "Is SSH explicitly required on this system?" "Y" && SSH_REQUIRED="yes" || SSH_REQUIRED="no"
  ask "Is Apache web server required?" "N" && REQ_APACHE="yes" || REQ_APACHE="no"
  ask "Is Nginx web server required?" "N" && REQ_NGINX="yes" || REQ_NGINX="no"
  ask "Is VSFTPD/FTP server required?" "N" && REQ_FTP="yes" || REQ_FTP="no"
  ask "Is Samba file sharing required?" "N" && REQ_SAMBA="yes" || REQ_SAMBA="no"
  ask "Is MySQL/MariaDB database required?" "N" && REQ_MYSQL="yes" || REQ_MYSQL="no"
  ask "Is PHP required?" "N" && REQ_PHP="yes" || REQ_PHP="no"

  read -rp "Enter PROHIBITED Software/Packages from README (space-separated, e.g., 'nmap wireshark'): " EXTRA_PROHIBITED </dev/tty
  read -rp "Enter REQUIRED Software/Packages from README to preserve: " REQUIRED_SOFTWARE </dev/tty

  read -rp "Enter Password Policy Overrides (MinLength MaxDays MinDays WarnDays or press Enter for defaults 12 90 7 14): " PW_OVERRIDES </dev/tty
  if [ -n "$PW_OVERRIDES" ]; then
    read -r MIN_LEN MAX_DAYS MIN_DAYS WARN_DAYS <<< "$PW_OVERRIDES"
  fi
  MIN_LEN="${MIN_LEN:-12}"
  MAX_DAYS="${MAX_DAYS:-90}"
  MIN_DAYS="${MIN_DAYS:-7}"
  WARN_DAYS="${WARN_DAYS:-14}"

  read -rp "Use FAST MODE (timed section prompts; account decisions are still asked individually)? [Y/n]: " fm_in </dev/tty
  [[ "${fm_in:-Y}" =~ ^[Yy] ]] && FAST_MODE="yes" || FAST_MODE="no"

  read -rp "Run ALL modules automatically without section prompts? [y/N]: " all_in </dev/tty
  [[ "${all_in:-N}" =~ ^[Yy] ]] && ALL_MODULES="yes" || ALL_MODULES="no"
else
  if [ -z "$AUTHORIZED_USERS" ]; then
    AUTHORIZED_USERS=$(awk -F: '$3>=1000 && $3<65534 {print $1}' /etc/passwd | tr '\n' ' ')
  fi
  if [ -z "$ADMIN_USERS" ]; then
    ADMIN_USERS=$(for group in sudo admin; do getent group "$group" | cut -d: -f4 | tr ',' '\n'; done | sort -u | tr '\n' ' ')
  fi
  SSH_REQUIRED="yes"
  FAST_MODE="yes"
  ALL_MODULES="yes"
  MIN_LEN=12; MAX_DAYS=90; MIN_DAYS=7; WARN_DAYS=14
  REQ_APACHE="no"; REQ_NGINX="no"; REQ_FTP="no"; REQ_SAMBA="no"; REQ_MYSQL="no"; REQ_PHP="no"
  REQUIRED_SOFTWARE=""
  CREATE_ITEMS=""
fi

CREATE_ITEMS=$(echo "$CREATE_ITEMS" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
PASSWORD_RESET_USERS=$(echo "$PASSWORD_RESET_USERS" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
GROUP_MEMBERSHIPS=$(echo "$GROUP_MEMBERSHIPS" | tr ',;\t\r\n' '     ' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# Infer required services from KEEP_SERVICES and REQUIRED_SOFTWARE
for s in $KEEP_SERVICES $REQUIRED_SOFTWARE; do
  case "$s" in
    *apache*) REQ_APACHE="yes" ;;
    *nginx*)  REQ_NGINX="yes" ;;
    *vsftpd*|*ftp*) REQ_FTP="yes" ;;
    *samba*|*smb*)  REQ_SAMBA="yes" ;;
    *mysql*|*mariadb*) REQ_MYSQL="yes" ;;
    *php*)    REQ_PHP="yes" ;;
  esac
done

# Build Kept Family Map
KEPT_FAMILIES=""
[ "$REQ_APACHE" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES apache2* libapache2-mod-*"
[ "$REQ_NGINX" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES nginx*"
if [ "$REQ_PHP" = "yes" ]; then
  KEPT_FAMILIES="$KEPT_FAMILIES php*"
  [ "$REQ_APACHE" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES libapache2-mod-php*"
  [ "$REQ_NGINX" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES php*-fpm"
fi
[ "$REQ_FTP" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES vsftpd proftpd* pure-ftpd* ftpd tftpd-hpa"
[ "$REQ_SAMBA" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES samba* smbd smbclient libsmbclient* cifs-utils winbind"
[ "$REQ_MYSQL" = "yes" ] && KEPT_FAMILIES="$KEPT_FAMILIES mysql-* mariadb-* libmysqlclient* libmariadb* default-mysql-*"

# Display Summary Screen
echo -e "\n${G}====================================================${N}"
echo -e "${G}               STEP 0 SUMMARY REVIEW                ${N}"
echo -e "${G}====================================================${N}"
echo "Authorized Users     : $AUTHORIZED_USERS"
echo "Authorized Admins    : $ADMIN_USERS"
echo "Password Reset Users: ${PASSWORD_RESET_USERS:-none}"
echo "Requested Memberships: ${GROUP_MEMBERSHIPS:-none}"
echo "Kept Package Families: $KEPT_FAMILIES $KEEP_SERVICES $REQUIRED_SOFTWARE"
echo "Allowed Firewall Ports: $UFW_ALLOW"
echo "SSH Required         : $SSH_REQUIRED"
echo "Password Policy      : MinLen=$MIN_LEN MaxDays=$MAX_DAYS MinDays=$MIN_DAYS WarnDays=$WARN_DAYS"
echo "Run Mode             : FAST_MODE=$FAST_MODE | ALL_MODULES=$ALL_MODULES"
echo -e "${G}====================================================${N}"

if [ "$NON_INTERACTIVE" != "yes" ] && [ "$SELF_TEST" != "yes" ]; then
  read -rp "Proceed with hardening using these parameters? [Y/n]: " proc_in </dev/tty
  if [[ ! "${proc_in:-Y}" =~ ^[Yy] ]]; then
    echo "Aborted by user."
    exit 0
  fi
fi

# Package and service lists
PROHIBITED_PKGS="aisleriot nmap zenmap john john-data hydra hydra-gtk ophcrack ophcrack-cli \
aircrack-ng wireshark wireshark-qt wireshark-common tshark nikto medusa ettercap-graphical \
ettercap-text-only fcrackzip sqlmap netcat netcat-traditional netcat-openbsd ncat $EXTRA_PROHIBITED"

BAD_SERVICE_PKGS="apache2* lighttpd nginx* php* mysql-server* mysql-client* mariadb-server* mariadb-client* postgresql* mongodb* vsftpd proftpd* pure-ftpd* tftpd-hpa ftpd samba samba-common* smbd nfs-kernel-server nfs-common rpcbind postfix exim4* sendmail* dovecot* bind9* isc-dhcp-server slapd squid xinetd openbsd-inetd telnetd inetutils-telnetd rsh-server rsh-client talk talkd snmpd cups* avahi-daemon bluez"
read -r -a PURGE_PATTERNS <<< "$PROHIBITED_PKGS $BAD_SERVICE_PKGS"

# ---------------------------------------------------------------------
# SELF-TEST FLAG IMPLEMENTATION
# ---------------------------------------------------------------------
if [ "$SELF_TEST" = "yes" ]; then
  echo -e "\n${G}=== RUNNING SCRIPT SELF-TEST (NO CHANGES MADE) ===${N}"
  echo "1. Parsed Kept Family Map:"
  echo "   $KEPT_FAMILIES $KEEP_SERVICES $REQUIRED_SOFTWARE"
  echo -e "\n2. Evaluating Package Purge Candidates:"

  is_kept_pkg() {
    local p="$1"
    for kf in $KEPT_FAMILIES $KEEP_SERVICES $REQUIRED_SOFTWARE; do
      # shellcheck disable=SC2053
      if [[ "$p" == $kf ]]; then return 0; fi
    done
    return 1
  }

  for candidate_pattern in "${PURGE_PATTERNS[@]}"; do
    dpkg-query -W -f='${Package}\n' "$candidate_pattern" 2>/dev/null | while read -r inst_p; do
      if [ -n "$inst_p" ]; then
        if is_kept_pkg "$inst_p"; then
          echo "   [SKIP KEPT] $inst_p matches kept family/services"
        else
          sim_out=$(apt-get -s purge "$inst_p" 2>/dev/null)
          removed_deps=$(echo "$sim_out" | grep -E "^Remv " | awk '{print $2}')
          blocked="no"
          for dep in $removed_deps; do
            if is_kept_pkg "$dep" || [[ "$dep" =~ ^(ssh|openssh|ufw|sudo|apparmor|auditd|libpam-|network-manager|debian-|task-|open-vm-tools|virtualbox-guest|qemu-guest|hyperv-|linux-image|systemd|lightdm|gdm3) ]]; then
              echo "   [SKIP GUARD] $inst_p (Purge would remove protected dependency $dep)"
              blocked="yes"
              break
            fi
          done
          if [ "$blocked" = "no" ]; then
            echo "   [WILL PURGE] $inst_p"
          fi
        fi
      fi
    done
  done

  echo -e "\n3. Target Configuration Files & Operations to be Hardened:"
  echo "   - /etc/login.defs, /etc/security/pwquality.conf, /etc/pam.d/su"
  echo "   - /etc/sudoers, /etc/sudoers.d/*"
  echo "   - /etc/sysctl.d/99-cp-hardening.conf, /etc/sysctl.conf"
  echo "   - /etc/ssh/sshd_config, /etc/ssh/sshd_config.d/*"
  echo "   - /etc/apt/sources.list, /etc/apt/sources.list.d/*"
  echo "   - /etc/hosts, /etc/resolv.conf, /etc/systemd/resolved.conf"
  echo "   - /boot/grub/grub.cfg"
  echo "   - Service Hardening: Apache, vsftpd, Samba, MySQL/MariaDB, PHP, Nginx (when required)"
  echo "   - System Defenses: auditd rules, AppArmor enforce, fail2ban, rsyslog, LightDM/GDM guest/autologin off, kernel module blacklists, coredumps off"
  echo "   - Package Upgrades: apt-get update & upgrade, dist-upgrade, guarded autoremove, unattended-upgrades"
  echo "   - Post-Run Health Check & System Verification Report"
  echo -e "\nSelf-test complete. Exiting without making modifications."
  log "skipped: no network/changes in self-test"
  exit 0
fi

# ---------------------------------------------------------------------
# 1. USER & GROUP ACCOUNTS HARDENING & CREATE_ITEMS
# ---------------------------------------------------------------------
sec_users() {
  echo -e "\n${Y}=== Module 1: User Accounts & Groups ===${N}"
  if ask "Audit and remediate user accounts and group memberships?"; then
    local added_users="" user_groups
    # Process CREATE_ITEMS after Step 0 confirmation
    for item in $CREATE_ITEMS; do
      local u_name="${item%%:*}"
      local created_user="no"
      if [[ "$item" == *":"* ]]; then
        u="${item%%:*}"; g="${item##*:}"
        getent group "$g" >/dev/null || { groupadd "$g" && log "Created group $g"; }
        if ! id "$u" &>/dev/null; then
          useradd -m -s /bin/bash "$u" && log "Created user $u" && created_user="yes"
        fi
        usermod -aG "$g" "$u" && log "Added $u to group $g"
        AUTHORIZED_USERS="$AUTHORIZED_USERS $u"
        if [ "$g" = "sudo" ] || [ "$g" = "admin" ]; then
          ADMIN_USERS="$ADMIN_USERS $u"
        fi
      else
        if ! id "$item" &>/dev/null; then
          useradd -m -s /bin/bash "$item" && log "Created user $item" && created_user="yes"
        fi
        AUTHORIZED_USERS="$AUTHORIZED_USERS $item"
      fi
      added_users="$added_users $u_name"
      if [ "$created_user" = "yes" ] && [ -n "$NEW_PASSWORD" ]; then
        printf '%s:%s\n' "$u_name" "$NEW_PASSWORD" | chpasswd 2>/dev/null
      elif [ "$created_user" = "yes" ] && [ "$NON_INTERACTIVE" != "yes" ]; then
        if ! passwd "$u_name"; then
          passwd -l "$u_name" >/dev/null 2>&1
          warn "Could not set a password for new account $u_name; password login is locked"
        fi
      elif [ "$created_user" = "yes" ]; then
        passwd -l "$u_name" >/dev/null 2>&1
        warn "Created account $u_name with password login locked; set its password before use"
      fi
      chage -m "$MIN_DAYS" -M "$MAX_DAYS" -W "$WARN_DAYS" "$u_name" 2>/dev/null
    done

    for membership in $GROUP_MEMBERSHIPS; do
      if [[ "$membership" != *":"* ]]; then
        warn "Skipping invalid membership '$membership' (expected user:group)"
        continue
      fi
      local member="${membership%%:*}"
      local group="${membership#*:}"
      if ! id "$member" >/dev/null 2>&1 || [ -z "$group" ]; then
        warn "Skipping membership '$membership' because the user or group is invalid"
        continue
      fi
      if ! getent group "$group" >/dev/null; then
        warn "Skipping membership '$membership' because group '$group' does not exist"
        continue
      fi
      if usermod -aG "$group" "$member"; then
        log "Added requested group membership: $member:$group"
      else
        warn "Failed to add requested group membership: $member:$group"
      fi
    done

    local demote_users=""
    if [ "$ACCOUNT_REVIEW_INTERACTIVE" = "yes" ]; then
      AUTHORIZED_USERS=""
      ADMIN_USERS=""
      while read -r uid u; do
        [ -n "$u" ] || continue
        [ "$u" = "root" ] && continue
        if inlist "$u" "$added_users"; then
          AUTHORIZED_USERS="$AUTHORIZED_USERS $u"
          user_groups=$(id -nG "$u" 2>/dev/null)
          [[ " $user_groups " == *" sudo "* || " $user_groups " == *" admin "* ]] && ADMIN_USERS="$ADMIN_USERS $u"
          continue
        fi
        if [ "$u" = "${SUDO_USER:-}" ]; then
          AUTHORIZED_USERS="$AUTHORIZED_USERS $u"
          ADMIN_USERS="$ADMIN_USERS $u"
          warn "Retaining the account currently running this script: $u"
          continue
        fi

        user_groups=$(id -nG "$u" 2>/dev/null)
        local is_admin="no"
        [[ " $user_groups " == *" sudo "* || " $user_groups " == *" admin "* || "$uid" -eq 0 ]] && is_admin="yes"
        local account_type="user"
        [ "$is_admin" = "yes" ] && account_type="admin"
        if ask_account_action "Delete $account_type account '$u' (home directory will be preserved)?"; then
          pkill -KILL -u "$u" 2>/dev/null
          if userdel "$u" 2>/dev/null || userdel -f "$u" 2>/dev/null; then
            log "Removed $account_type account $u (home directory preserved)"
            continue
          fi
          warn "Failed to remove account $u; retaining it"
        fi

        AUTHORIZED_USERS="$AUTHORIZED_USERS $u"
        if [ "$uid" -eq 0 ]; then
          ADMIN_USERS="$ADMIN_USERS $u"
          warn "Retaining non-root UID 0 account '$u' as an administrator; its UID cannot be safely demoted automatically"
          continue
        fi
        if [ "$is_admin" = "yes" ]; then
          if ask_account_action "Remove administrator privileges from '$u'?"; then
            demote_users="$demote_users $u"
          else
            ADMIN_USERS="$ADMIN_USERS $u"
          fi
        fi
      done < <(awk -F: '($3>=1000 && $3<65534)||($3==0 && $1!="root") {print $3, $1}' /etc/passwd)
    else
      # Non-interactive pruning is only based on an explicitly supplied --users list.
      if [ -n "$CLI_USERS" ]; then
        for u in $(awk -F: '(($3>=1000 && $3<65534)||($3==0 && $1!="root")) {print $1}' /etc/passwd); do
          if inlist "$u" "$AUTHORIZED_USERS" || inlist "$u" "$ADMIN_USERS"; then continue; fi
          [ "$u" = "${SUDO_USER:-}" ] && { warn "Skipping deletion of the active account '$u'"; continue; }
          pkill -KILL -u "$u" 2>/dev/null
          if userdel "$u" 2>/dev/null || userdel -f "$u" 2>/dev/null; then
            log "Removed unauthorized user account $u (home directory preserved)"
          else
            warn "Failed to remove unauthorized account $u"
          fi
        done
      else
        warn "Skipped account deletion in non-interactive mode; pass --users to define the approved accounts"
      fi
    fi

    # Enforce privileged group memberships across ALL target groups
    for g in sudo admin adm docker lxd disk shadow lpadmin; do
      getent group "$g" >/dev/null || continue
      for m in $(getent group "$g" | cut -d: -f4 | tr , ' '); do
        if inlist "$m" "$demote_users"; then
          if gpasswd -d "$m" "$g" >/dev/null; then
            log "Removed administrator privilege for $m from group $g"
          else
            warn "Failed to remove $m from privileged group $g"
          fi
        elif [ "$ACCOUNT_REVIEW_INTERACTIVE" = "yes" ] && { [ "$g" != "sudo" ] && [ "$g" != "admin" ]; }; then
          if ask_account_action "Remove '$m' from privileged group '$g'?"; then
            if gpasswd -d "$m" "$g" >/dev/null; then
              log "Removed $m from privileged group $g"
            else
              warn "Failed to remove $m from privileged group $g"
            fi
          fi
        elif ! inlist "$m" "$ADMIN_USERS" && [ "$ACCOUNT_REVIEW_INTERACTIVE" != "yes" ]; then
          if [ "$m" == "${SUDO_USER:-}" ]; then
            warn "User '$m' is running this script. Retaining admin rights."
            continue
          fi
          gpasswd -d "$m" "$g" >/dev/null && log "Removed unauthorized $m from group $g"
        fi
      done
    done

    if [ "$ACCOUNT_REVIEW_INTERACTIVE" != "yes" ]; then
      for a in $ADMIN_USERS; do
        id "$a" &>/dev/null && usermod -aG sudo "$a" && log "Ensured authorized admin $a is in sudo group"
      done
    fi

    # Lock root password and empty password accounts
    for u in $(awk -F: '$2=="" {print $1}' /etc/shadow 2>/dev/null); do
      passwd -l "$u" >/dev/null && log "Locked empty-password account $u"
    done
    local non_root_admin="no"
    for adm in $ADMIN_USERS; do
      if [ "$adm" != "root" ]; then non_root_admin="yes"; break; fi
    done
    if [ "$non_root_admin" = "yes" ] && [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
      passwd -l root >/dev/null 2>&1 && log "Locked direct root password login"
    else
      warn "Retained root password login because root is the active administrative account"
    fi
  fi
}

# ---------------------------------------------------------------------
# 2. PASSWORD SECURITY & AGING (ALL USERS)
# ---------------------------------------------------------------------
sec_passwords() {
  echo -e "\n${Y}=== Module 2: Password Security & Aging ===${N}"
  if ask "Reset passwords for the selected accounts and enforce password aging?"; then
    for u in $PASSWORD_RESET_USERS; do
      if ! id "$u" >/dev/null 2>&1; then
        warn "Skipping password reset for unknown account: $u"
        continue
      fi
      if [ -n "$CLI_PASSWORD" ]; then
        if printf '%s:%s\n' "$u" "$CLI_PASSWORD" | chpasswd; then
          log "Changed password for selected user $u"
        else
          warn "Failed to change password for selected user $u"
        fi
      elif [ "$NON_INTERACTIVE" != "yes" ]; then
        if passwd "$u"; then
          log "Changed password for selected user $u"
        else
          warn "Failed to change password for selected user $u"
        fi
      else
        chage -d 0 "$u" && log "Required selected user $u to change their password at next login"
      fi
    done

    # Apply password aging to ALL local accounts with passwords
    for u in $(awk -F: '($3>=1000 && $3<65534) || $3==0 {print $1}' /etc/passwd); do
      chage -m "$MIN_DAYS" -M "$MAX_DAYS" -W "$WARN_DAYS" "$u" 2>/dev/null && log "Enforced password aging for $u (min:$MIN_DAYS max:$MAX_DAYS warn:$WARN_DAYS)"
    done

    [ -n "$PASSWORD_RESET_USERS" ] || log "No password resets requested; password aging policy was applied"
  fi
}

# ---------------------------------------------------------------------
# 3. PAM, LOGIN POLICY & SU RESTRICTION
# ---------------------------------------------------------------------
sec_pam() {
  echo -e "\n${Y}=== Module 3: PAM Password Policy, Faillock & su Restriction ===${N}"
  if ask "Configure PAM password complexity, history=5, minlen=$MIN_LEN, faillock, and su restriction?"; then
    $APT install libpam-pwquality >/dev/null 2>&1

    # Check pam_faillock support
    if [ -f /lib/security/pam_faillock.so ] || [ -f /lib/x86_64-linux-gnu/security/pam_faillock.so ]; then
      cat > /usr/share/pam-configs/faillock <<'EOF'
Name: Enforce failed login attempt counter
Default: no
Priority: 0
Auth-Type: Primary
Auth:
    [default=die] pam_faillock.so authfail deny=5 unlock_time=900 fail_interval=900
    sufficient pam_faillock.so authsucc deny=5 unlock_time=900 fail_interval=900
Account-Type: Primary
Account:
    required pam_faillock.so
EOF
      cat > /usr/share/pam-configs/faillock_notify <<'EOF'
Name: Notify on failed login attempts
Default: no
Priority: 1024
Auth-Type: Primary
Auth:
    requisite pam_faillock.so preauth silent deny=5 unlock_time=900 fail_interval=900
EOF
      pam-auth-update --package --enable faillock faillock_notify >/dev/null 2>&1 && log "Configured pam_faillock lockout"
    fi

    # Restrict su to wheel/sudo group
    if [ -f /etc/pam.d/su ]; then
      cp /etc/pam.d/su /etc/pam.d/su.cpbak
      wheel_grp="sudo"
      getent group sudo >/dev/null || wheel_grp="admin"
      if ! grep -qE "pam_wheel\.so" /etc/pam.d/su; then
        sed -i -E "/[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_rootok\.so/a auth required pam_wheel.so use_uid group=${wheel_grp}" /etc/pam.d/su
      fi

      # Precise su validation: diff line count, pam_rootok + pam_wheel presence, group existence, runuser session
      diff_lines=$(diff -u /etc/pam.d/su.cpbak /etc/pam.d/su | grep -c "^+[^+]")
      first_adm=$(echo "$ADMIN_USERS" | awk '{print $1}')

      if [ "$diff_lines" -eq 1 ] && \
         grep -q "pam_rootok.so" /etc/pam.d/su && \
         grep -q "pam_wheel.so" /etc/pam.d/su && \
         getent group "$wheel_grp" >/dev/null && \
         { [ -z "$first_adm" ] || runuser -u "$first_adm" -- id &>/dev/null; }; then
        log "Restricted su execution to group $wheel_grp via pam_wheel.so"
      else
        warn "su restriction validation failed! Rolling back /etc/pam.d/su."
        cp /etc/pam.d/su.cpbak /etc/pam.d/su
      fi
    fi

    # Update login.defs
    set_kv "PASS_MAX_DAYS" "$MAX_DAYS" /etc/login.defs " "
    set_kv "PASS_MIN_DAYS" "$MIN_DAYS" /etc/login.defs " "
    set_kv "PASS_WARN_AGE" "$WARN_DAYS" /etc/login.defs " "
    set_kv "ENCRYPT_METHOD" "SHA512" /etc/login.defs " "
    set_kv "UMASK" "027" /etc/login.defs " "

    # Remove nullok
    cp /etc/pam.d/common-auth /etc/pam.d/common-auth.cpbak
    cp /etc/pam.d/common-password /etc/pam.d/common-password.cpbak
    sed -i -E 's/[[:space:]]+nullok(_secure)?//g' /etc/pam.d/common-auth /etc/pam.d/common-password /usr/share/pam-configs/unix 2>/dev/null

    # Password history and complexity
    touch /etc/security/opasswd; chmod 600 /etc/security/opasswd
    # Enforce pam_pwhistory and pam_unix
    if grep -q "pam_pwhistory.so" /etc/pam.d/common-password; then
      sed -i -E 's/remember=[0-9]+/remember=5/g' /etc/pam.d/common-password
    else
      sed -i -E '/pam_unix\.so/i password required pam_pwhistory.so remember=5' /etc/pam.d/common-password
    fi
    sed -i -E "/pam_unix\.so/ { s/[[:space:]]+(remember|minlen)=[0-9]+//g; s/$/ minlen=$MIN_LEN/ }" /etc/pam.d/common-password

    # Configure pwquality
    for kv in "minlen=$MIN_LEN" "dcredit=-1" "ucredit=-1" "lcredit=-1" "ocredit=-1" "retry=3"; do
      k="${kv%%=*}"; v="${kv##*=}"
      set_kv "$k" "$v" /etc/security/pwquality.conf " = "
    done
    log "Enforced password complexity and password history (remember=5)"
  fi
}

# ---------------------------------------------------------------------
# 4. SUDOERS & PRIVILEGE ELEVATION HARDENING
# ---------------------------------------------------------------------
sec_sudoers() {
  echo -e "\n${Y}=== Module 4: Sudoers & Privilege Delegation Hardening ===${N}"
  if ask "Audit sudoers configuration for unauthorized ALL grants, NOPASSWD, and !authenticate?"; then
    cp /etc/sudoers /etc/sudoers.cpbak

    # Clean /etc/sudoers and /etc/sudoers.d/ files
    clean_sudo_file() {
      local sf="$1"
      [ -f "$sf" ] || return
      cp "$sf" "${sf}.bak"

      # Strip NOPASSWD and !authenticate
      sed -i -E 's/NOPASSWD:[[:space:]]*//g; s/!authenticate[[:space:]]*,?[[:space:]]*//g' "$sf"

      # Comment out non-comment lines granting ALL to users/groups not in ADMIN_USERS
      while read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ALL[[:space:]]*=[[:space:]]*\(?ALL.*\)?[[:space:]]*ALL ]]; then
          entity=$(echo "$line" | awk '{print $1}')
          clean_entity="${entity#%}"
          if [ "$clean_entity" != "root" ] && [ "$clean_entity" != "sudo" ] && [ "$clean_entity" != "admin" ]; then
            if ! inlist "$clean_entity" "$ADMIN_USERS"; then
              escaped_line=$(printf '%s\n' "$line" | sed 's/[[\.*^$()+?{|]/\\&/g')
              sed -i "s|^${escaped_line}|# UNKNOWN ADMIN REMOVED: ${line}|g" "$sf" 2>/dev/null || sed -i "s|^|# UNKNOWN ADMIN REMOVED: |g" "$sf"
              log "Commented out unauthorized sudoers line in $sf: $line"
            fi
          fi
        fi
      done < "${sf}.bak"

      if ! visudo -cf "$sf" >/dev/null 2>&1; then
        warn "visudo validation failed for $sf! Restoring backup."
        cp "${sf}.bak" "$sf"
      else
        rm -f "${sf}.bak"
      fi
    }

    clean_sudo_file /etc/sudoers
    for dropin in /etc/sudoers.d/*; do
      [ -f "$dropin" ] && clean_sudo_file "$dropin"
    done

    # Create drop-in hardening rule
    cat > /etc/sudoers.d/99-cp-hardening <<'EOF'
Defaults use_pty
Defaults logfile="/var/log/sudo.log"
EOF
    chmod 440 /etc/sudoers.d/99-cp-hardening

    if visudo -c >/dev/null 2>&1; then
      log "Hardened sudoers options (use_pty, logfile) verified"
    else
      warn "visudo syntax check failed. Rolling back sudoers drop-in."
      rm -f /etc/sudoers.d/99-cp-hardening
    fi
  fi
}

# ---------------------------------------------------------------------
# 5. SYSCTL KERNEL NETWORK HARDENING (IPv4 + IPv6)
# ---------------------------------------------------------------------
sec_sysctl() {
  echo -e "\n${Y}=== Module 5: Sysctl Network Kernel Hardening ===${N}"
  if ask "Apply network security sysctl kernel parameters (IPv4 & IPv6)?"; then
    cat > /etc/sysctl.d/99-cp-hardening.conf <<'EOF'
net.ipv4.tcp_syncookies = 1
net.ipv4.ip_forward = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.tcp_max_syn_backlog = 2048
kernel.randomize_va_space = 2
fs.suid_dumpable = 0

# IPv6 Equivalents
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
EOF
    set_kv "net.ipv4.tcp_syncookies" "1" /etc/sysctl.conf " = "
    set_kv "net.ipv4.ip_forward" "0" /etc/sysctl.conf " = "
    if sysctl --system >> "$LOG" 2>&1; then
      local syn_cookies forwarding
      syn_cookies=$(sysctl -n net.ipv4.tcp_syncookies 2>/dev/null)
      forwarding=$(sysctl -n net.ipv4.ip_forward 2>/dev/null)
      if [ "$syn_cookies" = "1" ] && [ "$forwarding" = "0" ]; then
        log "Verified IPv4 TCP SYN cookies enabled and IPv4 forwarding disabled"
      else
        warn "IPv4 sysctl verification failed (tcp_syncookies=$syn_cookies, ip_forward=$forwarding)"
      fi
    else
      warn "Failed to apply sysctl network hardening; see $LOG"
    fi
  fi
}

# ---------------------------------------------------------------------
# 6. SYSTEM FILE PERMISSIONS & HOME DIRECTORIES
# ---------------------------------------------------------------------
sec_perms() {
  echo -e "\n${Y}=== Module 6: File Permissions & Home Directory Hardening ===${N}"
  if ask "Secure critical file permissions (/etc/shadow, /etc/passwd, /etc/crontab, /home)?"; then
    chown root:shadow /etc/shadow /etc/gshadow 2>/dev/null; chmod 640 /etc/shadow /etc/gshadow
    chown root:root /etc/passwd /etc/group; chmod 644 /etc/passwd /etc/group
    chmod 440 /etc/sudoers 2>/dev/null; chmod 440 /etc/sudoers.d/* 2>/dev/null
    chmod 600 /etc/crontab /etc/ssh/sshd_config /boot/grub/grub.cfg 2>/dev/null || true
    chown root:root /boot/grub/grub.cfg 2>/dev/null || true
    if [ -f /etc/default/grub ]; then
      cp -p /etc/default/grub /etc/default/grub.cpbak 2>/dev/null || true
      sed -i -E '/^[[:space:]]*GRUB_CMDLINE_LINUX/ {
        s/rw[[:space:]]+init=[^ "\x27]*//g
        s/rw[[:space:]]+init//g
        s/init=[^ "\x27]*//g
        s/(^|[[:space:]])single([[:space:]]|$)/ /g
        s/[[:space:]]{2,}/ /g
        s/="[[:space:]]+/="/g
        s/[[:space:]]+"/"/g
      }' /etc/default/grub 2>/dev/null || true
      if command -v update-grub >/dev/null 2>&1; then
        update-grub >/dev/null 2>&1 || true
      fi
      log "Hardened GRUB: secured /boot/grub/grub.cfg and sanitized GRUB_CMDLINE_LINUX parameters"
    fi
    chmod 700 /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly 2>/dev/null

    # Non-recursive 750 on user home directories
    for h in /home/*; do
      if [ -d "$h" ]; then
        chmod 750 "$h"
      fi
    done

    # Remove world-writable bit on files (excluding /proc, /sys, /dev)
    find / -xdev -type f -perm -0002 -not -path "/proc/*" -not -path "/sys/*" -not -path "/dev/*" -exec chmod o-w {} + 2>/dev/null
    find / -xdev -type d \( -perm -0002 -a ! -perm -1000 \) -exec chmod +t {} + 2>/dev/null

    # Audit SUID / SGID / Capabilities
    echo "--- SUID Files Report ---" >> "$LOG"
    find / -xdev -type f -perm -4000 2>/dev/null >> "$LOG"
    if command -v getcap >/dev/null 2>&1; then
      echo "--- Capabilities Report ---" >> "$LOG"
      getcap -r / 2>/dev/null >> "$LOG"
    fi

    log "Hardened critical permissions and set sticky bit on world-writable directories"
  fi
}

# ---------------------------------------------------------------------
# 7. SSH SERVER HARDENING & AUTHORIZED KEYS AUDIT
# ---------------------------------------------------------------------
sec_ssh() {
  echo -e "\n${Y}=== Module 7: SSH Server Hardening & Authorized Keys Audit ===${N}"
  if [ -f /etc/ssh/sshd_config ]; then
    if ask "Harden SSH configuration and audit user authorized_keys?"; then
      # Audit authorized_keys
      find /home /root -path "*/.ssh/authorized_keys" -type f 2>/dev/null | while read -r ak; do
        if [ "$SSH_REQUIRED" = "no" ]; then
          rm -f "$ak" && log "Deleted authorized_keys because SSH is not required: $ak"
        else
          warn "Found SSH Key File: $ak"
          ssh-keygen -lf "$ak" 2>/dev/null | sed 's/^/    /'
          if ask_timed "Remove SSH authorized_keys file $ak?" "N"; then
            rm -f "$ak" && log "Removed SSH authorized_keys file: $ak"
          else
            log "Kept authorized_keys file for authorized access: $ak"
          fi
        fi
      done

      # Clear non-default SSH key directives in sshd_config & drop-ins
      for f in /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*; do
        [ -f "$f" ] || continue
        sed -i -E 's/^[[:space:]]*#?[[:space:]]*(AuthorizedKeysFile|AuthorizedKeysCommand|TrustedUserCAKeys)[[:space:]].*/# Directive cleared/g' "$f"
      done

      # Backup sshd_config
      cp /etc/ssh/sshd_config /etc/ssh/sshd_config.cpbak

      # Re-write SSH options at top using temporary file
      tmp_sshd=$(mktemp)
      {
        echo "PermitRootLogin no"
        echo "PermitEmptyPasswords no"
        echo "X11Forwarding no"
        echo "MaxAuthTries 4"
        echo "IgnoreRhosts yes"
        echo "LoginGraceTime 60"
        echo "ClientAliveInterval 300"
        echo "ClientAliveCountMax 0"
        [ -n "$AUTHORIZED_USERS" ] && [ "$SSH_REQUIRED" = "yes" ] && echo "AllowUsers $AUTHORIZED_USERS $ADMIN_USERS"
        grep -v -E "^[[:space:]]*#?[[:space:]]*(PermitRootLogin|PermitEmptyPasswords|X11Forwarding|MaxAuthTries|IgnoreRhosts|LoginGraceTime|ClientAliveInterval|ClientAliveCountMax|AllowUsers)[[:space:]]" /etc/ssh/sshd_config
      } > "$tmp_sshd"
      cp "$tmp_sshd" /etc/ssh/sshd_config
      rm -f "$tmp_sshd"

      # Validate syntax
      if sshd -t 2>/dev/null; then
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
        log "SSH hardened successfully"
        echo "Effective SSH Settings:"
        sshd -T 2>/dev/null | grep -E "permitrootlogin|passwordauthentication|permitemptypasswords|x11forwarding|maxauthtries|allowusers" | sed 's/^/    /'
      else
        warn "sshd -t syntax check failed! Rolling back to sshd_config backup."
        cp /etc/ssh/sshd_config.cpbak /etc/ssh/sshd_config
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null
      fi
    fi
  fi
}

# ---------------------------------------------------------------------
# 8. PROHIBITED SOFTWARE & SERVICE PURGING (WITH FAMILY MAP & DEPENDENCY GUARD)
# ---------------------------------------------------------------------
sec_remove() {
  echo -e "\n${Y}=== Module 8: Prohibited Software & Service Removal ===${N}"
  if ask "Purge unauthorized server services and hacking tools?"; then
    apt-get update -qq

    is_kept_family() {
      local p="$1"
      for kf in $KEPT_FAMILIES $KEEP_SERVICES $REQUIRED_SOFTWARE; do
        # shellcheck disable=SC2053
        if [[ "$p" == $kf ]]; then return 0; fi
      done
      return 1
    }

    local purge_candidates
    purge_candidates=$(
      for candidate_pattern in "${PURGE_PATTERNS[@]}"; do
        dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' "$candidate_pattern" 2>/dev/null |
          awk '$1 ~ /i$/ { print $2 }'
      done | sort -u
    )
    while IFS= read -r inst_p; do
        [ -n "$inst_p" ] || continue
          if is_kept_family "$inst_p"; then
            log "Skipped purge of $inst_p (matches kept family or service)"
            continue
          fi

          # Dependency Guard via simulation
          sim_out=$(apt-get -s purge "$inst_p" 2>/dev/null)
          removed_deps=$(echo "$sim_out" | grep -E "^Remv " | awk '{print $2}')
          blocked="no"
          for dep in $removed_deps; do
            if is_kept_family "$dep" || [[ "$dep" =~ ^(ssh|openssh|ufw|sudo|apparmor|auditd|libpam-|network-manager|debian-|task-|open-vm-tools|virtualbox-guest|qemu-guest|hyperv-|linux-image|systemd|lightdm|gdm3) ]]; then
              warn "Skipped purge of $inst_p (would remove protected package $dep)"
              blocked="yes"
              break
            fi
          done

          if [ "$blocked" = "no" ]; then
            systemctl disable --now "$inst_p" 2>/dev/null
            $APT purge "$inst_p" >/dev/null 2>&1 && log "Purged prohibited package: $inst_p"
          fi
    done <<< "$purge_candidates"
  fi
}

# ---------------------------------------------------------------------
# 9. BACKDOOR, CRON & SYSTEMD PERSISTENCE SWEEP
# ---------------------------------------------------------------------
sec_backdoor() {
  echo -e "\n${Y}=== Module 9: Backdoor & Persistence Sweep ===${N}"
  if ask "Sweep running netcat/backdoors, cron/at jobs, startup scripts, and executables in /tmp?"; then
    # Purge netcat package via dpkg -S lookup
    nc_path=$(command -v nc 2>/dev/null || command -v netcat 2>/dev/null)
    if [ -n "$nc_path" ]; then
      real_nc=$(readlink -f "$nc_path")
      pkg_owner=$(dpkg -S "$real_nc" 2>/dev/null | cut -d: -f1)
      if [ -n "$pkg_owner" ]; then
        $APT purge "$pkg_owner" >/dev/null 2>&1 && log "Purged package owning netcat binary: $pkg_owner"
      fi
      rm -f "$real_nc" "$nc_path" 2>/dev/null
    fi

    # Kill netcat/socat processes
    for pid in $(ps -eo pid,comm | awk '$2 ~ /^(nc|ncat|netcat|socat)$/ {print $1}'); do
      kill -9 "$pid" 2>/dev/null && log "Killed backdoor PID $pid"
    done

    # Trace perl/python/ruby network listeners (if lsof available)
    if command -v lsof >/dev/null 2>&1; then
      lsof -i -n -P 2>/dev/null | grep LISTEN | grep -E "perl|python|ruby" | while read -r line; do
        pid=$(echo "$line" | awk '{print $2}')
        pcmd=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null)
        warn "Found network-connected script interpreter PID $pid: $pcmd"
        if ask_timed "Kill network script listener PID $pid?"; then
          kill -9 "$pid" 2>/dev/null && log "Killed script backdoor PID $pid"
        fi
      done
    fi

    # Scan cron files
    for cronfile in /etc/crontab /etc/cron.d/* /var/spool/cron/crontabs/* /etc/cron.hourly/* /etc/cron.daily/* /etc/cron.weekly/* /etc/cron.monthly/*; do
      [ -f "$cronfile" ] || continue

      # Skip package-owned files in system cron locations
      if [[ "$cronfile" == /etc/cron.* ]] || [[ "$cronfile" == /etc/crontab ]]; then
        if dpkg -S "$cronfile" &>/dev/null; then
          if check_suspicious_file "$cronfile"; then
            log "[SKIP PACKAGE CRON] $cronfile matched persistence pattern but is owned by installed package"
          fi
          continue
        fi
      fi

      if check_suspicious_file "$cronfile"; then
        warn "Suspicious persistence entry in $cronfile"
        if ask_timed "Clean suspicious persistence lines in $cronfile?"; then
          clean_suspicious_file "$cronfile"
          log "Cleaned cron file: $cronfile"
        fi
      fi
    done

    # Scan systemd service/timer files
    find /etc/systemd/system /root/.config/systemd/user /home/*/.config/systemd/user -type f \( -name "*.service" -o -name "*.timer" \) 2>/dev/null | while read -r unitfile; do
      [ -f "$unitfile" ] || continue
      uname=$(basename "$unitfile")

      # Skip if owned by an installed package
      if dpkg -S "$unitfile" &>/dev/null; then
        if check_suspicious_file "$unitfile"; then
          log "[SKIP PACKAGE SYSTEMD] $unitfile ExecStart matched persistence pattern but is owned by installed package"
        fi
        continue
      fi

      if check_suspicious_file "$unitfile"; then
        warn "Suspicious systemd unit file: $unitfile"
        if ask_timed "Disable and delete suspicious systemd unit $uname?"; then
          systemctl disable --now "$uname" 2>/dev/null
          clean_suspicious_file "$unitfile" 2>/dev/null || true
          rm -f "$unitfile" && log "Deleted suspicious unit file $unitfile"
          systemctl daemon-reload
        fi
      fi
    done

    # Check /etc/rc.local and /etc/ld.so.preload
    if [ -f /etc/rc.local ]; then
      grep -q "exit 0" /etc/rc.local || echo "exit 0" > /etc/rc.local
    fi
    rm -f /etc/ld.so.preload 2>/dev/null

    # Clean cron and at allow/deny
    rm -f /etc/cron.deny /etc/at.deny
    echo "root" > /etc/cron.allow
    echo "root" > /etc/at.allow
    log "Restricted cron and at to root only"
  fi
}

# ---------------------------------------------------------------------
# 10. REFINED FILE DELETION SCOPE
# ---------------------------------------------------------------------
sec_files() {
  echo -e "\n${Y}=== Module 10: Prohibited Media & Archive File Search ===${N}"
  if ask "Delete prohibited media and archive files (.mp3, .zip, .tar, .deb, etc.)?"; then

    # 1. Media Files (Anywhere except system/app/service roots)
    find / -xdev -type f \( -iname '*.mp3' -o -iname '*.mp4' -o -iname '*.m4a' -o -iname '*.flac' \
      -o -iname '*.wav' -o -iname '*.ogg' -o -iname '*.avi' -o -iname '*.mkv' -o -iname '*.mov' \
      -o -iname '*.wmv' -o -iname '*.flv' -o -iname '*.mpg' -o -iname '*.mpeg' -o -iname '*.torrent' \) \
      -not -path "/usr/*" -not -path "/lib*" -not -path "/bin/*" -not -path "/sbin/*" -not -path "/boot/*" \
      -not -path "/proc/*" -not -path "/sys/*" -not -path "/etc/*" -not -path "/var/lib/*" \
      -not -path "/var/cache/*" -not -path "/snap/*" -not -path "/opt/*/*" \
      -not -path "/var/www/*" -not -name "Forensics*" -not -name "README*" 2>/dev/null | while read -r mf; do
        rm -f "$mf" && log "Deleted media file: $mf"
    done

    # 2. Archives and Installers under /home, /root, /tmp, /var/tmp, /srv, /opt
    # Exclude tar/gz/tgz/bz2/xz under /opt and /srv, protect REQUIRED_SOFTWARE & /srv/ftp|www|http|samba|nfs
    find /home /root /tmp /var/tmp -xdev -type f \( -iname '*.zip' -o -iname '*.rar' \
      -o -iname '*.7z' -o -iname '*.tar' -o -iname '*.gz' -o -iname '*.tgz' -o -iname '*.bz2' \
      -o -iname '*.xz' -o -iname '*.deb' -o -iname '*.rpm' -o -iname '*.exe' -o -iname '*.msi' \
      -o -iname '*.run' -o -iname '*.AppImage' \) -not -name "Forensics*" -not -name "README*" 2>/dev/null | while read -r af; do
        parent_dir=$(dirname "$af")
        if ! dpkg -S "$parent_dir" &>/dev/null; then
          rm -f "$af" && log "Deleted archive/installer file: $af"
        fi
    done

    find /srv /opt -xdev -type f \( -iname '*.zip' -o -iname '*.rar' -o -iname '*.7z' \
      -o -iname '*.deb' -o -iname '*.rpm' -o -iname '*.exe' -o -iname '*.msi' \
      -o -iname '*.run' -o -iname '*.AppImage' -o -iname '*.torrent' \) \
      -not -path "/srv/ftp/*" -not -path "/srv/www/*" -not -path "/srv/http/*" \
      -not -path "/srv/samba/*" -not -path "/srv/nfs/*" \
      -not -name "Forensics*" -not -name "README*" 2>/dev/null | while read -r af; do
        # Protect required software or kept service names in path
        keep_path="no"
        for req_p in $REQUIRED_SOFTWARE $KEEP_SERVICES; do
          if [[ "$af" == *"$req_p"* ]]; then keep_path="yes"; break; fi
        done
        if [ "$keep_path" = "no" ]; then
          parent_dir=$(dirname "$af")
          if ! dpkg -S "$parent_dir" &>/dev/null; then
            rm -f "$af" && log "Deleted archive/installer file under /srv|/opt: $af"
          fi
        fi
    done

    # 3. Images strictly under user Downloads/Pictures/Documents/Desktop and /tmp
    find /home/*/{Downloads,Pictures,Documents,Desktop} /tmp -xdev -type f \( -iname '*.jpg' \
      -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' \) \
      -not -name "Forensics*" -not -name "README*" -not -path "*/.mozilla/*" -not -path "*/.config/*" \
      -not -path "*/.local/*" -not -path "*/.cache/*" 2>/dev/null | while read -r imgf; do
        rm -f "$imgf" && log "Deleted user image file: $imgf"
    done

    log "Completed refined file deletion scope"
  fi
}

# ---------------------------------------------------------------------
# 11. APT SOURCES, HOSTS, RESOLV.CONF & UFW HARDENING
# ---------------------------------------------------------------------
sec_network() {
  echo -e "\n${Y}=== Module 11: Apt Sources, Hosts File, Resolv.conf & UFW Firewall ===${N}"
  if ask "Clean Apt sources, /etc/hosts, DNS resolv.conf, and configure UFW?"; then
    # Apt Sources Cleaning & Deb822 (.sources)

    for sfile in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
      [ -f "$sfile" ] || continue
      if [[ "$sfile" == *"official-package-repositories.list"* ]]; then
        continue
      fi
      sed -i -E '/(deb\.debian\.org|security\.debian\.org|ftp\.debian\.org|archive\.debian\.org)/! { s/^[[:space:]]*deb[[:space:]]/# DELETED REPO: deb /g }' "$sfile"
    done

    # Handle deb822 .sources files
    for srcfile in /etc/apt/sources.list.d/*.sources; do
      [ -f "$srcfile" ] || continue
      tmp_src=$(mktemp)
      awk '
      BEGIN { in_stanza = 0; stanza = ""; is_official = 0 }
      /^[[:space:]]*$/ {
        if (stanza != "") {
          if (!is_official && stanza !~ /Enabled:[[:space:]]*no/) {
            stanza = stanza "\nEnabled: no"
          }
          print stanza "\n"
          stanza = ""
          is_official = 0
        }
        next
      }
      {
        if (stanza == "") stanza = $0
        else stanza = stanza "\n" $0
        if ($0 ~ /URIs:[[:space:]]*/ && ($0 ~ /deb\.debian\.org/ || $0 ~ /security\.debian\.org/ || $0 ~ /ftp\.debian\.org/ || $0 ~ /archive\.debian\.org/)) {
          is_official = 1
        }
      }
      END {
        if (stanza != "") {
          if (!is_official && stanza !~ /Enabled:[[:space:]]*no/) {
            stanza = stanza "\nEnabled: no"
          }
          print stanza
        }
      }
      ' "$srcfile" > "$tmp_src"
      cp "$tmp_src" "$srcfile" && rm -f "$tmp_src"
    done
    log "Cleaned Apt sources list and .sources stanzas to official Debian release repositories"

    # Keyring Pruning Logic
    enabled_keyrings=$(mktemp)
    grep -h -i "Signed-By:" /etc/apt/sources.list.d/*.sources 2>/dev/null | awk '{print $2}' >> "$enabled_keyrings"
    grep -h -i "signed-by=" /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null | sed -n 's/.*signed-by=\([^ ]*\).*/\1/p' >> "$enabled_keyrings"

    for kr in /etc/apt/trusted.gpg.d/* /etc/apt/keyrings/*; do
      [ -f "$kr" ] || continue
      kr_name=$(basename "$kr")

      if [[ "$kr_name" =~ ^(debian-archive-keyring) ]]; then
        continue
      fi

      if grep -qF "$kr" "$enabled_keyrings" 2>/dev/null || grep -qF "$kr_name" "$enabled_keyrings" 2>/dev/null; then
        continue
      fi

      if dpkg -S "$kr" &>/dev/null; then
        continue
      fi

      rm -f "$kr" && log "Removed unreferenced orphan APT keyring: $kr"
    done
    rm -f "$enabled_keyrings"

    # Keep the active hostname resolvable locally for sudo and system services.
    hosts_tmp=$(mktemp)
    sys_host=$(hostname -s 2>/dev/null)
    [ -n "$sys_host" ] || sys_host=$(cat /etc/hostname 2>/dev/null)
    awk -v h="$sys_host" '
    BEGIN {
      ok["127.0.0.1 localhost"] = 1
      ok["::1 ip6-localhost ip6-loopback"] = 1
      ok["fe00::0 ip6-localnet"] = 1
      ok["ff00::0 ip6-mcastprefix"] = 1
      ok["ff02::1 ip6-allnodes"] = 1
      ok["ff02::2 ip6-allrouters"] = 1
      ok["ff02::3 ip6-allhosts"] = 1
    }
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { print $0; next }
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line in ok) {
        print $0
        next
      }
      if ($1 == "127.0.1.1") {
        for (i = 2; i <= NF; i++) {
          if ($i == h) {
            print $0
            found_host = 1
            break
          }
        }
      }
    }
    END { if (!found_host && h != "") print "127.0.1.1 " h }
    ' /etc/hosts > "$hosts_tmp"
    if cp "$hosts_tmp" /etc/hosts; then
      rm -f "$hosts_tmp"
      log "Cleaned /etc/hosts and verified local hostname mapping: $sys_host"
    else
      rm -f "$hosts_tmp"
      warn "Could not update /etc/hosts; retained the existing file"
    fi

    # /etc/resolv.conf
    if [ ! -L /etc/resolv.conf ]; then
      echo -e "nameserver 8.8.8.8\nnameserver 1.1.1.1" > /etc/resolv.conf
      log "Configured static DNS in /etc/resolv.conf"
    elif [ -f /etc/systemd/resolved.conf ]; then
      SET_KV_KEY="DNS" SET_KV_VAL="8.8.8.8 1.1.1.1" SET_KV_SEP=" = " awk '
      BEGIN { k = ENVIRON["SET_KV_KEY"]; v = ENVIRON["SET_KV_VAL"]; s = ENVIRON["SET_KV_SEP"]; target_line = 0; uncommented_target = 0; commented_target = 0 }
      NR == FNR {
        clean_line = $0; sub(/^[ \t]*#?[ \t]*/, "", clean_line)
        if (index(clean_line, k) == 1) {
          rest = substr(clean_line, length(k) + 1)
          if (rest == "" || rest ~ /^[ \t]*=/ || rest ~ /^[ \t]+/) {
            if ($0 !~ /^[ \t]*#/) { if (uncommented_target == 0) uncommented_target = NR }
            else { if (commented_target == 0) commented_target = NR }
          }
        }
        next
      }
      {
        target_line = (uncommented_target > 0) ? uncommented_target : commented_target
        clean_line = $0; sub(/^[ \t]*#?[ \t]*/, "", clean_line)
        if (index(clean_line, k) == 1) {
          rest = substr(clean_line, length(k) + 1)
          if (rest == "" || rest ~ /^[ \t]*=/ || rest ~ /^[ \t]+/) {
            if (FNR == target_line) { print k s v; next }
            else if ($0 !~ /^[ \t]*#/) { next }
            else { print $0; next }
          }
        }
        print $0
      }
      END { if (target_line == 0) print k s v }
      ' /etc/systemd/resolved.conf /etc/systemd/resolved.conf > /etc/systemd/resolved.conf.tmp && cat /etc/systemd/resolved.conf.tmp > /etc/systemd/resolved.conf && rm -f /etc/systemd/resolved.conf.tmp
      systemctl restart systemd-resolved 2>/dev/null
    fi

    # UFW Firewall Pruning
    if ! refresh_apt_metadata; then
      warn "APT metadata refresh failed before UFW installation; attempting installation with available package metadata"
    fi
    if ! $APT install ufw >> "$LOG" 2>&1 || ! command -v ufw >/dev/null 2>&1; then
      warn "Could not install UFW; firewall configuration was skipped"
      return 1
    fi
    if ! ufw default deny incoming >> "$LOG" 2>&1 || ! ufw default allow outgoing >> "$LOG" 2>&1; then
      warn "Could not configure UFW default policies"
      return 1
    fi

    ufw status numbered 2>/dev/null | grep -E "\[[ 0-9]+\]" | sort -rn | while read -r rline; do
      rnum=$(echo "$rline" | sed -n 's/^\[ *\([0-9]*\)\].*/\1/p')
      rport=$(echo "$rline" | awk '{print $2}')
      [ -n "$rnum" ] || continue
      keep_rule="no"
      [ "$SSH_REQUIRED" = "yes" ] && [[ "$rport" == *"22"* ]] && keep_rule="yes"
      for p in $UFW_ALLOW; do
        if [[ "$rport" == *"$p"* ]]; then keep_rule="yes"; break; fi
      done
      if [ "$keep_rule" = "no" ]; then
        echo "y" | ufw delete "$rnum" >/dev/null 2>&1
      fi
    done

    if [ "$SSH_REQUIRED" = "yes" ] && ! ufw allow 22/tcp >> "$LOG" 2>&1; then
      warn "Could not allow SSH firewall port 22/tcp"
    fi
    for port in $UFW_ALLOW; do
      ufw allow "$port" >> "$LOG" 2>&1 || warn "Could not allow firewall port: $port"
    done
    if ufw --force enable >> "$LOG" 2>&1 && ufw status | grep -q "Status: active"; then
      log "Enabled UFW firewall and pruned unauthorized rules"
    else
      warn "Failed to enable UFW firewall; see $LOG"
    fi
  fi
}

# ---------------------------------------------------------------------
# 12. ROOTKIT & MALWARE SCANNERS (REPORT-ONLY)
# ---------------------------------------------------------------------
sec_scanner() {
  echo -e "\n${Y}=== Module 12: Rootkit & Malware Scanners ===${N}"
  if ask "Run rootkit and malware scanners (rkhunter, chkrootkit, clamscan)?"; then
    if [ "$SELF_TEST" = "yes" ]; then
      log "skipped: no network/changes in self-test"
      return 0
    fi

    local has_net="no"
    if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
      has_net="yes"
    fi

    # rkhunter
    if ! command -v rkhunter >/dev/null 2>&1; then
      if [ "$has_net" = "yes" ]; then
        $APT install rkhunter >/dev/null 2>&1
      fi
    fi
    if command -v rkhunter >/dev/null 2>&1; then
      log "Running rkhunter scan (timeout 600s)..."
      timeout 600 rkhunter --check --sk --nocolors >> "$LOG" 2>&1 || true
      log "rkhunter scan finished"
    else
      warn "rkhunter not installed; skipping scan"
    fi

    # chkrootkit
    if ! command -v chkrootkit >/dev/null 2>&1; then
      if [ "$has_net" = "yes" ]; then
        $APT install chkrootkit >/dev/null 2>&1
      fi
    fi
    if command -v chkrootkit >/dev/null 2>&1; then
      log "Running chkrootkit scan (timeout 600s)..."
      timeout 600 chkrootkit >> "$LOG" 2>&1 || true
      log "chkrootkit scan finished"
    else
      warn "chkrootkit not installed; skipping scan"
    fi

    # clamscan
    if ! command -v clamscan >/dev/null 2>&1; then
      if [ "$has_net" = "yes" ]; then
        $APT install clamav >/dev/null 2>&1
      fi
    fi
    if command -v clamscan >/dev/null 2>&1; then
      log "Running clamscan on /home /tmp /var/tmp (timeout 600s)..."
      timeout 600 clamscan -ri /home /tmp /var/tmp >> "$LOG" 2>&1 || true
      log "clamscan scan finished"
    else
      warn "clamscan not installed; skipping scan"
    fi


  fi
}

# ---------------------------------------------------------------------
# 13. REQUIRED SERVICE HARDENING
# ---------------------------------------------------------------------
sec_services() {
  echo -e "\n${Y}=== Module 13: Required Service Hardening ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi
  if [ "$ALL_MODULES" = "yes" ] || ask_timed "Harden configurations for required services (Apache, vsftpd, Samba, MySQL/MariaDB, PHP, Nginx)?" "Y"; then
    # 1. Apache
    if [ "$REQ_APACHE" = "yes" ] && command -v apache2 >/dev/null 2>&1; then
      local ap_conf="/etc/apache2/conf-available/security.conf"
      [ -f "$ap_conf" ] || ap_conf="/etc/apache2/apache2.conf"
      if [ -f "$ap_conf" ]; then
        cp -p "$ap_conf" "${ap_conf}.cp_bak"
        set_kv "ServerTokens" "Prod" "$ap_conf" " "
        set_kv "ServerSignature" "Off" "$ap_conf" " "
        set_kv "TraceEnable" "Off" "$ap_conf" " "
        if command -v apache2ctl >/dev/null 2>&1 && ! apache2ctl configtest >/dev/null 2>&1; then
          warn "Apache config validation failed, restoring original config"
          mv -f "${ap_conf}.cp_bak" "$ap_conf"
        else
          rm -f "${ap_conf}.cp_bak"
          log "Hardened Apache configuration (ServerTokens Prod, ServerSignature Off, TraceEnable Off)"
          systemctl reload apache2 2>/dev/null || true
        fi
      fi
    fi

    # 2. vsftpd
    if [ "$REQ_FTP" = "yes" ] && command -v vsftpd >/dev/null 2>&1; then
      local ftp_conf="/etc/vsftpd.conf"
      if [ -f "$ftp_conf" ]; then
        cp -p "$ftp_conf" "${ftp_conf}.cp_bak"
        set_kv "anonymous_enable" "NO" "$ftp_conf" "="
        set_kv "local_enable" "YES" "$ftp_conf" "="
        set_kv "write_enable" "YES" "$ftp_conf" "="
        set_kv "chroot_local_user" "YES" "$ftp_conf" "="
        set_kv "allow_writeable_chroot" "YES" "$ftp_conf" "="
        set_kv "anon_upload_enable" "NO" "$ftp_conf" "="
        set_kv "anon_mkdir_write_enable" "NO" "$ftp_conf" "="
        set_kv "dirmessage_enable" "YES" "$ftp_conf" "="
        set_kv "xferlog_enable" "YES" "$ftp_conf" "="
        set_kv "connect_from_port_20" "YES" "$ftp_conf" "="
        local test_err=0
        systemctl restart vsftpd 2>/dev/null || test_err=1
        if [ $test_err -eq 0 ] && systemctl is-active vsftpd >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ':21[[:space:]]'; then
          rm -f "${ftp_conf}.cp_bak"
          log "Hardened VSFTPD configuration (anonymous_enable=NO, chroot_local_user=YES, allow_writeable_chroot=YES)"
        else
          warn "vsftpd verification failed (service inactive or port 21 not listening), restoring original config"
          mv -f "${ftp_conf}.cp_bak" "$ftp_conf"
          systemctl restart vsftpd 2>/dev/null || true
        fi
      fi
    fi

    # 3. Samba
    if [ "$REQ_SAMBA" = "yes" ] && command -v smbd >/dev/null 2>&1; then
      local smb_conf="/etc/samba/smb.conf"
      if [ -f "$smb_conf" ]; then
        cp -p "$smb_conf" "${smb_conf}.cp_bak"
        set_ini "global" "server min protocol" "SMB2" "$smb_conf"
        set_ini "global" "client min protocol" "SMB2" "$smb_conf"
        set_ini "global" "restrict anonymous" "2" "$smb_conf"
        set_ini "global" "null passwords" "no" "$smb_conf"
        if command -v testparm >/dev/null 2>&1 && ! testparm -s "$smb_conf" >/dev/null 2>&1; then
          warn "Samba config validation (testparm) failed, restoring original config"
          mv -f "${smb_conf}.cp_bak" "$smb_conf"
        else
          rm -f "${smb_conf}.cp_bak"
          log "Hardened Samba configuration (server min protocol SMB2, restrict anonymous = 2)"
          systemctl restart smbd 2>/dev/null || true
        fi
      fi
    fi

    # 4. MySQL / MariaDB
    if [ "$REQ_MYSQL" = "yes" ] && (command -v mysql >/dev/null 2>&1 || command -v mariadb >/dev/null 2>&1); then
      local my_conf=""
      for c in /etc/mysql/mysql.conf.d/mysqld.cnf /etc/mysql/mariadb.conf.d/50-server.cnf /etc/mysql/my.cnf; do
        if [ -f "$c" ]; then my_conf="$c"; break; fi
      done
      if [ -n "$my_conf" ]; then
        cp -p "$my_conf" "${my_conf}.cp_bak"
        set_ini "mysqld" "bind-address" "127.0.0.1" "$my_conf"
        set_ini "mysqld" "local-infile" "0" "$my_conf"
        set_ini "mysqld" "symbolic-links" "0" "$my_conf"
        local my_err=0
        if command -v mysqld >/dev/null 2>&1; then
          mysqld --help --verbose >/dev/null 2>&1 || my_err=1
        elif command -v mariadbd >/dev/null 2>&1; then
          mariadbd --help --verbose >/dev/null 2>&1 || my_err=1
        fi
        if [ $my_err -ne 0 ]; then
          warn "MySQL/MariaDB config test failed, restoring original config"
          mv -f "${my_conf}.cp_bak" "$my_conf"
        else
          rm -f "${my_conf}.cp_bak"
          log "Hardened MySQL/MariaDB configuration (bind-address 127.0.0.1, local-infile 0)"
          systemctl restart mysql 2>/dev/null || systemctl restart mariadb 2>/dev/null || true
        fi
      fi
    fi

    # 5. PHP
    if [ "$REQ_PHP" = "yes" ]; then
      local php_found="no"
      for pini in /etc/php/*/*/php.ini; do
        [ -f "$pini" ] || continue
        php_found="yes"
        cp -p "$pini" "${pini}.cp_bak"
        set_kv "expose_php" "Off" "$pini" " = "
        set_kv "display_errors" "Off" "$pini" " = "
        set_kv "allow_url_fopen" "Off" "$pini" " = "
        set_kv "allow_url_include" "Off" "$pini" " = "
        set_kv "session.cookie_httponly" "1" "$pini" " = "
        set_kv "session.use_only_cookies" "1" "$pini" " = "
        if command -v php >/dev/null 2>&1 && ! php -n -c "$pini" -r 'echo 1;' >/dev/null 2>&1; then
          warn "PHP syntax validation failed on $pini, restoring original file"
          mv -f "${pini}.cp_bak" "$pini"
        else
          rm -f "${pini}.cp_bak"
          log "Hardened PHP configuration: $pini (expose_php = Off, display_errors = Off)"
        fi
      done
      if [ "$php_found" = "yes" ]; then
        systemctl reload apache2 2>/dev/null || true
        systemctl restart 'php*-fpm' 2>/dev/null || true
      fi
    fi

    # 6. Nginx
    if [ "$REQ_NGINX" = "yes" ] && command -v nginx >/dev/null 2>&1; then
      local ng_conf="/etc/nginx/nginx.conf"
      if [ -f "$ng_conf" ]; then
        if grep -q "server_tokens" "$ng_conf"; then
          cp -p "$ng_conf" "${ng_conf}.cp_bak"
          sed -i -E 's/^[[:space:]]*#?[[:space:]]*server_tokens[[:space:]]+(on|off);/\tserver_tokens off;/' "$ng_conf"
          if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
            warn "Nginx config test (nginx -t) failed, restoring original config"
            mv -f "${ng_conf}.cp_bak" "$ng_conf"
          else
            rm -f "${ng_conf}.cp_bak"
            log "Hardened Nginx configuration (server_tokens off;)"
            systemctl reload nginx 2>/dev/null || true
          fi
        else
          mkdir -p /etc/nginx/conf.d
          local ng_dropin="/etc/nginx/conf.d/cp-hardening.conf"
          echo "server_tokens off;" > "$ng_dropin"
          if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
            warn "Nginx config test (nginx -t) failed with $ng_dropin, removing file"
            rm -f "$ng_dropin"
          else
            log "Hardened Nginx configuration via $ng_dropin (server_tokens off;)"
            systemctl reload nginx 2>/dev/null || true
          fi
        fi
      fi
    fi
  fi
}

# ---------------------------------------------------------------------
# 14. DEFENSES, LOGGING & ACCESS CONTROLS
# ---------------------------------------------------------------------
sec_defenses() {
  echo -e "\n${Y}=== Module 14: Defenses, Logging & Access Controls ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi
  if [ "$ALL_MODULES" = "yes" ] || ask_timed "Enable defenses (AppArmor enforce, auditd rules, fail2ban, rsyslog, disable guest/autologin, blacklist USB storage/firewire, disable coredumps)?" "Y"; then
    local has_net="no"
    if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
      has_net="yes"
    fi

    if [ "$SELF_TEST" != "yes" ] && [ "$has_net" = "yes" ]; then
      $APT install auditd audispd-plugins apparmor apparmor-utils fail2ban rsyslog ufw >/dev/null 2>&1
    fi

    for srv in auditd apparmor fail2ban rsyslog ufw; do
      systemctl enable "$srv" >/dev/null 2>&1 || true
      systemctl start "$srv" >/dev/null 2>&1 || true
    done

    # Ensure VM guest tools and snapshot integration services remain running if present
    for vmsrv in open-vm-tools.service vmtoolsd.service virtualbox-guest-utils.service vboxadd-service.service qemu-guest-agent.service hv-fcopy-daemon.service hv-vss-daemon.service; do
      if systemctl list-unit-files "$vmsrv" &>/dev/null; then
        systemctl enable --now "$vmsrv" >/dev/null 2>&1 || true
        log "Ensured VM guest integration service $vmsrv is enabled and active for snapshots"
      fi
    done

    # 1. AppArmor (set complain profiles to enforce, skipping kept families)
    if command -v apparmor_status >/dev/null 2>&1 || [ -d /etc/apparmor.d ]; then
      if command -v aa-enforce >/dev/null 2>&1; then
        for prof in /etc/apparmor.d/*; do
          [ -f "$prof" ] || continue
          base=$(basename "$prof")
          [[ "$base" =~ ^(local|abstractions|tunables|disable|force-complain)$ ]] && continue

          target_bin="/${base//.//}"
          if [ ! -e "$target_bin" ]; then
            target_bin=$(grep -E '^[[:space:]]*(profile[[:space:]]+)?[/]' "$prof" 2>/dev/null | head -n1 | sed -E 's/^[[:space:]]*(profile[[:space:]]+)?([^ {]+).*/\2/')
          fi

          pkg_name=""
          if [ -n "$target_bin" ] && [ -e "$target_bin" ]; then
            pkg_name=$(dpkg -S "$target_bin" 2>/dev/null | cut -d: -f1)
          fi
          if [ -z "$pkg_name" ] && [ -n "$target_bin" ]; then
            pkg_name=$(basename "$target_bin")
          fi
          if [ -z "$pkg_name" ]; then
            pkg_name="${base##*.}"
          fi

          if [ -n "$pkg_name" ] && is_kept_family "$pkg_name"; then
            log "Skipping aa-enforce on $base (binary package '$pkg_name' in kept families)"
            continue
          fi
          if is_kept_family "$base" || ( [ -n "$target_bin" ] && is_kept_family "$(basename "$target_bin")" ); then
            log "Skipping aa-enforce on $base (matched kept families)"
            continue
          fi

          aa-enforce "$prof" >/dev/null 2>&1 || true
        done
        log "Enforced AppArmor profiles with aa-enforce (protected kept families)"
      else
        log "AppArmor service enabled"
      fi
    fi

    # 2. Auditd and audit rules
    if command -v auditctl >/dev/null 2>&1 || [ -d /etc/audit ]; then
      systemctl enable --now auditd >/dev/null 2>&1 || true
      mkdir -p /etc/audit/rules.d
      cat << 'EOF' > /etc/audit/rules.d/cp-audit.rules
## Identity files
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

## Sudoers
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

## Logins and session tracking
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/log/tallylog -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session

## Time changes
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time_change
-w /etc/localtime -p wa -k time_change
EOF
      if command -v augenrules >/dev/null 2>&1; then
        augenrules --load >/dev/null 2>&1 || true
      elif command -v auditctl >/dev/null 2>&1; then
        auditctl -R /etc/audit/rules.d/cp-audit.rules >/dev/null 2>&1 || true
      fi
      log "Configured auditd rules for identity files, sudoers, logins, and time changes"
    fi

    # 3. fail2ban
    if command -v fail2ban-client >/dev/null 2>&1 || [ -d /etc/fail2ban ]; then
      systemctl enable --now fail2ban >/dev/null 2>&1 || true
      if [ -f /etc/fail2ban/jail.conf ] && [ ! -f /etc/fail2ban/jail.local ]; then
        cat << 'EOF' > /etc/fail2ban/jail.local
[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
EOF
        systemctl restart fail2ban >/dev/null 2>&1 || true
      fi
      log "Enabled and hardened fail2ban service"
    fi

    # 4. rsyslog
    if command -v rsyslogd >/dev/null 2>&1 || systemctl list-unit-files rsyslog.service &>/dev/null; then
      systemctl enable --now rsyslog >/dev/null 2>&1 || true
      log "Enabled and started rsyslog logging service"
    fi

    # 5. Disable Guest and Auto-login (LightDM)
    mkdir -p /etc/lightdm/lightdm.conf.d
    cat << 'EOF' > /etc/lightdm/lightdm.conf.d/50-cp-hardening.conf
[Seat:*]
allow-guest=false
autologin-user=
autologin-guest=false
EOF
    if [ -f /etc/lightdm/lightdm.conf ]; then
      set_kv "allow-guest" "false" "/etc/lightdm/lightdm.conf" "="
      set_kv "autologin-user" "" "/etc/lightdm/lightdm.conf" "="
      set_kv "autologin-guest" "false" "/etc/lightdm/lightdm.conf" "="
    fi
    log "Disabled Guest and auto-login in LightDM (allow-guest=false, autologin-user=)"

    # 6. Disable Auto-login (GDM)
    for gdm_conf in /etc/gdm3/custom.conf /etc/gdm/custom.conf; do
      if [ -f "$gdm_conf" ]; then
        set_ini "daemon" "AutomaticLoginEnable" "false" "$gdm_conf"
        set_ini "daemon" "TimedLoginEnable" "false" "$gdm_conf"
        log "Disabled automatic login in GDM ($gdm_conf)"
      fi
    done

    if command -v dconf >/dev/null 2>&1 && command -v gsettings >/dev/null 2>&1; then
      mkdir -p /etc/dconf/profile /etc/dconf/db/local.d/locks
      local dconf_section=""
      if gsettings list-schemas 2>/dev/null | grep -Fxq 'org.cinnamon.desktop.session'; then
        dconf_section="cinnamon"
        cat > /etc/dconf/db/local.d/00-cp-desktop-security <<'EOF'
[org/cinnamon/desktop/session]
idle-delay=uint32 300

[org/cinnamon/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0

[org/cinnamon/desktop/media-handling]
autorun-never=true
automount-open=false
EOF
        cat > /etc/dconf/db/local.d/locks/00-cp-desktop-security <<'EOF'
/org/cinnamon/desktop/session/idle-delay
/org/cinnamon/desktop/screensaver/lock-enabled
/org/cinnamon/desktop/screensaver/lock-delay
/org/cinnamon/desktop/media-handling/autorun-never
/org/cinnamon/desktop/media-handling/automount-open
EOF
      elif gsettings list-schemas 2>/dev/null | grep -Fxq 'org.gnome.desktop.session'; then
        dconf_section="gnome"
        cat > /etc/dconf/db/local.d/00-cp-desktop-security <<'EOF'
[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0

[org/gnome/desktop/media-handling]
autorun-never=true
automount-open=false
EOF
        cat > /etc/dconf/db/local.d/locks/00-cp-desktop-security <<'EOF'
/org/gnome/desktop/session/idle-delay
/org/gnome/desktop/screensaver/lock-enabled
/org/gnome/desktop/screensaver/lock-delay
/org/gnome/desktop/media-handling/autorun-never
/org/gnome/desktop/media-handling/automount-open
EOF
      fi

      if [ -n "$dconf_section" ]; then
        if [ ! -f /etc/dconf/profile/user ]; then
          printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
        else
          grep -qxF 'user-db:user' /etc/dconf/profile/user || printf '\nuser-db:user\n' >> /etc/dconf/profile/user
          grep -qxF 'system-db:local' /etc/dconf/profile/user || printf '\nsystem-db:local\n' >> /etc/dconf/profile/user
        fi
        chmod 644 /etc/dconf/db/local.d/00-cp-desktop-security /etc/dconf/db/local.d/locks/00-cp-desktop-security
        if dconf update; then
          log "Configured $dconf_section 5-minute screen lock and disabled removable-media autorun"
        else
          warn "dconf update failed; verify desktop lock and removable-media settings manually"
        fi
      fi
    fi

    # 7. Disable USB storage, Firewire and Thunderbolt kernel modules
    cat << 'EOF' > /etc/modprobe.d/cp-blacklist.conf
install usb-storage /bin/false
blacklist usb-storage
install firewire-core /bin/false
blacklist firewire-core
install firewire-ohci /bin/false
blacklist firewire-ohci
install firewire-sbp2 /bin/false
blacklist firewire-sbp2
install thunderbolt /bin/false
blacklist thunderbolt
EOF
    log "Disabled usb-storage, firewire, and thunderbolt kernel modules in /etc/modprobe.d/cp-blacklist.conf"

    # 8. Mask Ctrl-Alt-Del
    systemctl mask ctrl-alt-del.target >/dev/null 2>&1 || true
    log "Masked ctrl-alt-del.target reboot trigger"

    # 9. Core dumps off (limits.conf, fs.suid_dumpable, systemd coredump Storage=none)
    mkdir -p /etc/security/limits.d
    cat << 'EOF' > /etc/security/limits.d/10-disable-coredump.conf
* hard core 0
* soft core 0
EOF
    if [ -f /etc/security/limits.conf ]; then
      grep -q "hard core 0" /etc/security/limits.conf || echo "* hard core 0" >> /etc/security/limits.conf
      grep -q "soft core 0" /etc/security/limits.conf || echo "* soft core 0" >> /etc/security/limits.conf
    fi

    # sysctl fs.suid_dumpable = 0
    echo "fs.suid_dumpable = 0" > /etc/sysctl.d/50-coredump.conf
    sysctl -w fs.suid_dumpable=0 >/dev/null 2>&1 || true

    # systemd coredump Storage=none
    if [ -f /etc/systemd/coredump.conf ]; then
      set_ini "Coredump" "Storage" "none" "/etc/systemd/coredump.conf"
      set_ini "Coredump" "ProcessSizeMax" "0" "/etc/systemd/coredump.conf"
    fi
    mkdir -p /etc/systemd/coredump.conf.d
    cat << 'EOF' > /etc/systemd/coredump.conf.d/disable.conf
[Coredump]
Storage=none
ProcessSizeMax=0
EOF
    log "Disabled core dumps in limits.conf, fs.suid_dumpable=0, and systemd coredump Storage=none"
  fi
}

# ---------------------------------------------------------------------
# 15. PACKAGE UPGRADES & UPDATE POLICIES
# ---------------------------------------------------------------------
sec_upgrade() {
  echo -e "\n${Y}=== Module 15: Package Upgrades & Security Updates ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi
  if [ "$ALL_MODULES" = "yes" ] || ask_timed "Perform package updates, dist-upgrade, guarded autoremove, and unattended-upgrades?" "Y"; then
    local has_net="no"
    log "Refreshing APT metadata to check repository access..."
    if refresh_apt_metadata; then
      has_net="yes"
      log "Installing all available package upgrades, including security updates..."
        if DEBIAN_FRONTEND=noninteractive apt-get upgrade -y >> "$LOG" 2>&1; then
          log "Completed apt-get upgrade"
        else
          warn "apt-get upgrade failed; see $LOG"
        fi

        log "Running apt-get dist-upgrade..."
        if DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y >> "$LOG" 2>&1; then
          log "Completed apt-get dist-upgrade"
        else
          warn "apt-get dist-upgrade failed; see $LOG"
        fi

        upgrade_installed_package() {
          local package="$1"
          local package_status
          package_status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null || true)
          [[ "$package_status" == ii* ]] || return 0
          if DEBIAN_FRONTEND=noninteractive apt-get install --only-upgrade -y "$package" >> "$LOG" 2>&1; then
            log "Updated or verified installed package: $package"
          else
            warn "Failed to update installed package $package; see $LOG"
          fi
        }
        upgrade_installed_package chromium
        upgrade_installed_package chromium-browser
        upgrade_installed_package openssh-server
        upgrade_installed_package openssh-client
        if ! command -v snap >/dev/null 2>&1 || ! snap list firefox >/dev/null 2>&1; then
          upgrade_installed_package firefox
        fi
        if command -v snap >/dev/null 2>&1 && snap list firefox >/dev/null 2>&1; then
          if timeout 600 snap refresh firefox >> "$LOG" 2>&1; then
            log "Updated Firefox snap"
          else
            warn "Failed to update Firefox snap; see $LOG"
          fi
        fi
        if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -Fxq "org.mozilla.firefox"; then
          if flatpak update --noninteractive org.mozilla.firefox >> "$LOG" 2>&1; then
            log "Updated Firefox Flatpak"
          else
            warn "Failed to update Firefox Flatpak; see $LOG"
          fi
        fi
        if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -Fxq "org.chromium.Chromium"; then
          if flatpak update --noninteractive org.chromium.Chromium >> "$LOG" 2>&1; then
            log "Updated Chromium Flatpak"
          else
            warn "Failed to update Chromium Flatpak; see $LOG"
          fi
        fi

        local chromium_installed="no" openssh_installed="no" package_status
        for package in chromium chromium-browser; do
          package_status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null || true)
          [[ "$package_status" == ii* ]] && chromium_installed="yes"
        done
        if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -Fxq "org.chromium.Chromium"; then
          chromium_installed="yes"
        fi
        if [ "$chromium_installed" = "no" ]; then
          warn "Chromium is not installed as an APT package; no APT update was applied"
        fi
        for package in openssh-server openssh-client; do
          package_status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null || true)
          [[ "$package_status" == ii* ]] && openssh_installed="yes"
        done
        [ "$openssh_installed" = "yes" ] || warn "OpenSSH packages are not installed; no OpenSSH package update was applied"

        for protected_package in chromium chromium-browser firefox openssh-server openssh-client; do
          package_status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$protected_package" 2>/dev/null || true)
          [[ "$package_status" == ii* ]] && apt-mark manual "$protected_package" >/dev/null 2>&1
        done

        # Dependency guard check before autoremove
        local auto_sim
        auto_sim=$(apt-get -s autoremove 2>/dev/null || true)
        local auto_remv
        auto_remv=$(echo "$auto_sim" | grep -E "^Remv " | awk '{print $2}')
        for apkg in $auto_remv; do
          if is_kept_family "$apkg" || [[ "$apkg" =~ ^(ssh|openssh|ufw|sudo|apparmor|auditd|libpam-|network-manager|debian-|task-|open-vm-tools|virtualbox-guest|qemu-guest|hyperv-|linux-image|systemd|lightdm|gdm3) ]]; then
            warn "Dependency guard: marking protected package '$apkg' as manual to prevent autoremove"
            apt-mark manual "$apkg" >/dev/null 2>&1 || true
          fi
        done

        log "Running guarded apt-get autoremove..."
        if DEBIAN_FRONTEND=noninteractive apt-get autoremove -y >> "$LOG" 2>&1; then
          log "Completed apt-get autoremove"
        else
          warn "apt-get autoremove failed; see $LOG"
        fi
      else
      warn "APT metadata could not be refreshed; package/security upgrades were skipped to avoid using stale repository indexes"
    fi

    # Unattended-upgrades configuration
    if [ "$SELF_TEST" != "yes" ] && [ "$has_net" = "yes" ]; then
      $APT install unattended-upgrades >> "$LOG" 2>&1 || warn "Could not install unattended-upgrades; see $LOG"
    fi
    mkdir -p /etc/apt/apt.conf.d
    cat << 'EOF' > /etc/apt/apt.conf.d/20auto-upgrades
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF
    dpkg-reconfigure -f noninteractive unattended-upgrades >/dev/null 2>&1 || true
    log "Configured /etc/apt/apt.conf.d/20auto-upgrades for automated security updates"
  fi
}

# ---------------------------------------------------------------------
# 18. POST-RUN SYSTEM HEALTH CHECK
# ---------------------------------------------------------------------
sec_extended_audit() {
  echo -e "\n${Y}=== Module 16: Extended Persistence & Integrity Audit (Report Only) ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi
  if ! ask_timed "Review shell/desktop startup, remote access, APT hooks, and package integrity?" "Y"; then
    return 0
  fi

  local f cmd
  for f in /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh /root/.bashrc /root/.profile /home/*/.bashrc /home/*/.profile /home/*/.bash_profile; do
    [ -f "$f" ] || continue
    if check_suspicious_file "$f"; then
      warn "Review suspicious shell startup file: $f"
      grep -nEi 'nc|ncat|netcat|socat|/dev/(tcp|udp)|curl|wget|base64|python|perl|ruby|php|/tmp|/dev/shm|/var/tmp' "$f" 2>/dev/null | head -n 20 | sed 's/^/    /'
    fi
  done

  for f in /etc/xdg/autostart/*.desktop /root/.config/autostart/*.desktop /home/*/.config/autostart/*.desktop; do
    [ -f "$f" ] || continue
    if grep -qiE 'Exec=.*(/tmp/|/dev/shm/|/var/tmp/|nc|ncat|netcat|socat|curl|wget)' "$f" 2>/dev/null; then
      warn "Review suspicious desktop autostart entry: $f"
      grep -E '^(Name|Exec|Hidden|X-GNOME-Autostart-enabled)=' "$f" 2>/dev/null | sed 's/^/    /'
    fi
  done

  for f in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys; do
    [ -f "$f" ] || continue
    log "Review SSH authorized keys file: $f"
    ssh-keygen -lf "$f" 2>/dev/null | sed 's/^/    /' || true
  done

  if [ -f /etc/inetd.conf ]; then
    grep -Ev '^[[:space:]]*(#|$)' /etc/inetd.conf | while IFS= read -r f; do
      warn "Active inetd entry requires review: $f"
    done
  fi
  if [ -d /etc/xinetd.d ]; then
    grep -RniE 'disable[[:space:]]*=[[:space:]]*no|socket_type|server[[:space:]]*=' /etc/xinetd.d 2>/dev/null | head -n 100 | while IFS= read -r f; do
      warn "Review xinetd configuration: $f"
    done
  fi

  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-timers --all --no-pager 2>/dev/null | sed -n '1,80p'
  fi
  if command -v atq >/dev/null 2>&1; then
    atq 2>/dev/null | sed 's/^/Scheduled at job: /'
  fi
  for cmd in xrdp x11vnc tightvncserver tigervnc-standalone-server vino anydesk teamviewer teamviewer-host; do
    if dpkg-query -W -f='${db:Status-Abbrev}' "$cmd" 2>/dev/null | grep -q '^ii'; then
      log "Installed remote-access package for scenario review: $cmd"
    fi
  done

  if [ -d /etc/apt/apt.conf.d ]; then
    grep -RniE 'DPkg::Pre-Invoke|DPkg::Post-Invoke|APT::Update::Pre-Invoke|APT::Update::Post-Invoke' /etc/apt/apt.conf.d 2>/dev/null | head -n 100 | while IFS= read -r f; do
      warn "Review APT hook: $f"
    done
  fi
  if grep -RnE '^[[:space:]]*auth[[:space:]]+(sufficient|optional)[[:space:]]+pam_permit\.so' /etc/pam.d 2>/dev/null; then
    warn "Potential PAM authentication bypass found; review the reported pam_permit entries"
  fi
  if [ -s /etc/ld.so.preload ]; then
    warn "/etc/ld.so.preload is non-empty; investigate each listed library"
    sed -n '1,50p' /etc/ld.so.preload
  fi
  for cmd in sudo su passwd ssh sshd apt apt-get systemctl; do
    for f in "/usr/local/bin/$cmd" "/usr/local/sbin/$cmd"; do
      [ -e "$f" ] && warn "Local executable may shadow system command: $f"
    done
  done
  if command -v dpkg >/dev/null 2>&1; then
    dpkg --verify 2>/dev/null | grep -v ' c ' | head -n 100 | while IFS= read -r f; do
      warn "Package integrity difference to review: $f"
    done
  fi
  for cmd in snap flatpak; do
    if command -v "$cmd" >/dev/null 2>&1; then
      "$cmd" list 2>/dev/null | grep -Ei 'transmission|qbittorrent|deluge|frostwire|anydesk|teamviewer|vnc|nmap|wireshark|hydra|ophcrack|aircrack|metasploit' | while IFS= read -r f; do
        warn "Review potentially prohibited $cmd application: $f"
      done
    fi
  done
  log "Extended persistence and integrity checks completed; findings are report-only"
}

sec_browser_policies() {
  echo -e "\n${Y}=== Module 17: Browser Security Policies & Extension Inventory ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi
  if ! ask_timed "Apply managed browser security policies to installed browsers?" "Y"; then
    return 0
  fi

  local policy_dir policy_file policy_dirs f
  policy_dirs=""
  if command -v chromium >/dev/null 2>&1 || dpkg-query -W -f='${db:Status-Abbrev}' chromium 2>/dev/null | grep -q '^ii'; then
    policy_dirs="$policy_dirs /etc/chromium/policies/managed"
  fi
  if command -v chromium-browser >/dev/null 2>&1 || dpkg-query -W -f='${db:Status-Abbrev}' chromium-browser 2>/dev/null | grep -q '^ii'; then
    policy_dirs="$policy_dirs /etc/chromium-browser/policies/managed"
  fi
  if command -v google-chrome >/dev/null 2>&1 || dpkg-query -W -f='${db:Status-Abbrev}' google-chrome-stable 2>/dev/null | grep -q '^ii'; then
    policy_dirs="$policy_dirs /etc/opt/chrome/policies/managed"
  fi
  for policy_dir in $policy_dirs; do
      mkdir -p "$policy_dir"
      policy_file="$policy_dir/99-cyberpatriot-security.json"
      if [ -e "$policy_file" ]; then
        warn "Preserved existing browser policy; merge required settings manually: $policy_file"
        continue
      fi
      cat > "$policy_file" <<'EOF'
{
  "DefaultPopupsSetting": 2,
  "DefaultNotificationsSetting": 2,
  "SafeBrowsingEnabled": true,
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "SyncDisabled": true
}
EOF
      chmod 644 "$policy_file"
      if command -v python3 >/dev/null 2>&1 && ! python3 -m json.tool "$policy_file" >/dev/null 2>&1; then
        warn "Chromium policy JSON validation failed: $policy_file"
      else
        log "Installed additive Chromium/Chrome policy drop-in: $policy_file"
