      }
      while (s ~ /^(sudo|env|nohup)[ \t]+/) {
        sub(/^(sudo|env|nohup)[ \t]+/, "", s)
      }
      if (s ~ /^[\042\047]/) {
        sub(/^[\042\047]/, "", s)
        sub(/[\042\047].*$/, "", s)
        first_tok = s
      } else {
        split(s, tokens, /[ \t]+/)
        first_tok = tokens[1]
      }
      if (first_tok ~ /^(\/tmp|\/dev\/shm|\/var\/tmp)\//) return 1
    }
    return 0
  }
  {
    if (!is_suspicious_line($0)) {
      print $0
    }
  }
  ' "$target" > "$tmp" && cat "$tmp" > "$target" && rm -f "$tmp"
}

