  if command -v firefox >/dev/null 2>&1 || dpkg-query -W -f='${db:Status-Abbrev}' firefox 2>/dev/null | grep -q '^ii' ||
     { command -v snap >/dev/null 2>&1 && snap list firefox >/dev/null 2>&1; } ||
     { command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -Fxq 'org.mozilla.firefox'; }; then
    policy_dir="/etc/firefox/policies"
    policy_file="$policy_dir/policies.json"
    mkdir -p "$policy_dir"
    if [ -e "$policy_file" ]; then
      warn "Preserved existing Firefox policies; merge required settings manually: $policy_file"
    else
      cat > "$policy_file" <<'EOF'
{
  "policies": {
    "PopupBlocking": {"Default": true, "Locked": true},
    "PasswordManagerEnabled": false,
    "OfferToSaveLoginsDefault": false,
    "DisableSecurityBypass": {"SafeBrowsing": true, "InvalidCertificate": true},
    "Preferences": {
      "browser.safebrowsing.malware.enabled": {"Value": true, "Status": "locked"},
      "browser.safebrowsing.phishing.enabled": {"Value": true, "Status": "locked"},
      "dom.security.https_only_mode": {"Value": true, "Status": "locked"},
      "xpinstall.whitelist.required": {"Value": true, "Status": "locked"}
    }
  }
}
EOF
      chmod 644 "$policy_file"
      if command -v python3 >/dev/null 2>&1 && ! python3 -m json.tool "$policy_file" >/dev/null 2>&1; then
        warn "Firefox policy JSON validation failed: $policy_file"
      else
        log "Installed Firefox security policy: $policy_file"
      fi
    fi
  fi

  for f in /home/*/.config/chromium/*/Extensions /home/*/.config/google-chrome/*/Extensions /root/.config/chromium/*/Extensions; do
    [ -d "$f" ] || continue
    find "$f" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | while IFS= read -r policy_file; do
      log "Review browser extension (not removed automatically): $f/$policy_file"
    done
  done
  if pgrep -x chromium >/dev/null 2>&1 || pgrep -x chromium-browser >/dev/null 2>&1 || pgrep -x chrome >/dev/null 2>&1; then
    warn "Restart the running Chromium/Chrome browser to load managed policies"
  fi
}

sec_health() {
  echo -e "\n${Y}=== Module 18: Post-Run System Health Check ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi

  local p_cnt=0 f_cnt=0 s_cnt=0

  check_h() {
    local name="$1" status="$2" note="$3"
    if [ "$status" = "PASS" ]; then
      echo -e "  [ ${G}PASS${N} ] $name"
      log "HEALTH PASS: $name"
      ((p_cnt++))
    elif [ "$status" = "FAIL" ]; then
      echo -e "  [ ${R}FAIL${N} ] $name ($note)"
      warn "HEALTH FAIL: $name ($note)"
      ((f_cnt++))
    else
      echo -e "  [ ${Y}SKIP${N} ] $name ($note)"
      ((s_cnt++))
    fi
  }

  # 1. Required services active
  if [ "$SSH_REQUIRED" = "yes" ]; then
    if systemctl is-active ssh >/dev/null 2>&1 || systemctl is-active sshd >/dev/null 2>&1; then
      check_h "SSH Service Active" "PASS"
    else
      check_h "SSH Service Active" "FAIL" "service not running"
    fi
  else
    check_h "SSH Service Active" "SKIP" "SSH not required"
  fi

  if [ "$REQ_APACHE" = "yes" ]; then
    if systemctl is-active apache2 >/dev/null 2>&1; then check_h "Apache Service Active" "PASS"
    else check_h "Apache Service Active" "FAIL" "apache2 inactive"; fi
  fi

  if [ "$REQ_NGINX" = "yes" ]; then
    if systemctl is-active nginx >/dev/null 2>&1; then check_h "Nginx Service Active" "PASS"
    else check_h "Nginx Service Active" "FAIL" "nginx inactive"; fi
  fi

  if [ "$REQ_FTP" = "yes" ]; then
    if systemctl is-active vsftpd >/dev/null 2>&1; then check_h "VSFTPD Service Active" "PASS"
    else check_h "VSFTPD Service Active" "FAIL" "vsftpd inactive"; fi
  fi

  if [ "$REQ_SAMBA" = "yes" ]; then
    if systemctl is-active smbd >/dev/null 2>&1; then check_h "Samba Service Active" "PASS"
    else check_h "Samba Service Active" "FAIL" "smbd inactive"; fi
  fi

  if [ "$REQ_MYSQL" = "yes" ]; then
    if systemctl is-active mysql >/dev/null 2>&1 || systemctl is-active mariadb >/dev/null 2>&1; then check_h "MySQL/MariaDB Service Active" "PASS"
    else check_h "MySQL/MariaDB Service Active" "FAIL" "database inactive"; fi
  fi

  # 2. Required ports listening
  if [ "$SSH_REQUIRED" = "yes" ]; then
    if ss -tuln 2>/dev/null | grep -q ":22 "; then check_h "SSH Port 22 Listening" "PASS"
    else check_h "SSH Port 22 Listening" "FAIL" "port 22 not in LISTEN state"; fi
  fi

  for port_entry in $UFW_ALLOW; do
    local p_num="${port_entry%%/*}"
    if ss -tuln 2>/dev/null | grep -q ":${p_num} "; then
      check_h "Required Port $port_entry Listening" "PASS"
    else
      check_h "Required Port $port_entry Listening" "FAIL" "port not listening"
    fi
  done

  # 3. sshd -t configuration syntax
  if command -v sshd >/dev/null 2>&1; then
    if sshd -t >/dev/null 2>&1; then check_h "sshd Configuration Syntax (sshd -t)" "PASS"
    else check_h "sshd Configuration Syntax (sshd -t)" "FAIL" "syntax error in sshd_config"; fi
  else
    check_h "sshd Configuration Syntax (sshd -t)" "SKIP" "sshd binary not present"
  fi

  # 4. visudo -c sudoers validity
  if command -v visudo >/dev/null 2>&1; then
    if visudo -cf /etc/sudoers >/dev/null 2>&1; then check_h "Sudoers Syntax Validation (visudo -c)" "PASS"
    else check_h "Sudoers Syntax Validation (visudo -c)" "FAIL" "corrupted sudoers file"; fi
  else
    check_h "Sudoers Syntax Validation (visudo -c)" "SKIP" "visudo command missing"
  fi

  # 5. Authorized users exist
  for u in $AUTHORIZED_USERS; do
    if id -u "$u" >/dev/null 2>&1; then check_h "Authorized User Exists: $u" "PASS"
    else check_h "Authorized User Exists: $u" "FAIL" "user $u not found in passwd"; fi
  done

  # 6. sudo/su sanity per admin
  for a in $ADMIN_USERS; do
    if id -nG "$a" 2>/dev/null | grep -E -q '(^|[[:space:]])(sudo|admin)([[:space:]]|$)'; then
      check_h "Admin Sudo Membership: $a" "PASS"
    else
      check_h "Admin Sudo Membership: $a" "FAIL" "admin $a not in sudo/admin group"
    fi
  done

  # 7. UFW status
  if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then
    check_h "UFW Firewall Active" "PASS"
  else
    check_h "UFW Firewall Active" "FAIL" "UFW inactive or missing"
  fi

  echo -e "\n${G}Health Check Summary: $p_cnt PASS | $f_cnt FAIL | $s_cnt SKIP${N}"
}

# ---------------------------------------------------------------------
# 19. FINAL SYSTEM VERIFICATION PRINTOUT
# ---------------------------------------------------------------------
sec_verify() {
  echo -e "\n${Y}=== Module 19: Final System Verification Report ===${N}"
  if [ "$SELF_TEST" = "yes" ]; then
    log "skipped: no network/changes in self-test"
    return 0
  fi

  # 1. Failed units
  echo -e "\n${G}[*] Systemd Failed Units:${N}"
  local failed_units
  failed_units=$(systemctl --failed --no-legend 2>/dev/null || true)
  if [ -z "$failed_units" ]; then
    echo -e "  [ ${G}PASS${N} ] No failed systemd units"
  else
    echo -e "  [ ${R}FAIL${N} ] Detected failed systemd units:"
    echo "$failed_units"
  fi

  # 2. Listening ports
  echo -e "\n${G}[*] Active Listening Ports (TCP/UDP):${N}"
  if command -v ss >/dev/null 2>&1; then
    ss -tulnp 2>/dev/null | grep LISTEN || true
    echo -e "  [ ${G}PASS${N} ] Captured active listening sockets"
  else
    echo -e "  [ ${Y}SKIP${N} ] ss command not found"
  fi

  # 3. Sudo group members
  echo -e "\n${G}[*] Administrative Group Members:${N}"
  local sudo_members
  sudo_members=$(getent group sudo 2>/dev/null | cut -d: -f4)
  local admin_members
  admin_members=$(getent group admin 2>/dev/null | cut -d: -f4)
  echo "  sudo  : ${sudo_members:-none}"
  [ -n "$admin_members" ] && echo "  admin : $admin_members"
  echo -e "  [ ${G}PASS${N} ] Verified administrative group memberships"

  # 4. UID 0 accounts
  echo -e "\n${G}[*] UID 0 Superuser Accounts:${N}"
  local uid_zeros
  uid_zeros=$(awk -F: '($3 == 0) { print $1 }' /etc/passwd)
  echo "  Accounts with UID 0: $(echo "$uid_zeros" | tr '\n' ' ')"
  if [ "$uid_zeros" = "root" ]; then
    echo -e "  [ ${G}PASS${N} ] Only root possesses UID 0"
  else
    echo -e "  [ ${R}FAIL${N} ] Unauthorized UID 0 superuser accounts present: $uid_zeros"
  fi

  # 5. IPv4 network hardening
  echo -e "\n${G}[*] IPv4 Kernel Network Settings:${N}"
  if command -v sysctl >/dev/null 2>&1; then
    local syncookies forwarding
    syncookies=$(sysctl -n net.ipv4.tcp_syncookies 2>/dev/null)
    forwarding=$(sysctl -n net.ipv4.ip_forward 2>/dev/null)
    echo "  tcp_syncookies=$syncookies ip_forward=$forwarding"
    if [ "$syncookies" = "1" ] && [ "$forwarding" = "0" ]; then
      echo -e "  [ ${G}PASS${N} ] SYN cookies enabled and IPv4 forwarding disabled"
    else
      echo -e "  [ ${R}FAIL${N} ] IPv4 network settings do not match the hardening policy"
    fi
  else
    echo -e "  [ ${Y}SKIP${N} ] sysctl command not found"
  fi

  # 6. UFW status
  echo -e "\n${G}[*] Firewall (UFW) Status & Rules:${N}"
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw status verbose 2>/dev/null || true
    echo -e "  [ ${G}PASS${N} ] Captured UFW active ruleset"
  else
    command -v ufw >/dev/null 2>&1 && ufw status verbose 2>/dev/null || true
    echo -e "  [ ${R}FAIL${N} ] UFW inactive or not installed"
  fi

  # 7. Effective sshd -T values
  echo -e "\n${G}[*] Effective SSH Server Configurations (sshd -T):${N}"
  if command -v sshd >/dev/null 2>&1; then
    sshd -T 2>/dev/null | grep -E '^(permitrootlogin|protocol|passwordauthentication|x11forwarding|maxauthtries|clientaliveinterval|allowusers)' || true
    echo -e "  [ ${G}PASS${N} ] Inspected active SSH daemon configuration"
  else
    echo -e "  [ ${Y}SKIP${N} ] SSH server not installed"
  fi

  # 8. Upgradable packages
  echo -e "\n${G}[*] Remaining Upgradable Packages:${N}"
  if command -v apt >/dev/null 2>&1; then
    local up_pkgs
    up_pkgs=$(apt list --upgradable 2>/dev/null | grep -v 'Listing...' || true)
    local up_cnt
    up_cnt=$(echo "$up_pkgs" | grep -c . || true)
    if [ "$up_cnt" -eq 0 ]; then
      echo -e "  [ ${G}PASS${N} ] System is fully updated (0 packages upgradable)"
    else
      echo -e "  [ ${Y}NOTE${N} ] $up_cnt package(s) available for upgrade"
    fi
  else
    echo -e "  [ ${Y}SKIP${N} ] apt package manager unavailable"
  fi

  # 9. Pending reboot
  echo -e "\n${G}[*] Reboot Status:${N}"
  if [ -e /var/run/reboot-required ]; then
    echo -e "  [ ${Y}NOTE${N} ] A reboot is required to complete updates"
    [ -r /var/run/reboot-required.pkgs ] && cat /var/run/reboot-required.pkgs
  else
    echo -e "  [ ${G}PASS${N} ] No pending reboot is reported"
  fi
}

